@namespace LMS.Shared.Components
@inject NavigationManager Navigation

<div class="lms-app-shell">
    <header class="lms-product-header">
        <a class="lms-product-brand" href="">
            <img class="lms-product-logo" src="images/lms-logo-192.png" alt="" />
            <span class="lms-product-copy">
                <strong>Linux Made Sane - Edge Gateway</strong>
                <small>Home Assistant Add-on <span class="lms-product-version">v@ProductVersion</span></small>
            </span>
        </a>
        <div class="lms-product-actions">
            <ThemeToggle />
        </div>
    </header>

    <div class="tab-control page-tab-control edge-tabs">
        <nav class="tab-control-bar" aria-label="Linux Made Sane - Edge Gateway sections">
            <div class="tab-list" role="tablist">
                @foreach (var item in Items)
                {
                    <a class="tab-trigger @(IsActive(item.Href) ? "active" : string.Empty)"
                       href="@BuildHref(item.Href)"
                       role="tab"
                       aria-selected="@(IsActive(item.Href) ? "true" : "false")"
                       title="@item.Description">
                        <span class="tab-trigger-title">@item.Label</span>
                    </a>
                }
            </div>
        </nav>

        <main class="tab-panel page-tab-panel edge-tab-panel">
            @ChildContent
        </main>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<NavigationItem> Items { get; set; } = [];
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string ProductVersion { get; set; } = "0.1.52";

    private static string BuildHref(string href)
    {
        var target = href.Trim();
        return target is "" or "/"
            ? string.Empty
            : target.TrimStart('/');
    }

    private bool IsActive(string href)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        var target = href.Trim('/');

        if (target.Length == 0)
        {
            return path.Length == 0 || path.Equals("applications", StringComparison.OrdinalIgnoreCase);
        }

        return path.Equals(target, StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith($"{target}/", StringComparison.OrdinalIgnoreCase);
    }
}
