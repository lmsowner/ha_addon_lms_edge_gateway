@namespace LMS.Shared.Components

<span class="lms-field-info">
    <button type="button"
            class="lms-field-info-trigger"
            style="anchor-name: --@tooltipId"
            aria-label="@AriaLabel"
            aria-describedby="@tooltipId">
        ?
    </button>
    <span id="@tooltipId"
          class="lms-field-info-tip"
          style="position-anchor: --@tooltipId"
          role="tooltip">
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <strong>@Title</strong>
        }
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            <p>@Body</p>
        }
    </span>
</span>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Body { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private readonly string tooltipId = $"lms-field-info-{Guid.NewGuid():N}";

    private string AriaLabel =>
        string.IsNullOrWhiteSpace(Title) ? "More information" : $"About {Title}";
}
