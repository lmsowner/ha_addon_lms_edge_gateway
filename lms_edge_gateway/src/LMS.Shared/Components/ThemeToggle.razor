@namespace LMS.Shared.Components

<button class="theme-toggle"
        type="button"
        data-theme-toggle
        title="Switch to dark mode"
        aria-label="Switch to dark mode"
        aria-pressed="false">
    <span class="theme-toggle-track" aria-hidden="true">
        <span class="theme-toggle-thumb">
            <svg class="theme-toggle-icon theme-toggle-sun"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.85"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <circle cx="12" cy="12" r="3.6" />
                <path d="M12 2.8v2.1" />
                <path d="M12 19.1v2.1" />
                <path d="m4.3 4.3 1.5 1.5" />
                <path d="m18.2 18.2 1.5 1.5" />
                <path d="M2.8 12h2.1" />
                <path d="M19.1 12h2.1" />
                <path d="m4.3 19.7 1.5-1.5" />
                <path d="m18.2 5.8 1.5-1.5" />
            </svg>
            <svg class="theme-toggle-icon theme-toggle-moon"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.85"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="M20.2 14.8A7.9 7.9 0 0 1 9.2 3.8 8.6 8.6 0 1 0 20.2 14.8Z" />
            </svg>
        </span>
    </span>
</button>
