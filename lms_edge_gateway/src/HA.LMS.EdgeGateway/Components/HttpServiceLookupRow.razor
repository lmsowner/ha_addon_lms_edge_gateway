@namespace HA.LMS.EdgeGateway.Components

<button class="http-service-stamp @(IsBlocked ? "is-blocked" : null) @(HasPoorTitle ? "is-poor-title" : null)"
        type="button"
        role="listitem"
        title="@DetailsTitle"
        disabled="@IsBlocked"
        @onclick="HandleUseAsync">
    <span class="http-service-stamp-icon" aria-hidden="true">
        @if (!string.IsNullOrWhiteSpace(Service.FaviconDataUrl))
        {
            <img src="@Service.FaviconDataUrl" alt="" loading="lazy" />
        }
        else
        {
            <span class="http-service-stamp-icon-fallback">@FallbackGlyph</span>
        }
    </span>
    <span class="http-service-stamp-body">
        <strong class="http-service-stamp-title">@PrimaryLabel</strong>
        <span class="http-service-stamp-meta">@HostLabel</span>
        <span class="http-service-stamp-scheme">@Service.Scheme.ToUpperInvariant() · @Service.Port</span>
    </span>
</button>

@code {
    [Parameter, EditorRequired] public LocalHttpServiceEndpoint Service { get; set; } = default!;
    [Parameter] public EventCallback<LocalHttpServiceEndpoint> OnUse { get; set; }

    private bool IsBlocked => Service.Exposure == DiscoveryExposure.UnsafeToExpose;

    private bool HasPoorTitle => LocalHttpServiceDiscoveryRanking.TitleQualityRank(Service.Title) > 0;

    private string HostLabel =>
        FirstNonBlank(Service.Host, Service.IpAddress, Service.DisplayName) ?? Service.Host;

    private string PrimaryLabel
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Service.Title) &&
                !LocalHttpServiceDiscoveryRanking.LooksLikeErrorTitle(Service.Title))
            {
                return Service.Title.Trim();
            }

            return FirstNonBlank(Service.ServiceName, Service.DisplayName, HostLabel) ?? HostLabel;
        }
    }

    private string FallbackGlyph
    {
        get
        {
            var label = PrimaryLabel.Trim();
            return string.IsNullOrEmpty(label) ? "?" : char.ToUpperInvariant(label[0]).ToString();
        }
    }

    private string DetailsTitle
    {
        get
        {
            var evidence = Service.Evidence ?? [];
            var parts = new List<string>
            {
                Service.Url,
                $"Scheme: {Service.Scheme}",
                $"Port: {Service.Port}"
            };

            AddIfPresent(parts, "Service", Service.ServiceName);
            AddIfPresent(parts, "HTTP", Service.StatusCode > 0 ? Service.StatusCode.ToString() : null);
            AddIfPresent(parts, "Title", Service.Title);
            AddIfPresent(parts, "Server", Service.ServerHeader);
            AddIfPresent(parts, "Scope", Service.Scope);
            foreach (var item in evidence.Take(4))
            {
                AddIfPresent(parts, "Evidence", item);
            }

            return string.Join(" | ", parts);
        }
    }

    private static void AddIfPresent(List<string> parts, string label, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            parts.Add($"{label}: {value.Trim()}");
        }
    }

    private static string? FirstNonBlank(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim();

    private Task HandleUseAsync() =>
        IsBlocked ? Task.CompletedTask : OnUse.InvokeAsync(Service);
}
