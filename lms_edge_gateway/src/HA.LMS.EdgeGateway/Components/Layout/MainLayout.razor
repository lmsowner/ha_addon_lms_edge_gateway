@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
@inject IConfiguration Configuration
@inject ICloudflareApiTokenStore ApiTokenStore
@inject IEdgeGatewayStatusService StatusService
@inject IEdgeGatewaySecurityStore SecurityStore
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

@if (tokenState is null || isCheckingAdminAuth)
{
    <main class="setup-gate">
        <section class="setup-card edge-loading-card" aria-busy="true">
            <span class="edge-loading-progress">
                <span class="edge-loading-progress-fill"></span>
            </span>
            <p class="meta-text">Checking Cloudflare setup.</p>
        </section>
    </main>
}
else if (!tokenState.HasToken)
{
    <CloudflareFirstRunSetup />
}
else
{
    <LmsShell Items="@Items" ProductVersion="@ProductVersion">
        @Body
    </LmsShell>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>

@code {
    private CloudflareApiTokenState? tokenState;
    private EdgeGatewayRuntimeStatus? status;
    private bool isCheckingAdminAuth = true;
    private const string FallbackProductVersion = "0.1.70";

    protected override async Task OnInitializedAsync()
    {
        tokenState = await ApiTokenStore.GetStateAsync();
        if (tokenState is { HasToken: true } && await RequiresAdminLoginAsync())
        {
            var relative = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).TrimStart('/');
            if (relative.Equals("/", StringComparison.Ordinal))
            {
                relative = "/";
            }

            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(relative)}", forceLoad: true);
            return;
        }

        status = await StatusService.GetStatusAsync();
        isCheckingAdminAuth = false;
    }

    private async Task<bool> RequiresAdminLoginAsync()
    {
        var security = await SecurityStore.LoadAsync();
        if (!security.Users.Any(user => user.IsEnabled))
        {
            return false;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User.Identity?.IsAuthenticated != true;
    }

    private IReadOnlyList<NavigationItem> Items =>
    [
        new($"Published Apps ({status?.Configuration.Applications.Count ?? 0})", "/", string.Empty, "Apps and hosts exposed through Edge Gateway"),
        new("Setup", "/cloudflare", string.Empty, "Cloudflare token, zones, relay namespace, and runtime readiness"),
        new("Domain Services", "/domain-services", string.Empty, ".well-known files, JSON metadata, and verification services"),
        new("Documentation", "/documentation", string.Empty, "End-to-end setup, routing, authentication, and operating guide"),
        new("Security/Users", "/security", string.Empty, "LMS accounts, MFA, passkeys, and email messaging"),
        new("Diagnostics", "/diagnostics", string.Empty, "Route checks and access log"),
        new("About", "/about", string.Empty, "Linux Made Sane product details")
    ];

    private string ProductVersion
    {
        get
        {
            var configured = Configuration["EdgeGateway:AddonVersion"]?.Trim();
            return IsValidProductVersion(configured)
                ? configured!
                : FallbackProductVersion;
        }
    }

    private static bool IsValidProductVersion(string? value) =>
        !string.IsNullOrWhiteSpace(value) &&
        !value.Equals("@productversion", StringComparison.OrdinalIgnoreCase);
}
