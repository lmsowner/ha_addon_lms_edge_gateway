@inherits LayoutComponentBase
@inject ICloudflareApiTokenStore ApiTokenStore

@if (tokenState is null)
{
    <main class="setup-gate">
        <section class="setup-card">
            <p class="muted">Checking Cloudflare setup.</p>
        </section>
    </main>
}
else if (!tokenState.HasToken)
{
    <CloudflareFirstRunSetup />
}
else
{
    <LmsShell Items="@Items">
        @Body
    </LmsShell>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>

@code {
    private CloudflareApiTokenState? tokenState;

    protected override async Task OnInitializedAsync()
    {
        tokenState = await ApiTokenStore.GetStateAsync();
    }

    private static readonly IReadOnlyList<NavigationItem> Items =
    [
        new("Dashboard", "/", "D", "Runtime overview"),
        new("Applications", "/applications", "A", "Published LAN apps"),
        new("Cloudflare", "/cloudflare", "T", "Tunnel and DNS"),
        new("Security", "/security", "S", "MFA and passkeys"),
        new("Diagnostics", "/diagnostics", "L", "Logs and checks")
    ];
}
