        addAppTargetPathPrefix = string.Empty;
        addAppAllowKnownIps = string.Empty;
        addAppAllowedUsers = string.Empty;
        addAppAllowedGroups = string.Empty;
        addAppNotes = string.Empty;
        addTemporaryIpApprovalRecipients = string.Empty;
        addTemporaryIpApprovalAllowedCountryCodes = string.Empty;
        addTemporaryIpApprovalUseNotFoundResponse = false;
        addTemporaryIpApprovalAllowSharedIp = false;
        addLanTrustEnabled = false;
        addLanTrustCidrs = string.Empty;
        addLanTrustDnsSuffixes = string.Empty;
        addLanTrustRequireForwardConfirm = true;
        addLanTrustMaxLatencyMilliseconds = null;
        addSkipAuthenticationForKnownIps = false;
        addOverrideGlobalTrustedIps = false;
        addTemporaryIpApprovalIdleTimeoutMinutes = null;
        addTemporaryIpApprovalMaxLifetimeMinutes = null;
        addAppEnabled = true;
        addAppAllowLanOnly = false;
        addAppUsePublicHostHeader = true;
        addAppStripForwardedFor = true;
