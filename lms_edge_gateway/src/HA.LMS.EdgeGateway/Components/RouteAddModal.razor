@namespace HA.LMS.EdgeGateway.Components
@implements IDisposable
@using System.Net
@using System.Text
@inject IEdgeGatewayRelayProvisioningService RelayProvisioningService
@inject ILocalHttpServiceDiscoveryService HttpServiceDiscovery

@if (Relay is not null)
{
    <div class="edge-modal-backdrop" role="presentation">
        <section class="edge-modal-panel edge-route-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="edge-add-app-title"
                 @onclick:stopPropagation="true">
            <header class="edge-modal-header">
                <div>
                    <h2 id="edge-add-app-title">New route</h2>
                    <p class="meta-text">Add creates the public DNS record, tunnel ingress, and Caddy route immediately.</p>
                </div>
                <button class="edge-modal-close" type="button" aria-label="Close add app" @onclick="CloseAsync">x</button>
            </header>

            <div class="edge-modal-body">
                <div class="edge-route-form">
                    @if (!string.IsNullOrWhiteSpace(routeSaveMessage))
                    {
                        <p class="callout @(routeSaveIsError ? "warning" : "ready")">@routeSaveMessage</p>
                    }

                    @if (!string.IsNullOrWhiteSpace(routeTargetCheckMessage))
                    {
                        <p class="edge-target-check-message @(routeTargetCheckIsError ? "error" : "success")">@routeTargetCheckMessage</p>
                    }

                    <div class="edge-form-grid edge-route-main-grid">
                        <label class="ui-field">
                            <span class="ui-field-label">Display name</span>
                            <input @bind="addAppName" placeholder="Home Assistant" />
                        </label>
                        <label class="ui-field">
                            <span class="ui-field-label">Hostname / subdomain</span>
                            <input @bind="addAppHostLabel" placeholder="hassio" />
                            <span class="ui-field-helper">Use hassio or a full hostname inside the selected Edge Gateway namespace.</span>
                        </label>
                        <label class="ui-field">
                            <span class="ui-field-label">Auth mode</span>
                            <select @bind="addAppAccessPolicy">
                                <option value="MFA/Passkey">MFA/Passkey</option>
                                <option value="Pass Through">Pass through</option>
                                <option value="Blocked">Blocked</option>
                            </select>
                        </label>
                    </div>

                    <div class="edge-form-grid edge-form-grid-target">
                        <label class="ui-field">
                            <span class="ui-field-label">URL path prefix</span>
                            <input @bind="addAppTargetPathPrefix" placeholder="/plex" />
                            <span class="ui-field-helper">Optional. /plex makes only hostname/plex route to this backend. Caddy strips the prefix before proxying.</span>
                        </label>
                        <label class="ui-field">
                            <span class="ui-field-label">Scheme</span>
                            <select @bind="addAppTargetScheme">
                                <option value="http">http</option>
                                <option value="https">https</option>
                            </select>
                        </label>
                        <label class="ui-field">
                            <span class="ui-field-label">Target host</span>
                            <input @bind="addAppTargetHost" placeholder="homeassistant or 192.168.1.50" />
                        </label>
                        <label class="ui-field">
                            <span class="ui-field-label">Port</span>
                            <input type="number" min="1" max="65535" @bind="addAppTargetPort" />
                        </label>
                        <div class="edge-target-actions">
                            <LmsButton Label="@(isCheckingRouteTarget ? "Checking..." : "Check Target")"
                                       Icon="test"
                                       Primary="true"
                                       Disabled="@isCheckingRouteTarget"
                                       OnClick="CheckRouteTargetAsync" />
                            <LmsButton Label="Find HTTP/S"
                                       Icon="search"
                                       Disabled="@isAddingApp"
                                       OnClick="OpenHttpServicePickerAsync" />
                        </div>
                    </div>

                    <details class="edge-advanced-settings edge-publish-details">
                        <summary>
                            <span>Public route</span>
                            <small>DNS, tunnel and Caddy preview</small>
                        </summary>
                        <div class="edge-publish-details-body">
                            <div class="edge-publish-preview">
                                <div>
                                    <strong>@BuildAddAppPublishHeadline()</strong>
                                    <span>@BuildAddAppPublishDetail()</span>
                                </div>
                                <LmsStatusPill Text="@BuildAddAppAccessLabel()" Tone="@GetAddAppAccessTone()" />
                            </div>
                            <p class="callout ready edge-publish-required">Add creates the Cloudflare DNS record, tunnel ingress, and Caddy route immediately. Disable it later from Published Apps if needed.</p>
                        </div>
                    </details>

                    <div class="edge-form-flags">
                        <label class="edge-checkbox-field">
                            <input type="checkbox" @bind="addAppEnabled" />
                            <span>Enabled</span>
                        </label>
                    </div>

                    <details class="edge-advanced-settings">
                        <summary>
                            <span>Advanced settings</span>
                            <small>Proxy headers and upstream TLS</small>
                        </summary>
                        <div class="edge-advanced-settings-body">
                            <label class="edge-checkbox-field">
                                <input type="checkbox" @bind="addAppUsePublicHostHeader" />
                                <span>Send public Host header</span>
                            </label>
                            <label class="edge-checkbox-field">
                                <input type="checkbox" @bind="addAppStripForwardedFor" />
                                <span>Strip X-Forwarded-For</span>
                            </label>
                            <label class="edge-checkbox-field">
                                <input type="checkbox" @bind="addAppSkipUpstreamTlsVerification" />
                                <span>Skip upstream TLS verification</span>
                            </label>
                        </div>
                    </details>
                </div>
            </div>

            <footer class="edge-modal-footer">
                <LmsButton Label="@(isAddingApp ? "Adding..." : "Add service")"
                           Icon="save"
                           Primary="true"
                           Disabled="@isAddingApp"
                           OnClick="AddAppAsync" />
                <LmsButton Label="Cancel"
                           Icon="close"
                           Disabled="@isAddingApp"
                           OnClick="CloseAsync" />
            </footer>
        </section>
    </div>

    @if (isHttpServicePickerOpen)
    {
        <div class="edge-modal-backdrop" role="presentation">
            <section class="edge-modal-panel edge-http-service-modal"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="edge-http-service-title"
                     @onclick:stopPropagation="true">
                <header class="edge-modal-header">
                    <div>
                        <h2 id="edge-http-service-title">HTTP/S service lookup</h2>
                        <p class="meta-text">Scans Home Assistant plus the local IPv4 subnet on approved HTTP/S ports.</p>
                    </div>
                    <button class="edge-modal-close" type="button" aria-label="Close HTTP/S service lookup" @onclick="CloseHttpServicePicker">x</button>
                </header>

                <div class="edge-modal-body">
                    <div class="edge-http-service-picker">
                        <div class="table-header edge-http-service-picker-header">
                            <div>
                                <strong>Local subnet scan</strong>
                                <p class="meta-text">Cached results are shown first. Scan refreshes localhost and every address in the detected local IPv4 subnet.</p>
                            </div>
                            <div class="edge-http-service-actions">
                                <LmsButton Label="@(isDiscoveringHttpServices ? "Scanning..." : "Scan")"
                                           Icon="search"
                                           Primary="true"
                                           Disabled="@isDiscoveringHttpServices"
                                           OnClick="ScanHttpServicesAsync" />
                            </div>
                        </div>

                        @if (isDiscoveringHttpServices)
                        {
                            <div class="edge-http-service-scan-state" aria-live="polite">
                                <span class="edge-loading-progress">
                                    <span class="edge-loading-progress-fill"></span>
                                </span>
                                <p>@BuildHttpScanSummary()</p>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(httpServiceDiscoveryMessage) && httpServiceSuggestions.Count > 0)
                        {
                            <p class="meta-text edge-http-service-message">@httpServiceDiscoveryMessage</p>
                        }

                        <div class="http-service-lookup-list" role="list">
                            @if (httpServiceSuggestions.Count == 0)
                            {
                                <p class="meta-text">No HTTP/S services to show yet.</p>
                            }
                            else
                            {
                                @foreach (var service in httpServiceSuggestions)
                                {
                                    <HttpServiceLookupRow Service="service" OnUse="SelectHttpServiceAsync" />
                                }
                            }
                        </div>
                    </div>
                </div>

                <footer class="edge-modal-footer">
                    <LmsButton Label="Close"
                               Icon="close"
                               Disabled="false"
                               OnClick="CloseHttpServicePicker" />
                </footer>
            </section>
        </div>
    }
}

@code {
    [Parameter] public EdgeGatewayRelayZone? Relay { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnSaved { get; set; }

    private bool isAddingApp;
    private bool isCheckingRouteTarget;
    private bool isHttpServicePickerOpen;
    private bool isDiscoveringHttpServices;
    private bool isValidatingCachedHttpServices;
    private string activeRelayKey = string.Empty;
    private string addAppName = "Home Assistant";
    private string addAppHostLabel = "hassio";
    private string addAppTargetScheme = "http";
    private string addAppTargetHost = "homeassistant";
    private int addAppTargetPort = 8123;
    private string addAppAccessPolicy = "MFA/Passkey";
    private string addAppTargetPathPrefix = string.Empty;
    private string addAppAllowKnownIps = string.Empty;
    private string addAppAllowedUsers = string.Empty;
    private string addAppAllowedGroups = string.Empty;
    private string addAppNotes = string.Empty;
    private bool addAppEnabled = true;
    private bool addAppAllowLanOnly;
    private bool addAppUsePublicHostHeader = true;
    private bool addAppStripForwardedFor = true;
    private bool addAppSkipUpstreamTlsVerification;
    private string routeTargetCheckMessage = string.Empty;
    private bool routeTargetCheckIsError;
    private string routeSaveMessage = string.Empty;
    private bool routeSaveIsError;
    private IReadOnlyList<LocalHttpServiceEndpoint> httpServiceSuggestions = [];
    private string? httpServiceDiscoveryMessage;
    private string httpServiceDiscoveryStatus = string.Empty;
    private int httpServiceScanFoundCount;
    private int httpServiceScanProbedCount;
    private int httpServiceScanTotalCount;
    private CancellationTokenSource? httpServiceScanCancellation;
    private CancellationTokenSource? httpServiceValidationCancellation;

    protected override void OnParametersSet()
    {
        var relayKey = Relay is null ? string.Empty : $"{Relay.DomainName}|{Relay.RelayHostname}";
        if (!relayKey.Equals(activeRelayKey, StringComparison.OrdinalIgnoreCase))
        {
            activeRelayKey = relayKey;
            ResetForm();
        }
    }

    private void ResetForm()
    {
        addAppName = "Home Assistant";
        addAppHostLabel = "hassio";
        addAppTargetScheme = "http";
        addAppTargetHost = "homeassistant";
        addAppTargetPort = 8123;
        addAppAccessPolicy = "MFA/Passkey";
        addAppTargetPathPrefix = string.Empty;
        addAppAllowKnownIps = string.Empty;
        addAppAllowedUsers = string.Empty;
        addAppAllowedGroups = string.Empty;
        addAppNotes = string.Empty;
        addAppEnabled = true;
        addAppAllowLanOnly = false;
        addAppUsePublicHostHeader = true;
        addAppStripForwardedFor = true;
        addAppSkipUpstreamTlsVerification = false;
        routeTargetCheckMessage = string.Empty;
        routeTargetCheckIsError = false;
        routeSaveMessage = string.Empty;
        routeSaveIsError = false;
        httpServiceSuggestions = [];
        httpServiceDiscoveryMessage = null;
        httpServiceDiscoveryStatus = string.Empty;
        httpServiceScanFoundCount = 0;
        httpServiceScanProbedCount = 0;
        httpServiceScanTotalCount = 0;
        CancelHttpServiceLookup();
        isHttpServicePickerOpen = false;
    }

    private async Task AddAppAsync()
    {
        if (Relay is null || isAddingApp)
        {
            return;
        }

        isAddingApp = true;
        routeSaveMessage = string.Empty;
        routeSaveIsError = false;

        try
        {
            var result = await RelayProvisioningService.AddApplicationAsync(
                Relay.DomainName,
                addAppName,
                addAppHostLabel,
                addAppTargetScheme,
                addAppTargetHost,
                addAppTargetPort,
                addAppAccessPolicy,
                targetPathPrefix: addAppTargetPathPrefix,
                isEnabled: addAppEnabled,
                allowKnownIps: addAppAllowKnownIps,
                allowedUsers: addAppAllowedUsers,
                allowedGroups: addAppAllowedGroups,
                allowLanOnly: addAppAllowLanOnly,
                notes: addAppNotes,
                usePublicHostHeader: addAppUsePublicHostHeader,
                stripForwardedFor: addAppStripForwardedFor,
                skipUpstreamTlsVerification: addAppSkipUpstreamTlsVerification);

            if (!result.Success)
            {
                routeSaveIsError = true;
                routeSaveMessage = result.Summary;
                return;
            }

            await OnSaved.InvokeAsync(result.Summary);
            await CloseAsync();
        }
        catch (Exception exception)
        {
            routeSaveIsError = true;
            routeSaveMessage = $"Could not add the app: {exception.Message}";
        }
        finally
        {
            isAddingApp = false;
        }
    }

    private async Task CloseAsync()
    {
        if (isAddingApp)
        {
            return;
        }

        CancelHttpServiceLookup();
        isHttpServicePickerOpen = false;
        await OnClose.InvokeAsync();
    }

    private async Task CheckRouteTargetAsync()
    {
        if (isCheckingRouteTarget)
        {
            return;
        }

        isCheckingRouteTarget = true;
        routeTargetCheckMessage = "Checking target with http and https...";
        routeTargetCheckIsError = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            var host = NormalizeTargetHost(addAppTargetHost);
            var port = Math.Clamp(addAppTargetPort, 1, 65535);
            var currentScheme = NormalizeScheme(addAppTargetScheme);
            var probes = await ProbeRouteTargetSchemesAsync(host, port);
            var workingProbes = probes.Where(static probe => probe.Success).ToArray();

            if (workingProbes.Length == 0)
            {
                routeTargetCheckIsError = true;
                routeTargetCheckMessage = $"No HTTP/S response from {host}:{port}. {BuildRouteTargetProbeFailureSummary(probes)}";
                return;
            }

            var selectedProbe = workingProbes.FirstOrDefault(probe => probe.Scheme.Equals(currentScheme, StringComparison.OrdinalIgnoreCase)) ??
                                workingProbes.First();
            addAppTargetScheme = selectedProbe.Scheme;
            addAppSkipUpstreamTlsVerification = selectedProbe.Scheme.Equals(Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase);
            routeTargetCheckMessage = selectedProbe.Scheme.Equals(currentScheme, StringComparison.OrdinalIgnoreCase)
                ? $"Target OK using {selectedProbe.Scheme}. {selectedProbe.Summary}"
                : $"Switched scheme to {selectedProbe.Scheme}. {selectedProbe.Summary}";
        }
        catch (Exception exception)
        {
            routeTargetCheckIsError = true;
            routeTargetCheckMessage = exception.Message;
        }
        finally
        {
            isCheckingRouteTarget = false;
        }
    }

    private async Task OpenHttpServicePickerAsync()
    {
        CancelHttpServiceLookup();
        isHttpServicePickerOpen = true;
        await LoadCachedHttpServicesAsync();
    }

    private void CloseHttpServicePicker()
    {
        CancelHttpServiceLookup();
        isHttpServicePickerOpen = false;
    }

    private async Task LoadCachedHttpServicesAsync()
    {
        httpServiceSuggestions = SortHttpServiceSuggestions(
            (await HttpServiceDiscovery.GetCachedAsync()).Where(IsLocalHttpServiceCandidate));
        httpServiceDiscoveryMessage = httpServiceSuggestions.Count == 0
            ? "No cached service candidates yet. Run Scan to search the local IPv4 subnet."
            : $"Showing {httpServiceSuggestions.Count} cached service candidate(s). Checking they still respond.";
        httpServiceDiscoveryStatus = httpServiceSuggestions.Count == 0 ? string.Empty : "Checking cached service candidates...";
        httpServiceScanFoundCount = 0;
        httpServiceScanProbedCount = 0;
        httpServiceScanTotalCount = 0;

        if (httpServiceSuggestions.Count > 0)
        {
            CancelHttpServiceValidation();
            httpServiceValidationCancellation = new CancellationTokenSource();
            _ = ValidateCachedHttpServicesAsync(httpServiceValidationCancellation.Token);
        }
    }

    private Task ScanHttpServicesAsync()
    {
        if (isDiscoveringHttpServices)
        {
            return Task.CompletedTask;
        }

        isDiscoveringHttpServices = true;
        CancelHttpServiceValidation();
        httpServiceDiscoveryMessage = "Scan running. Cached candidates stay visible while fresh results update.";
        httpServiceDiscoveryStatus = "Starting local subnet scan...";
        httpServiceScanFoundCount = 0;
        httpServiceScanProbedCount = 0;
        httpServiceScanTotalCount = 0;

        var request = new LocalHttpServiceDiscoveryRequest(
            IncludeLocalhost: true,
            IncludeLan: true,
            IncludeTailnet: false,
            IncludeDocker: false);
        httpServiceScanCancellation = new CancellationTokenSource();
        _ = RunHttpServicesScanAsync(request, httpServiceScanCancellation.Token);
        return Task.CompletedTask;
    }

    private async Task RunHttpServicesScanAsync(LocalHttpServiceDiscoveryRequest request, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Yield();
            var progress = new Progress<LocalHttpServiceDiscoveryProgressUpdate>(update =>
            {
                _ = InvokeAsync(() =>
                {
                    if (cancellationToken.IsCancellationRequested)
                    {
                        return;
                    }

                    ApplyHttpServiceProgress(update);
                    StateHasChanged();
                });
            });

            var results = await HttpServiceDiscovery.DiscoverAsync(request, progress, cancellationToken);
            await InvokeAsync(() =>
            {
                if (cancellationToken.IsCancellationRequested)
                {
                    return;
                }

                httpServiceSuggestions = SortHttpServiceSuggestions(results.Where(IsLocalHttpServiceCandidate));
                httpServiceDiscoveryMessage = httpServiceSuggestions.Count == 0
                    ? "No service candidates responded in the latest scan."
                    : $"{httpServiceSuggestions.Count} service candidate(s) found in the latest scan.";
                isDiscoveringHttpServices = false;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
            await InvokeAsync(() =>
            {
                if (!isHttpServicePickerOpen)
                {
                    return;
                }

                isDiscoveringHttpServices = false;
                httpServiceDiscoveryStatus = string.Empty;
                StateHasChanged();
            });
        }
        catch (Exception exception)
        {
            await InvokeAsync(() =>
            {
                if (cancellationToken.IsCancellationRequested)
                {
                    return;
                }

                httpServiceDiscoveryMessage = $"HTTP/S lookup failed: {exception.Message}";
                httpServiceDiscoveryStatus = "HTTP/S lookup failed.";
                isDiscoveringHttpServices = false;
                StateHasChanged();
            });
        }
    }

    private async Task ValidateCachedHttpServicesAsync(CancellationToken cancellationToken)
    {
        if (isValidatingCachedHttpServices || isDiscoveringHttpServices)
        {
            return;
        }

        isValidatingCachedHttpServices = true;
        try
        {
            var progress = new Progress<LocalHttpServiceDiscoveryProgressUpdate>(update =>
            {
                _ = InvokeAsync(() =>
                {
                    if (cancellationToken.IsCancellationRequested)
                    {
                        return;
                    }

                    if (!isDiscoveringHttpServices)
                    {
                        httpServiceDiscoveryStatus = update.Message;
                        httpServiceScanProbedCount = update.ProbedCount;
                        httpServiceScanTotalCount = update.TotalProbeCount;
                        httpServiceScanFoundCount = update.FoundCount;

                        if (update.FoundEndpoint is not null && IsLocalHttpServiceCandidate(update.FoundEndpoint))
                        {
                            MergeHttpServiceSuggestion(update.FoundEndpoint);
                        }
                    }

                    StateHasChanged();
                });
            });

            var results = await HttpServiceDiscovery.ValidateCachedAsync(progress, cancellationToken);
            await InvokeAsync(() =>
            {
                if (cancellationToken.IsCancellationRequested)
                {
                    return;
                }

                isValidatingCachedHttpServices = false;
                if (!isDiscoveringHttpServices)
                {
                    httpServiceSuggestions = SortHttpServiceSuggestions(results.Where(IsLocalHttpServiceCandidate));
                    httpServiceDiscoveryMessage = httpServiceSuggestions.Count == 0
                        ? "No cached service candidates are still responding. Run Scan to search the local IPv4 subnet."
                        : $"{httpServiceSuggestions.Count} cached service candidate(s) still responding.";
                    httpServiceDiscoveryStatus = string.Empty;
                    StateHasChanged();
                }
            });
        }
        catch (OperationCanceledException)
        {
            await InvokeAsync(() =>
            {
                isValidatingCachedHttpServices = false;
                if (!isDiscoveringHttpServices)
                {
                    httpServiceDiscoveryStatus = string.Empty;
                    StateHasChanged();
                }
            });
        }
        catch (Exception exception)
        {
            await InvokeAsync(() =>
            {
                if (cancellationToken.IsCancellationRequested)
                {
                    return;
                }

                isValidatingCachedHttpServices = false;
                if (!isDiscoveringHttpServices)
                {
                    httpServiceDiscoveryMessage = $"Cached service check failed: {exception.Message}";
                    httpServiceDiscoveryStatus = string.Empty;
                    StateHasChanged();
                }
            });
        }
    }

    private void CancelHttpServiceLookup()
    {
        CancelHttpServiceValidation();
        CancelHttpServiceScan();
        httpServiceDiscoveryStatus = string.Empty;
    }

    private void CancelHttpServiceScan()
    {
        httpServiceScanCancellation?.Cancel();
        httpServiceScanCancellation = null;
        isDiscoveringHttpServices = false;
    }

    private void CancelHttpServiceValidation()
    {
        httpServiceValidationCancellation?.Cancel();
        httpServiceValidationCancellation = null;
        isValidatingCachedHttpServices = false;
    }

    private void ApplyHttpServiceProgress(LocalHttpServiceDiscoveryProgressUpdate update)
    {
        httpServiceDiscoveryStatus = update.Message;
        httpServiceScanProbedCount = update.ProbedCount;
        httpServiceScanTotalCount = update.TotalProbeCount;
        httpServiceScanFoundCount = update.FoundCount;

        if (update.FoundEndpoint is not null)
        {
            MergeHttpServiceSuggestion(update.FoundEndpoint);
        }

        if (update.IsCompleted)
        {
            isDiscoveringHttpServices = false;
        }
    }

    private void MergeHttpServiceSuggestion(LocalHttpServiceEndpoint endpoint)
    {
        httpServiceSuggestions = SortHttpServiceSuggestions(
            httpServiceSuggestions
                .Where(service => !BuildHttpServiceKey(service).Equals(BuildHttpServiceKey(endpoint), StringComparison.OrdinalIgnoreCase))
                .Append(endpoint));
    }

    private async Task SelectHttpServiceAsync(LocalHttpServiceEndpoint service)
    {
        CancelHttpServiceLookup();
        addAppTargetScheme = service.Scheme.Equals(Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase)
            ? Uri.UriSchemeHttps
            : Uri.UriSchemeHttp;
        addAppTargetHost = service.Host;
        addAppTargetPort = service.Port;
        addAppName = BuildRouteNameFromDiscoveredService(service);
        addAppHostLabel = BuildRouteHostLabelFromDiscoveredService(service);
        addAppAccessPolicy = service.Exposure == DiscoveryExposure.UnsafeToExpose
            ? "Blocked"
            : "MFA/Passkey";
        addAppUsePublicHostHeader = IsHomeAssistantCandidate(addAppName, addAppHostLabel, service.Port);
        addAppStripForwardedFor = true;
        addAppSkipUpstreamTlsVerification = addAppTargetScheme.Equals(Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase);
        routeTargetCheckIsError = false;
        routeTargetCheckMessage = $"Selected {service.Url}.";
        isHttpServicePickerOpen = false;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        var scanCancellation = httpServiceScanCancellation;
        var validationCancellation = httpServiceValidationCancellation;
        CancelHttpServiceLookup();
        scanCancellation?.Dispose();
        validationCancellation?.Dispose();
    }

    private string BuildHttpScanSummary()
    {
        var status = string.IsNullOrWhiteSpace(httpServiceDiscoveryStatus)
            ? "Scanning HTTP/S services..."
            : httpServiceDiscoveryStatus;

        var progress = httpServiceScanTotalCount > 0
            ? $"{httpServiceScanProbedCount}/{httpServiceScanTotalCount} checked"
            : "Preparing";

        return $"{status} {progress}, {httpServiceScanFoundCount} service(s). You can close this dialog and come back.";
    }

    private static IReadOnlyList<LocalHttpServiceEndpoint> SortHttpServiceSuggestions(IEnumerable<LocalHttpServiceEndpoint> services) =>
        services
            .DistinctBy(BuildHttpServiceKey, StringComparer.OrdinalIgnoreCase)
            .OrderBy(service => service.Exposure switch
            {
                DiscoveryExposure.Publishable => 0,
                DiscoveryExposure.RequiresManualConfirmation => 1,
                DiscoveryExposure.InternalOnly => 2,
                DiscoveryExposure.UnsafeToExpose => 3,
                _ => 4
            })
            .ThenByDescending(service => service.Confidence)
            .ThenBy(service => service.Scope switch
            {
                "Home Assistant" => 0,
                "Localhost" => 0,
                "Docker" => 1,
                "LAN" => 2,
                "Tailnet" => 3,
                _ => 4
            })
            .ThenBy(service => service.Host, StringComparer.OrdinalIgnoreCase)
            .ThenBy(service => service.Port)
            .ThenBy(service => service.Scheme.Equals(Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
            .ToArray();

    private static bool IsLocalHttpServiceCandidate(LocalHttpServiceEndpoint service) =>
        !service.Scope.Equals("Docker", StringComparison.OrdinalIgnoreCase) &&
        !service.Scope.Equals("Tailnet", StringComparison.OrdinalIgnoreCase);

    private static string BuildHttpServiceKey(LocalHttpServiceEndpoint service) =>
        $"{service.Scheme}|{FirstNonBlank(service.IpAddress, service.Host)}|{service.Port}|{service.Fingerprint}";

    private static string BuildRouteNameFromDiscoveredService(LocalHttpServiceEndpoint service)
    {
        var name = FirstNonBlank(
            service.ServiceKind.Equals("unknown-http", StringComparison.OrdinalIgnoreCase) ? null : service.ServiceName,
            service.ServiceName,
            service.Title,
            "Published Service");
        return name ?? "Published Service";
    }

    private static string BuildRouteHostLabelFromDiscoveredService(LocalHttpServiceEndpoint service)
    {
        var source = FirstNonBlank(
            service.ServiceKind.Equals("unknown-http", StringComparison.OrdinalIgnoreCase) ? null : service.ServiceKind,
            service.ServiceName,
            service.Title,
            service.Host);
        return SlugifyHostLabel(source ?? "service");
    }

    private static string? FirstNonBlank(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim();

    private static string SlugifyHostLabel(string value)
    {
        var builder = new StringBuilder(value.Length);
        var lastWasDash = false;
        foreach (var character in value.Trim().ToLowerInvariant())
        {
            if (char.IsLetterOrDigit(character))
            {
                builder.Append(character);
                lastWasDash = false;
            }
            else if (!lastWasDash)
            {
                builder.Append('-');
                lastWasDash = true;
            }
        }

        var label = builder.ToString().Trim('-');
        return string.IsNullOrWhiteSpace(label) ? "service" : label;
    }

    private string BuildAddAppPreviewPublicHost()
    {
        var label = NormalizePreviewHostLabel(addAppHostLabel);
        if (Relay is null)
        {
            return label;
        }

        if (label.EndsWith($".{Relay.DomainName}", StringComparison.OrdinalIgnoreCase))
        {
            return label;
        }

        return $"{label}.{Relay.DomainName}";
    }

    private string BuildAddAppPreviewRelayHost()
    {
        var label = GetPreviewRelativeHostLabel();
        return Relay is null ? $"{label}.ha-app-relay.example.com" : $"{label}.{Relay.RelayHostname}";
    }

    private string BuildAddAppPublishHeadline() =>
        $"{BuildAddAppPreviewExternalUrl()} -> {BuildAddAppTargetUrl()}";

    private string BuildAddAppPublishDetail()
    {
        var auth = addAppAccessPolicy.Contains("through", StringComparison.OrdinalIgnoreCase)
            ? "Caddy will proxy this straight to the backend."
            : addAppAccessPolicy.Contains("block", StringComparison.OrdinalIgnoreCase)
                ? "Caddy will keep this route blocked until the auth mode is changed."
                : $"Policy: {BuildAddAppAccessLabel()}.";
        var path = NormalizeRoutePathPrefix(addAppTargetPathPrefix);
        var routing = string.IsNullOrWhiteSpace(path)
            ? "This is the default route for the hostname."
            : $"Only {path} and anything under it will route here; Caddy strips that prefix before proxying.";
        return $"{auth} {routing} DNS publishes as {BuildAddAppPreviewPublicHost()} -> {BuildAddAppPreviewRelayHost()}.";
    }

    private string BuildAddAppAccessLabel() =>
        string.IsNullOrWhiteSpace(addAppAccessPolicy) ? "MFA/Passkey" : addAppAccessPolicy.Trim();

    private LmsStatusTone GetAddAppAccessTone() =>
        BuildAddAppAccessLabel().Contains("block", StringComparison.OrdinalIgnoreCase)
            ? LmsStatusTone.Critical
            : BuildAddAppAccessLabel().Contains("pass", StringComparison.OrdinalIgnoreCase)
                ? LmsStatusTone.Warning
                : LmsStatusTone.Ready;

    private string BuildAddAppPreviewExternalUrl()
    {
        var path = NormalizeRoutePathPrefix(addAppTargetPathPrefix);
        return string.IsNullOrWhiteSpace(path)
            ? $"https://{BuildAddAppPreviewPublicHost()}"
            : $"https://{BuildAddAppPreviewPublicHost()}{path}";
    }

    private string BuildAddAppTargetUrl()
    {
        var scheme = NormalizeScheme(addAppTargetScheme);
        var host = string.IsNullOrWhiteSpace(addAppTargetHost)
            ? "homeassistant"
            : addAppTargetHost.Trim();
        var port = Math.Clamp(addAppTargetPort, 1, 65535);
        return $"{scheme}://{FormatHostForUrl(host)}:{port}";
    }

    private string GetPreviewRelativeHostLabel()
    {
        var label = NormalizePreviewHostLabel(addAppHostLabel);
        if (Relay is null)
        {
            return label;
        }

        var suffix = $".{Relay.DomainName}";
        if (label.EndsWith(suffix, StringComparison.OrdinalIgnoreCase))
        {
            return label[..^suffix.Length];
        }

        return label;
    }

    private static string NormalizePreviewHostLabel(string value)
    {
        var normalized = string.IsNullOrWhiteSpace(value)
            ? "hassio"
            : value.Trim().Trim('.').ToLowerInvariant();
        return string.IsNullOrWhiteSpace(normalized) ? "hassio" : normalized;
    }

    private static string NormalizeRoutePathPrefix(string? value)
    {
        var normalized = (value ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(normalized) || normalized == "/")
        {
            return string.Empty;
        }

        return normalized.StartsWith("/", StringComparison.Ordinal)
            ? normalized.TrimEnd('/')
            : $"/{normalized.TrimEnd('/')}";
    }

    private static string NormalizeScheme(string value) =>
        value.Trim().Equals("https", StringComparison.OrdinalIgnoreCase) ? "https" : "http";

    private static string NormalizeTargetHost(string value)
    {
        var host = (value ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(host))
        {
            throw new InvalidOperationException("Enter a target host before checking it.");
        }

        if (Uri.TryCreate(host, UriKind.Absolute, out var uri))
        {
            return uri.Host;
        }

        return host.Trim('[', ']');
    }

    private static string FormatHostForUrl(string host)
    {
        var normalized = host.Trim();
        return normalized.Contains(':', StringComparison.Ordinal) &&
               IPAddress.TryParse(normalized.Trim('[', ']'), out var address) &&
               address.AddressFamily == System.Net.Sockets.AddressFamily.InterNetworkV6
            ? $"[{normalized.Trim('[', ']')}]"
            : normalized;
    }

    private static async Task<IReadOnlyList<RouteTargetProbeResult>> ProbeRouteTargetSchemesAsync(string host, int port)
    {
        using var handler = new HttpClientHandler
        {
            AllowAutoRedirect = false,
            UseProxy = false,
            ServerCertificateCustomValidationCallback = HttpClientHandler.DangerousAcceptAnyServerCertificateValidator
        };
        using var client = new HttpClient(handler)
        {
            Timeout = TimeSpan.FromSeconds(5)
        };

        return await Task.WhenAll(
            ProbeRouteTargetAsync(client, host, port, "https"),
            ProbeRouteTargetAsync(client, host, port, "http"));
    }

    private static async Task<RouteTargetProbeResult> ProbeRouteTargetAsync(
        HttpClient client,
        string host,
        int port,
        string scheme)
    {
        var targetUrl = $"{scheme}://{FormatHostForUrl(host)}:{port}";
        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(5));

        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Get, $"{targetUrl}/");
            request.Headers.UserAgent.ParseAdd("LinuxMadeSane-edge-target-check");

            using var response = await client.SendAsync(
                request,
                HttpCompletionOption.ResponseHeadersRead,
                timeout.Token);
            var snippet = await TryReadProbeSnippetAsync(response, timeout.Token);
            if (scheme.Equals("http", StringComparison.OrdinalIgnoreCase) && IsLikelyHttpsRequiredResponse(snippet))
            {
                return new RouteTargetProbeResult(
                    scheme,
                    false,
                    "http reached the port, but the response says this endpoint expects https.");
            }

            var reason = string.IsNullOrWhiteSpace(response.ReasonPhrase)
                ? string.Empty
                : $" {response.ReasonPhrase.Trim()}";
            return new RouteTargetProbeResult(
                scheme,
                true,
                $"{scheme} responded with HTTP {(int)response.StatusCode}{reason}.");
        }
        catch (TaskCanceledException)
        {
            return new RouteTargetProbeResult(scheme, false, $"{scheme} timed out.");
        }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException or InvalidOperationException)
        {
            return new RouteTargetProbeResult(scheme, false, $"{scheme} failed: {exception.Message}");
        }
    }

    private static async Task<string> TryReadProbeSnippetAsync(HttpResponseMessage response, CancellationToken cancellationToken)
    {
        if ((int)response.StatusCode is not 400 and not 421 and not 426)
        {
            return string.Empty;
        }

        try
        {
            await using var stream = await response.Content.ReadAsStreamAsync(cancellationToken);
            var buffer = new byte[4096];
            var read = await stream.ReadAsync(buffer.AsMemory(0, buffer.Length), cancellationToken);
            return read <= 0 ? string.Empty : Encoding.UTF8.GetString(buffer, 0, read);
        }
        catch
        {
            return string.Empty;
        }
    }

    private static bool IsLikelyHttpsRequiredResponse(string snippet)
    {
        if (string.IsNullOrWhiteSpace(snippet))
        {
            return false;
        }

        var text = snippet.ToLowerInvariant();
        return text.Contains("plain http request was sent to https port", StringComparison.Ordinal) ||
               text.Contains("client sent an http request to an https server", StringComparison.Ordinal) ||
               text.Contains("requires tls", StringComparison.Ordinal) ||
               text.Contains("requires https", StringComparison.Ordinal);
    }

    private static bool IsHomeAssistantCandidate(string name, string hostLabel, int port) =>
        name.Contains("home assistant", StringComparison.OrdinalIgnoreCase) ||
        hostLabel.Equals("hassio", StringComparison.OrdinalIgnoreCase) ||
        hostLabel.Equals("homeassistant", StringComparison.OrdinalIgnoreCase) ||
        hostLabel.Equals("home-assistant", StringComparison.OrdinalIgnoreCase) ||
        port == 8123;

    private static string BuildRouteTargetProbeFailureSummary(IEnumerable<RouteTargetProbeResult> probes) =>
        string.Join(" ", probes.Select(static probe => probe.Summary));

    private sealed record RouteTargetProbeResult(string Scheme, bool Success, string Summary);
}
