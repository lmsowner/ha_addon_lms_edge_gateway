            var wanIps = await LookupCurrentWanIpsAsync();
            foreach (var wanIp in wanIps)
            {
                editAppAllowKnownIps = MergeKnownSourceIp(editAppAllowKnownIps, wanIp);
            }

            editWanIpMessage = $"Added {string.Join(", ", wanIps)}.";
        }
        catch (Exception ex)
