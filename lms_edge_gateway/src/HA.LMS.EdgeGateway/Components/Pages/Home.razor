        BeginRouteAction(routeId, actionName);

        try
        {
            var result = await action();
            routeActionMessage = result.Summary;
            routeActionIsError = !result.Success;
            routeActionSteps = result.Steps;
            routeActionWarnings = result.Warnings;

            if (result.Success)
            {
                status = await StatusService.GetStatusAsync();
            }
        }
        catch (Exception exception)
        {
            routeActionMessage = $"Route action failed: {exception.Message}";
            routeActionIsError = true;
        }
        finally
        {
            EndRouteAction();
        }
    }

