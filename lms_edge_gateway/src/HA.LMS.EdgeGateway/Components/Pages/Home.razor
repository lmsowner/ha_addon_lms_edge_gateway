@page "/"
@rendermode InteractiveServer
@using System.Net
@inject IEdgeGatewayStatusService StatusService
@inject IEdgeGatewayRelayProvisioningService RelayProvisioningService
@inject IEdgeGatewaySecurityService SecurityService
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Published Apps | Linux Made Sane - Edge Gateway</PageTitle>

<div class="page-shell edge-gateway-page">
    @if (status is null)
    {
        <section class="surface-card edge-loading-card" aria-busy="true">
            <span class="edge-loading-progress">
                <span class="edge-loading-progress-fill"></span>
            </span>
            <p class="meta-text">Loading Edge Gateway...</p>
        </section>
    }
    else
    {
        <section class="edge-route-page-section">
            <div class="table-header">
                <div>
                    <p class="eyebrow">Services</p>
                    <h2>Apps and hosts exposed through Edge Gateway</h2>
                    <p class="meta-text">Adding a service from Setup creates the Cloudflare DNS record, tunnel ingress, and Caddy route.</p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(routeActionMessage))
            {
                <p class="callout @(routeActionIsError ? "warning" : "ready")">@routeActionMessage</p>
            }

            @if (routeActionSteps.Count > 0)
            {
                <div class="edge-provision-log">
                    <strong>Last action steps</strong>
                    <ul class="plain-list">
                        @foreach (var step in routeActionSteps)
                        {
                            <li>@step</li>
                        }
                    </ul>
                </div>
            }

            @if (routeActionWarnings.Count > 0)
            {
                <div class="edge-provision-log warning">
                    <strong>Warnings</strong>
                    <ul class="plain-list">
                        @foreach (var warning in routeActionWarnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                </div>
            }

            @if (status.Configuration.Applications.Count == 0)
            {
                <p class="meta-text">No services yet. Use Setup to prepare a relay and add a service.</p>
            }
            else
            {
                <div class="edge-route-list">
                    @foreach (var domainGroup in RouteDomainGroups)
                    {
                        var domainPanelId = BuildRouteDomainPanelId(domainGroup.DomainName);
                        var isDomainExpanded = IsRouteDomainExpanded(domainGroup.DomainName);

                        <section class="edge-route-domain-group">
                            <div class="edge-route-domain-header @(isDomainExpanded ? string.Empty : "collapsed")" aria-expanded="@(isDomainExpanded ? "true" : "false")">
                                <button class="edge-route-domain-toggle"
                                        type="button"
                                        aria-controls="@domainPanelId"
                                        aria-expanded="@(isDomainExpanded ? "true" : "false")"
                                        @onclick="@(() => ToggleRouteDomain(domainGroup.DomainName))">
                                    <span class="edge-route-domain-chevron @(isDomainExpanded ? "expanded" : string.Empty)" aria-hidden="true"></span>
                                    <span class="edge-route-domain-copy">
                                        <strong>@domainGroup.DomainName</strong>
                                        <span>@BuildRouteDomainSummary(domainGroup.DomainName)</span>
                                    </span>
                                </button>
                                <span class="edge-route-domain-pills">
                                    <span class="edge-route-domain-pill">@domainGroup.Routes.Count app@(domainGroup.Routes.Count == 1 ? string.Empty : "s")</span>
                                    <span class="edge-route-domain-pill">@domainGroup.EnabledCount enabled</span>
                                    <LmsButton Label="Add App"
                                               Icon="plus"
                                               Primary="true"
                                               Disabled="@(!IsRelayConfigured(domainGroup.DomainName) || isRouteActionBusy)"
                                               OnClick="@(() => OpenAddAppModal(domainGroup.DomainName))" />
                                </span>
                            </div>

                            @if (isDomainExpanded)
                            {
                                <div class="edge-route-domain-apps" id="@domainPanelId">
                                    @foreach (var route in domainGroup.Routes)
                                    {
                                        <article class="surface-subcard edge-route-card">
                                            <div class="edge-route-card-header">
                                                <div class="edge-route-title">
                                                    <h3>@route.Name</h3>
                                                    <span class="edge-route-title-pills">
                                                        <LmsStatusPill Text="@(route.IsEnabled ? "Enabled" : "Disabled")" Tone="@(route.IsEnabled ? LmsStatusTone.Ready : LmsStatusTone.Neutral)" />
                                                        <LmsStatusPill Text="@BuildAccessLabel(route)" Tone="@GetAccessTone(route)" />
                                                        <LmsStatusPill Text="@GetRouteTestLabel(route.Id)" Tone="@GetRouteTestTone(route.Id)" />
                                                    </span>
                                                </div>
                                                <div class="edge-route-actions">
                                                    <LmsButton Label="@(IsRouteBusy(route.Id, RouteToggleAction) ? "Saving..." : route.IsEnabled ? "Disable" : "Enable")"
                                                               Icon="@(route.IsEnabled ? "disable" : "publish")"
                                                               Danger="@route.IsEnabled"
                                                               Primary="@(!route.IsEnabled)"
                                                               Disabled="@isRouteActionBusy"
                                                               OnClick="@(() => ToggleRouteAsync(route.Id, route.IsEnabled))" />
                                                    <LmsButton Label="@(IsRouteBusy(route.Id, RouteTestAction) ? "Testing..." : "Test")"
                                                               Icon="test"
                                                               Disabled="@isRouteActionBusy"
                                                               OnClick="@(() => TestRouteAsync(route.Id))" />
                                                    <LmsButton Label="Edit"
                                                               Icon="edit"
                                                               Disabled="@isRouteActionBusy"
                                                               OnClick="@(() => OpenEditRouteModal(route))" />
                                                    <LmsButton Label="@(IsRouteBusy(route.Id, RouteDeleteAction) ? "Deleting..." : "Delete")"
                                                               Icon="delete"
                                                               Danger="true"
                                                               Disabled="@isRouteActionBusy"
                                                               OnClick="@(() => DeleteRouteAsync(route.Id))" />
                                                </div>
                                            </div>
                                            <div class="edge-route-links">
                                                <span class="edge-route-link">
                                                    <span>External</span>
                                                    <a href="@BuildExternalRouteUrl(route)" target="_blank" rel="noopener noreferrer">@BuildExternalRouteUrl(route)</a>
                                                </span>
                                                <span class="edge-route-link">
                                                    <span>Internal</span>
                                                    <a href="@route.UpstreamUrl" target="_blank" rel="noopener noreferrer">@route.UpstreamUrl</a>
                                                </span>
                                            </div>
                                            @if (route.IsEnabled && IsPassThroughAccessPolicy(route.AccessPolicy))
                                            {
                                                <div class="callout warning edge-pass-through-warning" role="alert">
                                                    <strong>Pass-through is enabled</strong>
                                                    <span>@PassThroughWarningText</span>
                                                </div>
                                            }
                                            else if (route.IsEnabled && IsTemporaryIpApprovalAccessPolicy(route.AccessPolicy))
                                            {
                                                <div class="callout ready edge-pass-through-warning" role="status">
                                                    <strong>Email approve IP is enabled</strong>
                                                    <span>@TemporaryIpApprovalWarningText</span>
                                                    <span>@BuildTemporaryIpApprovalSummary(route)</span>
                                                </div>
                                            }
                                        </article>
                                    }
                                </div>
                            }
                        </section>
                    }
                </div>
            }
        </section>

        @if (editingRoute is not null)
        {
            <div class="edge-modal-backdrop" role="presentation">
                <section class="edge-modal-panel"
                         role="dialog"
                         aria-modal="true"
                         aria-labelledby="edge-edit-app-title"
                         @onclick:stopPropagation="true">
                    <header class="edge-modal-header">
                        <div>
                            <p class="eyebrow">Edit app</p>
                            <h2 id="edge-edit-app-title">@editingRoute.PublicHostname</h2>
                            <p class="meta-text">Change the local target, access policy, and trust options for this host.</p>
                        </div>
                        <button class="edge-modal-close" type="button" aria-label="Close edit app" @onclick="CloseEditRouteModal">x</button>
                    </header>

                    <div class="edge-modal-body">
                        <div class="edge-token-guide-grid">
                            <div class="ui-field">
                                <span class="ui-field-label">
                                    App name
                                    <LmsFieldInfo Title="App name">
                                        <p>Friendly name shown in the Published Apps list. It does not change the public hostname.</p>
                                    </LmsFieldInfo>
                                </span>
                                <input @bind="editAppName" placeholder="Home Assistant" />
                            </div>
                            <div class="edge-readonly-field">
                                <span class="ui-field-label">
                                    Public host
                                    <LmsFieldInfo Title="Public host">
                                        <p>The Cloudflare hostname already published for this app. Delete and add the app again if the public hostname needs to change.</p>
                                    </LmsFieldInfo>
                                </span>
                                <strong>@editingRoute.PublicHostname</strong>
                            </div>
                            <div class="ui-field">
                                <span class="ui-field-label">
                                    URL path prefix
                                    <LmsFieldInfo Title="URL path prefix">
                                        <p>Optional public path, for example /plex. Caddy matches this path on the hostname and strips it before proxying to the target.</p>
                                        <p>Leave blank to publish the whole hostname.</p>
                                    </LmsFieldInfo>
                                </span>
                                <input @bind="editAppTargetPathPrefix" placeholder="/plex" />
                            </div>
                            <div class="ui-field">
                                <span class="ui-field-label">
                                    Target scheme
                                    <LmsFieldInfo Title="Target scheme">
                                        <p>How Edge Gateway talks to the local app. Use http for most add-ons and LAN services. Use https only if the upstream itself serves TLS.</p>
                                    </LmsFieldInfo>
                                </span>
                                <select @bind="editAppTargetScheme">
                                    <option value="http">http</option>
                                    <option value="https">https</option>
                                </select>
                            </div>
                            <div class="ui-field">
                                <span class="ui-field-label">
                                    Target host or container
                                    <LmsFieldInfo Title="Target host or container">
                                        <p>Internal hostname, Docker/HA container name, or LAN IP that Caddy should proxy to. This is never the public Cloudflare name.</p>
                                    </LmsFieldInfo>
                                </span>
                                <input @bind="editAppTargetHost" placeholder="homeassistant or 192.168.1.50" />
                            </div>
                            <div class="ui-field">
                                <span class="ui-field-label">
                                    Target port
                                    <LmsFieldInfo Title="Target port">
                                        <p>Local TCP port of the upstream service, for example 8123 for Home Assistant.</p>
                                    </LmsFieldInfo>
                                </span>
                                <input type="number" min="1" max="65535" @bind="editAppTargetPort" />
                            </div>
                            @if (EditRouteLooksHomeAssistant())
                            {
                                <div class="callout @(EditHomeAssistantTargetLooksExternal() ? "warning" : "ready") edge-ha-target-warning">
                                    <div>
                                        <strong>@BuildHomeAssistantTargetRepairTitle()</strong>
                                        <span>@BuildHomeAssistantTargetRepairDetail()</span>
                                    </div>
                                    <div class="edge-ha-target-actions">
                                        <LmsButton Label="Internal HTTP"
                                                   Icon="check"
                                                   OnClick="@(() => UseInternalHomeAssistantTarget(Uri.UriSchemeHttp))" />
                                        <LmsButton Label="Internal HTTPS"
                                                   Icon="check"
                                                   Primary="true"
                                                   OnClick="@(() => UseInternalHomeAssistantTarget(Uri.UriSchemeHttps))" />
                                    </div>
                                </div>
                            }
                            <div class="ui-field">
                                <span class="ui-field-label">
                                    Access policy
                                    <LmsFieldInfo Title="Access policy">
                                        <ul>
                                            <li><strong>MFA/Passkey</strong> — browser sign-in with authenticator or passkey before Caddy proxies to the app.</li>
                                            <li><strong>Email approve IP</strong> — deny first. An approval email is sent; after Allow, only that source IP is granted until idle or maximum expiry.</li>
                                            <li><strong>Pass through</strong> — no LMS authentication. Internet traffic goes straight to the upstream. Use only when the app is public by design or has its own auth.</li>
                                        </ul>
                                    </LmsFieldInfo>
                                </span>
                                <select @bind="editAppAccessPolicy">
                                    <option value="MFA/Passkey">MFA/Passkey</option>
                                    <option value="@EdgeGatewayAccessPolicies.TemporaryIpApproval">Email approve IP</option>
                                    <option value="Pass Through">Pass through</option>
                                </select>
                            </div>
                            @if (IsTemporaryIpApprovalAccessPolicy(editAppAccessPolicy))
                            {
                                <div class="edge-auth-panels">
                                    <section class="edge-auth-panel">
                                        <header class="edge-auth-panel-header">
                                            <h4>
                                                Email approval
                                                <LmsFieldInfo Title="Email approval">
                                                    <p>@TemporaryIpApprovalWarningText</p>
                                                    <p>Who gets the email, optional country filter, and how long a grant lasts are set on the fields below.</p>
                                                </LmsFieldInfo>
                                            </h4>
                                        </header>
                                        <div class="edge-auth-panel-grid">
                                            <LmsMultiSelect Label="Approval recipients"
                                                            HelperText="Optional. Blank sends to this route's allowed users, then every enabled LMS user. Only enabled LMS accounts can be chosen."
                                                            Placeholder="Choose LMS users"
                                                            EmptyText="No enabled LMS users match."
                                                            Items="@approvalRecipientOptions"
                                                            @bind-Value="editTemporaryIpApprovalRecipients" />
                                            <LmsMultiSelect Label="Allowed countries"
                                                            HelperText="Optional Cloudflare country allow-list using CF-IPCountry. Blank allows any country. Requests from other countries are denied before an approval email is sent."
                                                            Placeholder="Search countries"
                                                            EmptyText="No countries match."
                                                            Items="@CountryOptions"
                                                            @bind-Value="editTemporaryIpApprovalAllowedCountryCodes" />
                                            <div class="ui-field">
                                                <span class="ui-field-label">
                                                    Denied response
                                                    <LmsFieldInfo Title="Denied response">
                                                        <p>While Return 404 is off, unapproved clients see the access check page. That page lists CF-Connecting-IP, trusted-IP results, LAN trust, and email status — including on production.</p>
                                                        <p>Turn on Return 404 only when you want a silent Not Found instead of that diagnostic page.</p>
                                                    </LmsFieldInfo>
                                                </span>
                                                <label class="edge-checkbox-field">
                                                    <input type="checkbox" @bind="editTemporaryIpApprovalUseNotFoundResponse" />
                                                    <span>Return 404</span>
                                                </label>
                                            </div>
                                            <div class="ui-field">
                                                <span class="ui-field-label">
                                                    Shared IP access
                                                    <LmsFieldInfo Title="Shared IP access">
                                                        <p>Off by default. Approval is bound to the exact source IP and the client User-Agent, so a phone and a laptop on the same public IP need separate grants.</p>
                                                        <p>Enable this for a trusted home or office WAN IP when every browser on that IP should share one approval.</p>
                                                    </LmsFieldInfo>
                                                </span>
                                                <label class="edge-checkbox-field">
                                                    <input type="checkbox" @bind="editTemporaryIpApprovalAllowSharedIp" />
                                                    <span>Allow all clients from this IP</span>
                                                </label>
                                            </div>
                                            <div class="ui-field">
                                                <span class="ui-field-label">
                                                    Idle cut-off (minutes)
                                                    <LmsFieldInfo Title="Idle cut-off">
                                                        <p>Minutes without traffic before the grant expires. Blank uses the add-on default, currently 15 minutes.</p>
                                                    </LmsFieldInfo>
                                                </span>
                                                <input type="number" min="1" max="1440" @bind="editTemporaryIpApprovalIdleTimeoutMinutes" placeholder="15" />
                                            </div>
                                            <div class="ui-field">
                                                <span class="ui-field-label">
                                                    Maximum expiry (minutes)
                                                    <LmsFieldInfo Title="Maximum expiry">
                                                        <p>Absolute lifetime of an approval, even if the client stays active. Blank uses the add-on default, currently 120 minutes.</p>
                                                    </LmsFieldInfo>
                                                </span>
                                                <input type="number" min="1" max="10080" @bind="editTemporaryIpApprovalMaxLifetimeMinutes" placeholder="120" />
                                            </div>
                                        </div>
                                    </section>
                                </div>
                            }
                            @if (IsMfaOrTemporaryIpAccessPolicy(editAppAccessPolicy))
                            {
                                <div class="edge-auth-panels">
                                    <section class="edge-auth-panel">
                                        <header class="edge-auth-panel-header">
                                            <h4>
                                                Trusted source IPs
                                                <LmsFieldInfo Title="Trusted source IPs">
                                                    <p>Public WAN IPs or CIDRs that can skip MFA or email approval on this route. Matching uses CF-Connecting-IP for Cloudflare-tunnelled traffic.</p>
                                                    <p>By default this route uses the global list from Security. Turn on override only when this app needs a different list.</p>
                                                </LmsFieldInfo>
                                            </h4>
                                        </header>
                                        <div class="edge-auth-panel-grid">
                                            <div class="ui-field edge-auth-panel-span">
                                                <span class="ui-field-label">
                                                    Skip auth for trusted IPs
                                                    <LmsFieldInfo Title="Skip auth for trusted IPs">
                                                        <p>When enabled, a matching source IP is allowed without MFA, passkey, or email approval. Applies to whichever list is active: the global list, or this route's override list.</p>
                                                    </LmsFieldInfo>
                                                </span>
                                                <label class="edge-checkbox-field">
                                                    <input type="checkbox" @bind="editSkipAuthenticationForKnownIps" />
                                                    <span>Enabled</span>
                                                </label>
                                            </div>
                                            <div class="ui-field edge-auth-panel-span">
                                                <span class="ui-field-label">
                                                    Override global trusted IPs
                                                    <LmsFieldInfo Title="Override global trusted IPs">
                                                        <p>Off: this route uses Security → Global trusted source IPs.</p>
                                                        <p>On: the global list is ignored and only the route list below is used. Import global list copies the current global entries so you can add or remove from them.</p>
                                                    </LmsFieldInfo>
                                                </span>
                                                <label class="edge-checkbox-field">
                                                    <input type="checkbox" @bind="editOverrideGlobalTrustedIps" />
                                                    <span>Use a route-specific list</span>
                                                </label>
                                            </div>
                                            @if (editOverrideGlobalTrustedIps)
                                            {
                                                <div class="ui-field edge-auth-panel-span">
                                                    <span class="ui-field-label">
                                                        Route trusted IPs / CIDRs
                                                        <LmsFieldInfo Title="Route trusted IPs">
                                                            <p>Comma-separated IPs or CIDRs for this route only. The global list is ignored while override is on.</p>
                                                            <p>Get WAN IP adds this machine's current public address. Import global list seeds the field from Security.</p>
                                                        </LmsFieldInfo>
                                                    </span>
                                                    <div class="edge-inline-field-row">
                                                        <input @bind="editAppAllowKnownIps" placeholder="203.0.113.10, 198.51.100.0/24" />
                                                        <LmsButton Label="@(isFetchingEditWanIp ? "Looking up..." : "Get WAN IP")"
                                                                   Icon="search"
                                                                   Disabled="@isFetchingEditWanIp"
                                                                   OnClick="FetchEditKnownWanIpAsync" />
                                                        @if (!string.IsNullOrWhiteSpace(globalTrustedSourceIps))
                                                        {
                                                            <LmsButton Label="Import global list"
                                                                       Icon="download"
                                                                       OnClick="ImportGlobalTrustedIpsAsync" />
                                                        }
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(editWanIpMessage))
                                                    {
                                                        <span class="ui-field-helper">@editWanIpMessage</span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="ui-field edge-auth-panel-span">
                                                    <span class="ui-field-label">
                                                        Active list
                                                        <LmsFieldInfo Title="Active list">
                                                            <p>This route is using the global trusted source IP list. Change it in Security, or turn on override to use a list only for this app.</p>
                                                        </LmsFieldInfo>
                                                    </span>
                                                    @if (string.IsNullOrWhiteSpace(globalTrustedSourceIps))
                                                    {
                                                        <p class="meta-text">No global trusted IPs configured.</p>
                                                    }
                                                    else
                                                    {
                                                        <p class="meta-text"><code>@globalTrustedSourceIps</code></p>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </section>
                                    <section class="edge-auth-panel">
                                        <header class="edge-auth-panel-header">
                                            <h4>
                                                Verified LAN trust
                                                <LmsFieldInfo Title="Verified LAN trust">
                                                    <p>Only works when the client hits Edge Gateway with a real LAN source IP, usually via split or local DNS. Cloudflare tunnel clients are never trusted this way.</p>
                                                    <p>Prefer global trusted WAN IPs for home access through Cloudflare. Use LAN trust only if you also publish the hostname on the LAN.</p>
                                                </LmsFieldInfo>
                                            </h4>
                                        </header>
                                        <div class="edge-auth-panel-grid">
                                            <div class="ui-field edge-auth-panel-span">
                                                <span class="ui-field-label">
                                                    Enable LAN trust
                                                    <LmsFieldInfo Title="Enable LAN trust">
                                                        <p>Skip MFA or email approval when the source IP is inside the trusted LAN CIDRs and reverse DNS matches a trusted suffix.</p>
                                                    </LmsFieldInfo>
                                                </span>
                                                <label class="edge-checkbox-field">
                                                    <input type="checkbox" @bind="editLanTrustEnabled" />
                                                    <span>Enabled</span>
                                                </label>
                                            </div>
                                            @if (editLanTrustEnabled)
                                            {
                                                <div class="ui-field">
                                                    <span class="ui-field-label">
                                                        Trusted LAN CIDRs
                                                        <LmsFieldInfo Title="Trusted LAN CIDRs">
                                                            <p>Comma-separated private ranges, for example 192.168.1.0/24. The client source IP must fall inside one of these networks.</p>
                                                        </LmsFieldInfo>
                                                    </span>
                                                    <input @bind="editLanTrustCidrs" placeholder="192.168.1.0/24" />
                                                </div>
                                                <div class="ui-field">
                                                    <span class="ui-field-label">
                                                        Trusted DNS suffixes
                                                        <LmsFieldInfo Title="Trusted DNS suffixes">
                                                            <p>The PTR name of the LAN source IP must equal or end with one of these domains, for example home.arpa or lan.example.com.</p>
                                                        </LmsFieldInfo>
                                                    </span>
                                                    <input @bind="editLanTrustDnsSuffixes" placeholder="home.arpa" />
                                                </div>
                                                <div class="ui-field">
                                                    <span class="ui-field-label">
                                                        Forward confirm
                                                        <LmsFieldInfo Title="Forward confirm">
                                                            <p>Recommended. After reverse DNS, Edge Gateway resolves that name and requires it to point back to the same source IP. This blocks spoofed PTR records.</p>
                                                        </LmsFieldInfo>
                                                    </span>
                                                    <label class="edge-checkbox-field">
                                                        <input type="checkbox" @bind="editLanTrustRequireForwardConfirm" />
                                                        <span>Require forward DNS to match</span>
                                                    </label>
                                                </div>
                                                <div class="ui-field">
                                                    <span class="ui-field-label">
                                                        Max latency (ms)
                                                        <LmsFieldInfo Title="Max latency">
                                                            <p>Optional ICMP ping gate. If set, the LAN client must reply within this many milliseconds. Blank disables latency checking.</p>
                                                        </LmsFieldInfo>
                                                    </span>
                                                    <input type="number" min="1" max="2000" @bind="editLanTrustMaxLatencyMilliseconds" placeholder="optional" />
                                                </div>
                                            }
                                        </div>
                                    </section>
                                </div>
                            }
                            @if (IsPassThroughAccessPolicy(editAppAccessPolicy))
                            {
                                <div class="callout warning edge-pass-through-warning" role="alert">
                                    <strong>Pass-through has no LMS login</strong>
                                    <span>@PassThroughWarningText</span>
                                </div>
                            }
                            <div class="edge-readonly-field edge-route-preview-field">
                                <span class="ui-field-label">
                                    Route
                                    <LmsFieldInfo Title="Route">
                                        <p>Preview of the Caddy proxy from the public hostname to the local target after you save.</p>
                                    </LmsFieldInfo>
                                </span>
                                <strong>@editingRoute.PublicHostname</strong>
                                <span><code>@BuildEditRoutePreview()</code></span>
                            </div>
                            <details class="edge-advanced-settings">
                                <summary>
                                    <span>Advanced settings</span>
                                    <small>Proxy headers and upstream TLS</small>
                                </summary>
                                <div class="edge-advanced-settings-body">
                                    <div class="ui-field">
                                        <span class="ui-field-label">
                                            Send public Host header
                                            <LmsFieldInfo Title="Send public Host header">
                                                <p>When on, Caddy sends the public hostname to the upstream. Turn this on for apps that generate links from the Host header.</p>
                                                <p>When off, the upstream sees its internal host name instead.</p>
                                            </LmsFieldInfo>
                                        </span>
                                        <label class="edge-checkbox-field">
                                            <input type="checkbox" @bind="editAppUsePublicHostHeader" />
                                            <span>Enabled</span>
                                        </label>
                                    </div>
                                    <div class="ui-field">
                                        <span class="ui-field-label">
                                            Strip X-Forwarded-For
                                            <LmsFieldInfo Title="Strip X-Forwarded-For">
                                                <p>When on, Caddy does not pass the client IP chain to the upstream. Use this when the app should not see or trust forwarded client addresses.</p>
                                            </LmsFieldInfo>
                                        </span>
                                        <label class="edge-checkbox-field">
                                            <input type="checkbox" @bind="editAppStripForwardedFor" />
                                            <span>Enabled</span>
                                        </label>
                                    </div>
                                    <div class="ui-field">
                                        <span class="ui-field-label">
                                            Skip upstream TLS verification
                                            <LmsFieldInfo Title="Skip upstream TLS verification">
                                                <p>When the target scheme is https, this allows a self-signed or otherwise untrusted upstream certificate. Typical for Home Assistant HTTPS on the LAN. Leave off if the upstream has a valid certificate.</p>
                                            </LmsFieldInfo>
                                        </span>
                                        <label class="edge-checkbox-field">
                                            <input type="checkbox" @bind="editAppSkipUpstreamTlsVerification" />
                                            <span>Enabled</span>
                                        </label>
                                    </div>
                                </div>
                            </details>
                        </div>
                    </div>

                    <footer class="edge-modal-footer">
                        <button class="lms-button" type="button" @onclick="CloseEditRouteModal">Cancel</button>
                        <LmsButton Label="@(isSavingRouteEdit ? "Saving..." : "Save app")"
                                   Icon="save"
                                   Primary="true"
                                   Disabled="@isSavingRouteEdit"
                                   OnClick="SaveRouteEditAsync" />
                    </footer>
                </section>
            </div>
        }

        @if (addAppRelay is not null)
        {
            <RouteAddModal Relay="addAppRelay"
                           OnClose="CloseAddAppModal"
                           OnSaved="HandleAddAppSavedAsync" />
        }
    }
</div>

