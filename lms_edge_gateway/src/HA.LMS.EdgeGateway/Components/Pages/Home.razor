            : route.AccessPolicy;

    private static LmsStatusTone GetAccessTone(PublishedApplicationDefinition route) =>
        IsBlockedAccessPolicy(route.AccessPolicy)
            ? LmsStatusTone.Critical
            : IsPassThroughAccessPolicy(route.AccessPolicy)
            ? LmsStatusTone.Warning
            : IsTemporaryIpApprovalAccessPolicy(route.AccessPolicy)
            ? LmsStatusTone.Ready
            : LmsStatusTone.Ready;

    private const string PassThroughWarningText =
        "Internet traffic for this hostname is passed straight to the destination service. LMS MFA and passkeys are not required on this route, so use pass-through only when the destination is public by design or has the authentication and authorization you require.";

    private const string TemporaryIpApprovalWarningText =
        "The first request is denied and an approval email is sent. Approval only allows this app from the exact source IP for the requesting client by default, then expires on the configured idle cut-off or maximum lifetime. Optionally allow every client on that IP for trusted home/LAN networks. Repeated emails for the same app/client are throttled.";

    private static bool IsBlockedAccessPolicy(string? accessPolicy) =>
        EdgeGatewayAccessPolicies.IsBlocked(accessPolicy);

    private static bool IsPassThroughAccessPolicy(string? accessPolicy)
        => EdgeGatewayAccessPolicies.IsPassThrough(accessPolicy);

    private static bool IsTemporaryIpApprovalAccessPolicy(string? accessPolicy)
        => EdgeGatewayAccessPolicies.IsTemporaryIpApproval(accessPolicy);

    private static bool IsMfaOrTemporaryIpAccessPolicy(string? accessPolicy) =>
        !IsPassThroughAccessPolicy(accessPolicy) &&
        !IsBlockedAccessPolicy(accessPolicy);

    private static string BuildTemporaryIpApprovalSummary(PublishedApplicationDefinition route)
    {
        var recipients = string.IsNullOrWhiteSpace(route.TemporaryIpApprovalRecipients)
            ? "Recipients: route allowed users or enabled LMS users."
            : $"Recipients: {route.TemporaryIpApprovalRecipients}.";
        var countries = string.IsNullOrWhiteSpace(route.TemporaryIpApprovalAllowedCountryCodes)
            ? "Countries: any."
            : $"Countries: {route.TemporaryIpApprovalAllowedCountryCodes}.";
        var response = route.TemporaryIpApprovalUseNotFoundResponse
            ? "Denied response: 404."
            : "Denied response: access check page.";
        var sharedIp = route.TemporaryIpApprovalAllowSharedIp
            ? "Scope: all clients on this IP."
            : "Scope: requesting client only.";
        var idleCutOff = route.TemporaryIpApprovalIdleTimeoutMinutes is null
            ? "Idle cut-off: default."
            : $"Idle cut-off: {route.TemporaryIpApprovalIdleTimeoutMinutes} min.";
        var maxLifetime = route.TemporaryIpApprovalMaxLifetimeMinutes is null
            ? "Maximum expiry: default."
            : $"Maximum expiry: {route.TemporaryIpApprovalMaxLifetimeMinutes} min.";
        return $"{recipients} {countries} {response} {sharedIp} {idleCutOff} {maxLifetime}";
    }

    private static string BuildExternalRouteUrl(PublishedApplicationDefinition route)
    {
        var path = NormalizeRoutePathPrefix(route.TargetPathPrefix);
        var baseUrl = route.PublicHostname.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
                      route.PublicHostname.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            ? route.PublicHostname
            : $"https://{route.PublicHostname}";

        if (!string.IsNullOrWhiteSpace(path))
        {
            return $"{baseUrl.TrimEnd('/')}{path}";
        }

        return baseUrl;
    }

    private static string BuildRelayHost(string domainName) =>
        domainName.Equals("Local routes", StringComparison.OrdinalIgnoreCase)
            ? "local relay"
            : $"{RelayNamespace}.{domainName}";

    private string BuildRouteDomainSummary(string domainName)
    {
        if (domainName.Equals("Local routes", StringComparison.OrdinalIgnoreCase))
        {
            return "Local-only route record.";
        }

        var relay = GetConfiguredRelay(domainName);
        return relay is not null
            ? IsTunnelHealthy(relay.TunnelStatus)
                ? $"Relay ready via {BuildRelayHost(domainName)}."
                : $"Relay configured via {BuildRelayHost(domainName)}; tunnel status is {NormalizeTunnelStatus(relay.TunnelStatus)}."
            : "Setup Relay before adding apps on this domain.";
    }

    private bool IsRelayConfigured(string domainName) =>
        GetConfiguredRelay(domainName) is not null;

    private EdgeGatewayRelayZone? GetConfiguredRelay(string domainName) =>
        status?.Configuration.RelayZones.FirstOrDefault(relay =>
            relay.DomainName.Equals(domainName, StringComparison.OrdinalIgnoreCase) &&
            !string.IsNullOrWhiteSpace(relay.TunnelId) &&
            !string.IsNullOrWhiteSpace(relay.DnsTarget) &&
            !string.IsNullOrWhiteSpace(relay.WildcardHostname));

    private static bool IsTunnelHealthy(string status) =>
        string.Equals(
            NormalizeTunnelStatus(status),
            "healthy",
            StringComparison.OrdinalIgnoreCase);

    private static string NormalizeTunnelStatus(string status) =>
        string.IsNullOrWhiteSpace(status) ? "unknown" : status.Trim().ToLowerInvariant();

    private static string GetDomainName(PublishedApplicationDefinition route)
    {
        var host = route.PublicHostname;
        if (Uri.TryCreate(route.PublicHostname, UriKind.Absolute, out var uri))
        {
            host = uri.Host;
        }
        else
        {
            host = host.Split('/', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? host;
        }

        host = host.Trim().TrimEnd('.');
        if (string.IsNullOrWhiteSpace(host))
        {
            return "Local routes";
        }

        var parts = host.Split('.', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[^2]}.{parts[^1]}"
            : host;
    }

    private static string GetHostLabel(PublishedApplicationDefinition route)
    {
        var host = NormalizeRouteHostname(route.PublicHostname);
        var domainName = GetDomainName(route);
        return host.EndsWith($".{domainName}", StringComparison.OrdinalIgnoreCase)
            ? host[..^($".{domainName}".Length)].Trim('.')
            : host;
    }

    private static string NormalizeRouteHostname(string value)
    {
        if (Uri.TryCreate(value, UriKind.Absolute, out var uri))
        {
            return uri.Host.Trim().TrimEnd('.').ToLowerInvariant();
        }

        return (value ?? string.Empty)
            .Split('/', StringSplitOptions.RemoveEmptyEntries)
            .FirstOrDefault()?
            .Trim()
            .TrimEnd('.')
            .ToLowerInvariant() ?? string.Empty;
    }

    private static string NormalizeRoutePathPrefix(string? value)
    {
        var normalized = (value ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(normalized) || normalized == "/")
        {
            return string.Empty;
        }

        return normalized.StartsWith("/", StringComparison.Ordinal)
            ? normalized.TrimEnd('/')
            : $"/{normalized.TrimEnd('/')}";
    }

    private static bool IsHttpsUrl(string value) =>
        Uri.TryCreate(value, UriKind.Absolute, out var uri) &&
        uri.Scheme.Equals(Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase);

    private static bool IsHomeAssistantRoute(PublishedApplicationDefinition route) =>
        route.Name.Contains("home assistant", StringComparison.OrdinalIgnoreCase) ||
        NormalizeRouteHostname(route.PublicHostname).StartsWith("hassio.", StringComparison.OrdinalIgnoreCase) ||
        NormalizeRouteHostname(route.PublicHostname).StartsWith("homeassistant.", StringComparison.OrdinalIgnoreCase) ||
        NormalizeRouteHostname(route.PublicHostname).StartsWith("home-assistant.", StringComparison.OrdinalIgnoreCase) ||
        (Uri.TryCreate(route.UpstreamUrl, UriKind.Absolute, out var uri) && uri.Port == 8123);

    private bool EditRouteLooksHomeAssistant() =>
        editingRoute is not null &&
        (editAppName.Contains("home assistant", StringComparison.OrdinalIgnoreCase) ||
         NormalizeRouteHostname(editingRoute.PublicHostname).StartsWith("hassio.", StringComparison.OrdinalIgnoreCase) ||
         NormalizeRouteHostname(editingRoute.PublicHostname).StartsWith("homeassistant.", StringComparison.OrdinalIgnoreCase) ||
         NormalizeRouteHostname(editingRoute.PublicHostname).StartsWith("home-assistant.", StringComparison.OrdinalIgnoreCase) ||
         editAppTargetPort == 8123);

    private bool EditHomeAssistantTargetLooksExternal() =>
        EditRouteLooksHomeAssistant() &&
        editAppTargetPort != 8123 &&
        !IsLocalOrPrivateTargetHost(editAppTargetHost);

    private string BuildHomeAssistantTargetRepairTitle() =>
        EditHomeAssistantTargetLooksExternal()
            ? "Home Assistant is targeting another public HTTPS host."
            : "Home Assistant internal target";

    private string BuildHomeAssistantTargetRepairDetail() =>
        EditHomeAssistantTargetLooksExternal()
            ? "Use an internal target to avoid OAuth/proxy loops."
            : "Use HTTP for default HA installs, or HTTPS when this HA instance has SSL enabled on 8123.";

    private static bool ShouldUsePublicHostHeaderInEditor(PublishedApplicationDefinition route)
    {
        if (IsHomeAssistantRoute(route) &&
            Uri.TryCreate(route.UpstreamUrl, UriKind.Absolute, out var upstream) &&
            upstream.Port != 8123 &&
            !IsLocalOrPrivateTargetHost(upstream.Host))
        {
            return false;
        }

        return route.UsePublicHostHeader ?? IsHomeAssistantRoute(route);
    }

    private static bool IsLocalOrPrivateTargetHost(string host)
    {
        var normalized = (host ?? string.Empty).Trim().Trim('[', ']').TrimEnd('.').ToLowerInvariant();
        if (normalized is "homeassistant" or "localhost" or "127.0.0.1" or "::1")
        {
            return true;
        }

        if (normalized.EndsWith(".local", StringComparison.OrdinalIgnoreCase) ||
            normalized.EndsWith(".localdomain", StringComparison.OrdinalIgnoreCase) ||
            normalized.EndsWith(".lan", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (!IPAddress.TryParse(normalized, out var address))
        {
            return false;
        }

        if (IPAddress.IsLoopback(address))
        {
            return true;
        }

        if (address.AddressFamily != System.Net.Sockets.AddressFamily.InterNetwork)
        {
            return false;
        }

        var bytes = address.GetAddressBytes();
        return bytes[0] == 10 ||
               bytes[0] == 192 && bytes[1] == 168 ||
               bytes[0] == 172 && bytes[1] is >= 16 and <= 31;
    }

    private string BuildEditRoutePreview()
    {
        var scheme = string.IsNullOrWhiteSpace(editAppTargetScheme)
            ? "http"
            : editAppTargetScheme.Trim().ToLowerInvariant();
        var host = string.IsNullOrWhiteSpace(editAppTargetHost)
            ? "homeassistant"
            : editAppTargetHost.Trim();
        var port = Math.Clamp(editAppTargetPort, 1, 65535);
        var path = NormalizeRoutePathPrefix(editAppTargetPathPrefix);
        var hostname = editingRoute?.PublicHostname ?? "app.example.com";
        var externalUrl = string.IsNullOrWhiteSpace(path)
            ? hostname
            : $"{hostname}{path}";
        return $"{externalUrl} -> {scheme}://{host}:{port}";
    }

    private sealed record RouteDomainGroup(string DomainName, IReadOnlyList<PublishedApplicationDefinition> Routes)
    {
        public int EnabledCount => Routes.Count(route => route.IsEnabled);
    }
}
