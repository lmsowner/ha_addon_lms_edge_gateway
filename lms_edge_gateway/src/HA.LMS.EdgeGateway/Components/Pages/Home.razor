            routeActionMessage = result.Summary;
            routeActionIsError = !result.Success;
            routeActionSteps = result.Checks;
            routeActionWarnings = result.Warnings;
            routeTestLabels[routeId] = result.Success ? "Test passed" : "Test failed";
            routeTestTones[routeId] = result.Success ? LmsStatusTone.Ready : LmsStatusTone.Warning;
        }
        catch (Exception exception)
        {
            routeActionMessage = $"Route test failed: {exception.Message}";
            routeActionIsError = true;
            routeTestLabels[routeId] = "Test failed";
            routeTestTones[routeId] = LmsStatusTone.Warning;
