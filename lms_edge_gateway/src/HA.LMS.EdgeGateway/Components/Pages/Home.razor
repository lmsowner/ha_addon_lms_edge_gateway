@page "/"
@rendermode InteractiveServer
@using System.Net
@inject IEdgeGatewayStatusService StatusService
@inject IEdgeGatewayRelayProvisioningService RelayProvisioningService
@inject IEdgeGatewaySecurityService SecurityService
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Published Apps | Linux Made Sane - Edge Gateway</PageTitle>

<div class="page-shell edge-gateway-page">
    @if (status is null)
    {
        <section class="surface-card edge-loading-card" aria-busy="true">
            <span class="edge-loading-progress">
                <span class="edge-loading-progress-fill"></span>
            </span>
            <p class="meta-text">Loading Edge Gateway...</p>
        </section>
    }
    else
    {
        <section class="edge-route-page-section">
            <div class="table-header">
                <div>
                    <p class="eyebrow">Services</p>
                    <h2>Apps and hosts exposed through Edge Gateway</h2>
                    <p class="meta-text">Adding a service from Setup creates the Cloudflare DNS record, tunnel ingress, and Caddy route.</p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(routeActionMessage))
            {
                <p class="callout @(routeActionIsError ? "warning" : "ready")">@routeActionMessage</p>
            }

            @if (routeActionSteps.Count > 0)
            {
                <div class="edge-provision-log">
                    <strong>Last action steps</strong>
                    <ul class="plain-list">
                        @foreach (var step in routeActionSteps)
                        {
                            <li>@step</li>
                        }
                    </ul>
                </div>
            }

            @if (routeActionWarnings.Count > 0)
            {
                <div class="edge-provision-log warning">
                    <strong>Warnings</strong>
                    <ul class="plain-list">
                        @foreach (var warning in routeActionWarnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                </div>
            }

            @if (status.Configuration.Applications.Count == 0)
            {
                <p class="meta-text">No services yet. Use Setup to prepare a relay and add a service.</p>
            }
            else
            {
                <div class="edge-route-list">
                    @foreach (var domainGroup in RouteDomainGroups)
                    {
                        var domainPanelId = BuildRouteDomainPanelId(domainGroup.DomainName);
                        var isDomainExpanded = IsRouteDomainExpanded(domainGroup.DomainName);

                        <section class="edge-route-domain-group">
                            <div class="edge-route-domain-header @(isDomainExpanded ? string.Empty : "collapsed")" aria-expanded="@(isDomainExpanded ? "true" : "false")">
                                <button class="edge-route-domain-toggle"
                                        type="button"
                                        aria-controls="@domainPanelId"
                                        aria-expanded="@(isDomainExpanded ? "true" : "false")"
                                        @onclick="@(() => ToggleRouteDomain(domainGroup.DomainName))">
                                    <span class="edge-route-domain-chevron @(isDomainExpanded ? "expanded" : string.Empty)" aria-hidden="true"></span>
                                    <span class="edge-route-domain-copy">
                                        <strong>@domainGroup.DomainName</strong>
                                        <span>@BuildRouteDomainSummary(domainGroup.DomainName)</span>
                                    </span>
                                </button>
                                <span class="edge-route-domain-pills">
                                    <span class="edge-route-domain-pill">@domainGroup.Routes.Count app@(domainGroup.Routes.Count == 1 ? string.Empty : "s")</span>
                                    <span class="edge-route-domain-pill">@domainGroup.EnabledCount enabled</span>
                                    <LmsButton Label="Add App"
                                               Icon="plus"
                                               Primary="true"
                                               Disabled="@(!IsRelayConfigured(domainGroup.DomainName) || isRouteActionBusy)"
                                               OnClick="@(() => OpenAddAppModal(domainGroup.DomainName))" />
                                </span>
                            </div>

                            @if (isDomainExpanded)
                            {
                                <div class="edge-route-domain-apps" id="@domainPanelId">
                                    @foreach (var route in domainGroup.Routes)
                                    {
                                        <article class="surface-subcard edge-route-card">
                                            <div class="edge-route-card-header">
                                                <div class="edge-route-title">
                                                    <h3>@route.Name</h3>
                                                    <span class="edge-route-title-pills">
                                                        <LmsStatusPill Text="@(route.IsEnabled ? "Enabled" : "Disabled")" Tone="@(route.IsEnabled ? LmsStatusTone.Ready : LmsStatusTone.Neutral)" />
                                                        <LmsStatusPill Text="@BuildAccessLabel(route)" Tone="@GetAccessTone(route)" />
                                                        <LmsStatusPill Text="@GetRouteTestLabel(route.Id)" Tone="@GetRouteTestTone(route.Id)" />
                                                    </span>
                                                </div>
                                                <div class="edge-route-actions">
                                                    <LmsButton Label="@(IsRouteBusy(route.Id, RouteToggleAction) ? "Saving..." : route.IsEnabled ? "Disable" : "Enable")"
                                                               Icon="@(route.IsEnabled ? "disable" : "publish")"
                                                               Danger="@route.IsEnabled"
                                                               Primary="@(!route.IsEnabled)"
                                                               Disabled="@isRouteActionBusy"
                                                               OnClick="@(() => ToggleRouteAsync(route.Id, route.IsEnabled))" />
                                                    <LmsButton Label="@(IsRouteBusy(route.Id, RouteTestAction) ? "Testing..." : "Test")"
                                                               Icon="test"
                                                               Disabled="@isRouteActionBusy"
                                                               OnClick="@(() => TestRouteAsync(route.Id))" />
                                                    <LmsButton Label="Edit"
                                                               Icon="edit"
                                                               Disabled="@isRouteActionBusy"
                                                               OnClick="@(() => OpenEditRouteModal(route))" />
                                                    <LmsButton Label="@(IsRouteBusy(route.Id, RouteDeleteAction) ? "Deleting..." : "Delete")"
                                                               Icon="delete"
                                                               Danger="true"
                                                               Disabled="@isRouteActionBusy"
                                                               OnClick="@(() => DeleteRouteAsync(route.Id))" />
                                                </div>
                                            </div>
                                            <div class="edge-route-links">
                                                <span class="edge-route-link">
                                                    <span>External</span>
                                                    <a href="@BuildExternalRouteUrl(route)" target="_blank" rel="noopener noreferrer">@BuildExternalRouteUrl(route)</a>
                                                </span>
                                                <span class="edge-route-link">
                                                    <span>Internal</span>
                                                    <a href="@route.UpstreamUrl" target="_blank" rel="noopener noreferrer">@route.UpstreamUrl</a>
                                                </span>
                                            </div>
                                            @if (route.IsEnabled && IsPassThroughAccessPolicy(route.AccessPolicy))
                                            {
                                                <div class="callout warning edge-pass-through-warning" role="alert">
                                                    <strong>Pass-through is enabled</strong>
                                                    <span>@PassThroughWarningText</span>
                                                </div>
                                            }
                                            else if (route.IsEnabled && IsTemporaryIpApprovalAccessPolicy(route.AccessPolicy))
                                            {
                                                <div class="callout ready edge-pass-through-warning" role="status">
                                                    <strong>Email approve IP is enabled</strong>
                                                    <span>@TemporaryIpApprovalWarningText</span>
                                                    <span>@BuildTemporaryIpApprovalSummary(route)</span>
                                                </div>
                                            }
                                        </article>
                                    }
                                </div>
                            }
                        </section>
                    }
                </div>
            }
        </section>

        @if (editingRoute is not null)
        {
            <div class="edge-modal-backdrop" role="presentation">
                <section class="edge-modal-panel"
                         role="dialog"
                         aria-modal="true"
                         aria-labelledby="edge-edit-app-title"
                         @onclick:stopPropagation="true">
                    <header class="edge-modal-header">
                        <div>
                            <p class="eyebrow">Edit app</p>
                            <h2 id="edge-edit-app-title">@editingRoute.PublicHostname</h2>
                            <p class="meta-text">Update the local Caddy target for this published host.</p>
                        </div>
                        <button class="edge-modal-close" type="button" aria-label="Close edit app" @onclick="CloseEditRouteModal">x</button>
                    </header>

                    <div class="edge-modal-body">
                        <div class="edge-token-guide-grid">
                            <label class="ui-field">
                                <span class="ui-field-label">App name</span>
                                <input @bind="editAppName" placeholder="Home Assistant" />
                            </label>
                            <div class="edge-readonly-field">
                                <span class="ui-field-label">Public host</span>
                                <strong>@editingRoute.PublicHostname</strong>
                                <span>Delete and add the app again if the public hostname needs to change.</span>
                            </div>
                            <label class="ui-field">
                                <span class="ui-field-label">URL path prefix</span>
                                <input @bind="editAppTargetPathPrefix" placeholder="/plex" />
                                <span class="ui-field-helper">Optional. Caddy strips this prefix before proxying.</span>
                            </label>
                            <label class="ui-field">
                                <span class="ui-field-label">Target scheme</span>
                                <select @bind="editAppTargetScheme">
                                    <option value="http">http</option>
                                    <option value="https">https</option>
                                </select>
                            </label>
                            <label class="ui-field">
                                <span class="ui-field-label">Target host or container</span>
                                <input @bind="editAppTargetHost" placeholder="homeassistant or 192.168.1.50" />
                            </label>
                            <label class="ui-field">
                                <span class="ui-field-label">Target port</span>
                                <input type="number" min="1" max="65535" @bind="editAppTargetPort" />
                            </label>
                            @if (EditRouteLooksHomeAssistant())
                            {
                                <div class="callout @(EditHomeAssistantTargetLooksExternal() ? "warning" : "ready") edge-ha-target-warning">
                                    <div>
                                        <strong>@BuildHomeAssistantTargetRepairTitle()</strong>
                                        <span>@BuildHomeAssistantTargetRepairDetail()</span>
                                    </div>
                                    <div class="edge-ha-target-actions">
                                        <LmsButton Label="Internal HTTP"
                                                   Icon="check"
                                                   OnClick="@(() => UseInternalHomeAssistantTarget(Uri.UriSchemeHttp))" />
                                        <LmsButton Label="Internal HTTPS"
                                                   Icon="check"
                                                   Primary="true"
                                                   OnClick="@(() => UseInternalHomeAssistantTarget(Uri.UriSchemeHttps))" />
                                    </div>
                                </div>
                            }
                            <label class="ui-field">
                                <span class="ui-field-label">Access policy</span>
                                <select @bind="editAppAccessPolicy">
                                    <option value="MFA/Passkey">MFA/Passkey</option>
                                    <option value="@EdgeGatewayAccessPolicies.TemporaryIpApproval">Email approve IP</option>
                                    <option value="Pass Through">Pass through</option>
                                </select>
                            </label>
                            @if (IsTemporaryIpApprovalAccessPolicy(editAppAccessPolicy))
                            {
                                <div class="callout ready edge-pass-through-warning" role="status">
                                    <strong>Email approval gates this route by source IP</strong>
                                    <span>@TemporaryIpApprovalWarningText</span>
                                </div>
                                <div class="edge-auth-panels">
                                    <section class="edge-auth-panel">
                                        <header class="edge-auth-panel-header">
                                            <h4>Email approval</h4>
                                            <p>Who gets the email, optional country filter, and how long a grant lasts.</p>
                                        </header>
                                        <div class="edge-auth-panel-grid">
                                            <LmsMultiSelect Label="Approval recipients"
                                                            HelperText="Optional. Blank sends to route allowed users, then enabled LMS users."
                                                            Placeholder="Choose LMS users"
                                                            EmptyText="No enabled LMS users match."
                                                            Items="@approvalRecipientOptions"
                                                            @bind-Value="editTemporaryIpApprovalRecipients" />
                                            <LmsMultiSelect Label="Allowed countries"
                                                            HelperText="Optional Cloudflare country allow-list. Blank allows any country."
                                                            Placeholder="Search countries"
                                                            EmptyText="No countries match."
                                                            Items="@CountryOptions"
                                                            @bind-Value="editTemporaryIpApprovalAllowedCountryCodes" />
                                            <label class="ui-field">
                                                <span class="ui-field-label">Denied response</span>
                                                <span class="edge-checkbox-field">
                                                    <input type="checkbox" @bind="editTemporaryIpApprovalUseNotFoundResponse" />
                                                    <span>Return 404</span>
                                                </span>
                                                <span class="ui-field-helper">Shown for all unapproved clients while off — including production. Lists CF-Connecting-IP, known-IP/LAN results, and email status. Turn on Return 404 only when you want a silent Not Found instead.</span>
                                            </label>
                                            <label class="ui-field">
                                                <span class="ui-field-label">Shared IP access</span>
                                                <span class="edge-checkbox-field">
                                                    <input type="checkbox" @bind="editTemporaryIpApprovalAllowSharedIp" />
                                                    <span>Allow all clients from this IP</span>
                                                </span>
                                                <span class="ui-field-helper">Off by default. Binds approval to User-Agent. Enable for trusted home/LAN public IPs.</span>
                                            </label>
                                            <label class="ui-field">
                                                <span class="ui-field-label">Idle cut-off (minutes)</span>
                                                <input type="number" min="1" max="1440" @bind="editTemporaryIpApprovalIdleTimeoutMinutes" placeholder="15" />
                                                <span class="ui-field-helper">Minutes without traffic. Blank uses the default.</span>
                                            </label>
                                            <label class="ui-field">
                                                <span class="ui-field-label">Maximum expiry (minutes)</span>
                                                <input type="number" min="1" max="10080" @bind="editTemporaryIpApprovalMaxLifetimeMinutes" placeholder="120" />
                                                <span class="ui-field-helper">Absolute approval lifetime. Blank uses the default.</span>
                                            </label>
                                        </div>
                                    </section>
                                </div>
                            }
                            @if (IsMfaOrTemporaryIpAccessPolicy(editAppAccessPolicy))
                            {
                                <div class="edge-auth-panels">
                                    <section class="edge-auth-panel">
                                        <header class="edge-auth-panel-header">
                                            <h4>Known source IPs</h4>
                                            <p>Allow-list by public WAN IP/CIDR. Useful when clients still arrive through Cloudflare.</p>
                                        </header>
                                        <div class="edge-auth-panel-grid">
                                            <label class="ui-field edge-auth-panel-span">
                                                <span class="ui-field-label">Known source IPs</span>
                                                <div class="edge-inline-field-row">
                                                    <input @bind="editAppAllowKnownIps" placeholder="203.0.113.10, 198.51.100.0/24" />
                                                    <LmsButton Label="@(isFetchingEditWanIp ? "Looking up..." : "Get current WAN IP")"
                                                               Icon="search"
                                                               Disabled="@isFetchingEditWanIp"
                                                               OnClick="FetchEditKnownWanIpAsync" />
                                                </div>
                                                <span class="ui-field-helper">Comma-separated IPs/CIDRs. Blank allows any source IP through to the checks below.</span>
                                                @if (!string.IsNullOrWhiteSpace(editWanIpMessage))
                                                {
                                                    <span class="ui-field-helper">@editWanIpMessage</span>
                                                }
                                            </label>
                                            <label class="ui-field edge-auth-panel-span">
                                                <span class="ui-field-label">Skip auth for known IPs</span>
                                                <span class="edge-checkbox-field">
                                                    <input type="checkbox" @bind="editSkipAuthenticationForKnownIps" />
                                                    <span>Skip MFA / email approval for matching source IPs</span>
                                                </span>
                                                <span class="ui-field-helper">Typical use: your home public WAN IP. Requires Known source IPs above.</span>
                                            </label>
                                        </div>
                                    </section>
                                    <section class="edge-auth-panel">
                                        <header class="edge-auth-panel-header">
                                            <h4>Verified LAN trust</h4>
                                            <p>Only when the client hits Edge Gateway with a real LAN IP (split/local DNS). Cloudflare tunnel clients are never trusted this way.</p>
                                        </header>
                                        <div class="edge-auth-panel-grid">
                                            <label class="ui-field edge-auth-panel-span">
                                                <span class="ui-field-label">Enable LAN trust</span>
                                                <span class="edge-checkbox-field">
                                                    <input type="checkbox" @bind="editLanTrustEnabled" />
                                                    <span>Skip auth for verified LAN clients</span>
                                                </span>
                                            </label>
                                            @if (editLanTrustEnabled)
                                            {
                                                <label class="ui-field">
                                                    <span class="ui-field-label">Trusted LAN CIDRs</span>
                                                    <input @bind="editLanTrustCidrs" placeholder="192.168.1.0/24" />
                                                    <span class="ui-field-helper">Comma-separated, for example 192.168.1.0/24.</span>
                                                </label>
                                                <label class="ui-field">
                                                    <span class="ui-field-label">Trusted DNS suffixes</span>
                                                    <input @bind="editLanTrustDnsSuffixes" placeholder="home.arpa" />
                                                    <span class="ui-field-helper">PTR of the LAN source IP must end with one of these domains.</span>
                                                </label>
                                                <label class="ui-field">
                                                    <span class="ui-field-label">Forward confirm</span>
                                                    <span class="edge-checkbox-field">
                                                        <input type="checkbox" @bind="editLanTrustRequireForwardConfirm" />
                                                        <span>Require forward DNS to match the same IP</span>
                                                    </span>
                                                    <span class="ui-field-helper">Recommended. PTR name must resolve back to the source IP.</span>
                                                </label>
                                                <label class="ui-field">
                                                    <span class="ui-field-label">Max latency (ms)</span>
                                                    <input type="number" min="1" max="2000" @bind="editLanTrustMaxLatencyMilliseconds" placeholder="optional" />
                                                    <span class="ui-field-helper">Optional ICMP gate. Blank disables latency checking.</span>
                                                </label>
                                            }
                                        </div>
                                    </section>
                                </div>
                            }
                            @if (IsPassThroughAccessPolicy(editAppAccessPolicy))
                            {
                                <div class="callout warning edge-pass-through-warning" role="alert">
                                    <strong>Pass-through sends internet traffic straight to the destination</strong>
                                    <span>@PassThroughWarningText</span>
                                </div>
                            }
                            <div class="edge-readonly-field edge-route-preview-field">
                                <span class="ui-field-label">Route</span>
                                <strong>@editingRoute.PublicHostname</strong>
                                <span><code>@BuildEditRoutePreview()</code></span>
                            </div>
                            <details class="edge-advanced-settings">
                                <summary>
                                    <span>Advanced settings</span>
                                    <small>Proxy headers and upstream TLS</small>
                                </summary>
                                <div class="edge-advanced-settings-body">
                                    <label class="edge-checkbox-field">
                                        <input type="checkbox" @bind="editAppUsePublicHostHeader" />
                                        <span>Send public Host header</span>
                                    </label>
                                    <label class="edge-checkbox-field">
                                        <input type="checkbox" @bind="editAppStripForwardedFor" />
                                        <span>Strip X-Forwarded-For</span>
                                    </label>
                                    <label class="edge-checkbox-field">
                                        <input type="checkbox" @bind="editAppSkipUpstreamTlsVerification" />
                                        <span>Skip upstream TLS verification</span>
                                    </label>
                                </div>
                            </details>
                        </div>
                    </div>

                    <footer class="edge-modal-footer">
                        <button class="lms-button" type="button" @onclick="CloseEditRouteModal">Cancel</button>
                        <LmsButton Label="@(isSavingRouteEdit ? "Saving..." : "Save app")"
                                   Icon="save"
                                   Primary="true"
                                   Disabled="@isSavingRouteEdit"
                                   OnClick="SaveRouteEditAsync" />
                    </footer>
                </section>
            </div>
        }

        @if (addAppRelay is not null)
        {
            <RouteAddModal Relay="addAppRelay"
                           OnClose="CloseAddAppModal"
                           OnSaved="HandleAddAppSavedAsync" />
        }
    }
</div>

@code {
    private EdgeGatewayRuntimeStatus? status;
    private const string RelayNamespace = "ha-app-relay";
    private const string RouteToggleAction = "toggle";
    private const string RouteTestAction = "test";
    private const string RouteDeleteAction = "delete";
    private const string RouteEditAction = "edit";
    private bool isRouteActionBusy;
    private bool routeActionIsError;
    private bool isSavingRouteEdit;
    private Guid? routeActionRouteId;
    private string routeActionName = string.Empty;
    private string routeActionMessage = string.Empty;
    private IReadOnlyList<string> routeActionSteps = [];
    private IReadOnlyList<string> routeActionWarnings = [];
    private EdgeGatewayRelayZone? addAppRelay;
    private PublishedApplicationDefinition? editingRoute;
    private string editAppName = string.Empty;
    private string editAppHostLabel = string.Empty;
    private string editAppTargetScheme = "http";
    private string editAppTargetHost = string.Empty;
    private int editAppTargetPort = 80;
    private string editAppAccessPolicy = "MFA/Passkey";
    private string editAppTargetPathPrefix = string.Empty;
    private string editAppAllowKnownIps = string.Empty;
    private string editAppAllowedUsers = string.Empty;
    private string editAppAllowedGroups = string.Empty;
    private string editAppNotes = string.Empty;
    private string editTemporaryIpApprovalRecipients = string.Empty;
    private string editTemporaryIpApprovalAllowedCountryCodes = string.Empty;
    private bool editTemporaryIpApprovalUseNotFoundResponse;
    private bool editTemporaryIpApprovalAllowSharedIp;
    private bool editLanTrustEnabled;
    private string editLanTrustCidrs = string.Empty;
    private string editLanTrustDnsSuffixes = string.Empty;
    private bool editLanTrustRequireForwardConfirm = true;
    private int? editLanTrustMaxLatencyMilliseconds;
    private bool editSkipAuthenticationForKnownIps;
    private bool isFetchingEditWanIp;
    private string editWanIpMessage = string.Empty;
    private int? editTemporaryIpApprovalIdleTimeoutMinutes;
    private int? editTemporaryIpApprovalMaxLifetimeMinutes;
    private bool editAppAllowLanOnly;
    private bool editAppUsePublicHostHeader;
    private bool editAppStripForwardedFor = true;
    private bool editAppSkipUpstreamTlsVerification;
    private IReadOnlyList<LmsMultiSelectOption> approvalRecipientOptions = [];
    private readonly HashSet<string> collapsedRouteDomains = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<Guid, string> routeTestLabels = [];
    private readonly Dictionary<Guid, LmsStatusTone> routeTestTones = [];

    private static IReadOnlyList<LmsMultiSelectOption> CountryOptions =>
        TemporaryIpApprovalSelectionOptions.CountryOptions;

    private IReadOnlyList<RouteDomainGroup> RouteDomainGroups =>
        status?.Configuration.Applications
            .GroupBy(GetDomainName)
            .OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase)
            .Select(group => new RouteDomainGroup(
                group.Key,
                group.OrderBy(route => route.Name, StringComparer.OrdinalIgnoreCase).ToArray()))
            .ToArray() ?? [];

    protected override async Task OnInitializedAsync()
    {
        status = await StatusService.GetStatusAsync();
        var securityPage = await SecurityService.GetPageAsync();
        approvalRecipientOptions = TemporaryIpApprovalSelectionOptions.BuildUserOptions(securityPage.Users);
    }

    private bool IsRouteDomainExpanded(string domainName) =>
        !collapsedRouteDomains.Contains(domainName);

    private void ToggleRouteDomain(string domainName)
    {
        if (!collapsedRouteDomains.Add(domainName))
        {
            collapsedRouteDomains.Remove(domainName);
        }
    }

    private static string BuildRouteDomainPanelId(string domainName)
    {
        var safeName = new string(domainName
            .Select(character => char.IsLetterOrDigit(character) ? char.ToLowerInvariant(character) : '-')
            .ToArray())
            .Trim('-');

        return $"edge-route-domain-{safeName}";
    }

    private bool IsRouteBusy(Guid routeId, string actionName) =>
        isRouteActionBusy &&
        routeActionRouteId == routeId &&
        routeActionName.Equals(actionName, StringComparison.OrdinalIgnoreCase);

    private string GetRouteTestLabel(Guid routeId) =>
        routeTestLabels.TryGetValue(routeId, out var label) ? label : "Not tested";

    private LmsStatusTone GetRouteTestTone(Guid routeId) =>
        routeTestTones.TryGetValue(routeId, out var tone) ? tone : LmsStatusTone.Neutral;

    private async Task ToggleRouteAsync(Guid routeId, bool isEnabled)
    {
        await RunRouteSaveActionAsync(
            routeId,
            RouteToggleAction,
            () => RelayProvisioningService.SetApplicationEnabledAsync(routeId, !isEnabled));
    }

    private async Task DeleteRouteAsync(Guid routeId)
    {
        await RunRouteSaveActionAsync(
            routeId,
            RouteDeleteAction,
            () => RelayProvisioningService.RemoveApplicationAsync(routeId));
    }

    private async Task TestRouteAsync(Guid routeId)
    {
        if (isRouteActionBusy)
        {
            return;
        }

        BeginRouteAction(routeId, RouteTestAction);
        try
        {
            var result = await RelayProvisioningService.TestApplicationAsync(routeId);
            routeActionMessage = result.Summary;
            routeActionIsError = !result.Success;
            routeActionSteps = result.Checks;
            routeActionWarnings = result.Warnings;
            routeTestLabels[routeId] = result.Success ? "Test passed" : "Test failed";
            routeTestTones[routeId] = result.Success ? LmsStatusTone.Ready : LmsStatusTone.Warning;
        }
        catch (Exception exception)
        {
            routeActionMessage = $"Route test failed: {exception.Message}";
            routeActionIsError = true;
            routeTestLabels[routeId] = "Test failed";
            routeTestTones[routeId] = LmsStatusTone.Warning;
        }
        finally
        {
            EndRouteAction();
        }
    }

    private async Task RunRouteSaveActionAsync(
        Guid routeId,
        string actionName,
        Func<Task<EdgeGatewayApplicationSaveResult>> action)
    {
        if (isRouteActionBusy)
        {
            return;
        }

        BeginRouteAction(routeId, actionName);

        try
        {
            var result = await action();
            routeActionMessage = result.Summary;
            routeActionIsError = !result.Success;
            routeActionSteps = result.Steps;
            routeActionWarnings = result.Warnings;

            if (result.Success)
            {
                status = await StatusService.GetStatusAsync();
            }
        }
        catch (Exception exception)
        {
            routeActionMessage = $"Route action failed: {exception.Message}";
            routeActionIsError = true;
        }
        finally
        {
            EndRouteAction();
        }
    }

    private void BeginRouteAction(Guid routeId, string actionName)
    {
        isRouteActionBusy = true;
        routeActionRouteId = routeId;
        routeActionName = actionName;
        routeActionMessage = string.Empty;
        routeActionSteps = [];
        routeActionWarnings = [];
        routeActionIsError = false;
    }

    private void EndRouteAction()
    {
        isRouteActionBusy = false;
        routeActionName = string.Empty;
    }

    private void OpenAddAppModal(string domainName)
    {
        if (isRouteActionBusy || status is null)
        {
            return;
        }

        var relay = status.Configuration.RelayZones.FirstOrDefault(item =>
            item.DomainName.Equals(domainName, StringComparison.OrdinalIgnoreCase) &&
            !string.IsNullOrWhiteSpace(item.TunnelId) &&
            !string.IsNullOrWhiteSpace(item.DnsTarget) &&
            !string.IsNullOrWhiteSpace(item.WildcardHostname));
        if (relay is null)
        {
            routeActionMessage = $"Setup Relay must complete for {domainName} before adding apps.";
            routeActionSteps = [];
            routeActionWarnings = [];
            routeActionIsError = true;
            return;
        }

        routeActionMessage = string.Empty;
        routeActionSteps = [];
        routeActionWarnings = [];
        routeActionIsError = false;
        addAppRelay = relay;
    }

    private void CloseAddAppModal()
    {
        addAppRelay = null;
    }

    private async Task HandleAddAppSavedAsync(string summary)
    {
        routeActionMessage = summary;
        routeActionSteps = [];
        routeActionWarnings = [];
        routeActionIsError = false;
        status = await StatusService.GetStatusAsync();
    }

    private void OpenEditRouteModal(PublishedApplicationDefinition route)
    {
        if (isRouteActionBusy)
        {
            return;
        }

        editingRoute = route;
        editAppName = route.Name;
        editAppHostLabel = GetHostLabel(route);
        editAppAccessPolicy = IsBlockedAccessPolicy(route.AccessPolicy) ? "MFA/Passkey" : BuildAccessLabel(route);
        editAppTargetPathPrefix = route.TargetPathPrefix;
        editAppAllowKnownIps = route.AllowKnownIps;
        editAppAllowedUsers = route.AllowedUsers;
        editAppAllowedGroups = route.AllowedGroups;
        editAppAllowLanOnly = route.AllowLanOnly;
        editAppNotes = route.Notes;
        editTemporaryIpApprovalRecipients = route.TemporaryIpApprovalRecipients;
        editTemporaryIpApprovalAllowedCountryCodes = route.TemporaryIpApprovalAllowedCountryCodes;
        editTemporaryIpApprovalUseNotFoundResponse = route.TemporaryIpApprovalUseNotFoundResponse;
        editTemporaryIpApprovalAllowSharedIp = route.TemporaryIpApprovalAllowSharedIp;
        editLanTrustEnabled = route.LanTrustEnabled;
        editLanTrustCidrs = route.LanTrustCidrs;
        editLanTrustDnsSuffixes = route.LanTrustDnsSuffixes;
        editLanTrustRequireForwardConfirm = route.LanTrustRequireForwardConfirm;
        editLanTrustMaxLatencyMilliseconds = route.LanTrustMaxLatencyMilliseconds;
        editSkipAuthenticationForKnownIps = route.SkipAuthenticationForKnownIps;
        editWanIpMessage = string.Empty;
        isFetchingEditWanIp = false;
        editTemporaryIpApprovalIdleTimeoutMinutes = route.TemporaryIpApprovalIdleTimeoutMinutes;
        editTemporaryIpApprovalMaxLifetimeMinutes = route.TemporaryIpApprovalMaxLifetimeMinutes;
        editAppUsePublicHostHeader = ShouldUsePublicHostHeaderInEditor(route);
        editAppStripForwardedFor = route.StripForwardedFor ?? true;
        editAppSkipUpstreamTlsVerification = route.SkipUpstreamTlsVerification ?? IsHttpsUrl(route.UpstreamUrl);
        routeActionMessage = string.Empty;
        routeActionIsError = false;

        if (Uri.TryCreate(route.UpstreamUrl, UriKind.Absolute, out var uri))
        {
            editAppTargetScheme = uri.Scheme;
            editAppTargetHost = uri.Host;
            editAppTargetPort = uri.Port;
        }
        else
        {
            editAppTargetScheme = "http";
            editAppTargetHost = route.UpstreamUrl;
            editAppTargetPort = 80;
        }
    }

    private void CloseEditRouteModal()
    {
        if (isSavingRouteEdit)
        {
            return;
        }

        editingRoute = null;
        editWanIpMessage = string.Empty;
        isFetchingEditWanIp = false;
    }

    private async Task FetchEditKnownWanIpAsync()
    {
        if (isFetchingEditWanIp)
        {
            return;
        }

        isFetchingEditWanIp = true;
        editWanIpMessage = string.Empty;
        try
        {
            var wanIps = await LookupCurrentWanIpsAsync();
            foreach (var wanIp in wanIps)
            {
                editAppAllowKnownIps = MergeKnownSourceIp(editAppAllowKnownIps, wanIp);
            }

            editWanIpMessage = $"Added {string.Join(", ", wanIps)}.";
        }
        catch (Exception ex)
        {
            editWanIpMessage = $"Could not look up WAN IP: {ex.Message}";
        }
        finally
        {
            isFetchingEditWanIp = false;
        }
    }

    private async Task<IReadOnlyList<string>> LookupCurrentWanIpsAsync()
    {
        var client = HttpClientFactory.CreateClient();
        client.Timeout = TimeSpan.FromSeconds(8);
        return await PublicWanAddressLookup.LookupAsync(client);
    }

    private static string MergeKnownSourceIp(string existing, string ip)
    {
        var parts = existing
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(part => !string.IsNullOrWhiteSpace(part))
            .ToList();
        var canonical = EdgeGatewayIpAddress.CanonicalizeString(ip);
        if (parts.Any(part =>
                string.Equals(EdgeGatewayIpAddress.CanonicalizeString(part), canonical, StringComparison.OrdinalIgnoreCase)))
        {
            return string.Join(", ", parts);
        }

        parts.Add(canonical);
        return string.Join(", ", parts);
    }

    private void UseInternalHomeAssistantTarget(string scheme)
    {
        editAppTargetScheme = scheme.Equals(Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase)
            ? Uri.UriSchemeHttps
            : Uri.UriSchemeHttp;
        editAppTargetHost = "homeassistant";
        editAppTargetPort = 8123;
        editAppUsePublicHostHeader = true;
        editAppStripForwardedFor = true;
        editAppSkipUpstreamTlsVerification = editAppTargetScheme.Equals(Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase);
    }

    private async Task SaveRouteEditAsync()
    {
        if (editingRoute is null || isSavingRouteEdit)
        {
            return;
        }

        isSavingRouteEdit = true;
        BeginRouteAction(editingRoute.Id, RouteEditAction);
        try
        {
            var result = await RelayProvisioningService.UpdateApplicationAsync(
                editingRoute.Id,
                editAppName,
                editAppHostLabel,
                editAppTargetScheme,
                editAppTargetHost,
                editAppTargetPort,
                editAppAccessPolicy,
                targetPathPrefix: editAppTargetPathPrefix,
                allowKnownIps: editAppAllowKnownIps,
                allowedUsers: editAppAllowedUsers,
                allowedGroups: editAppAllowedGroups,
                allowLanOnly: editAppAllowLanOnly,
                notes: editAppNotes,
                usePublicHostHeader: editAppUsePublicHostHeader,
                stripForwardedFor: editAppStripForwardedFor,
                skipUpstreamTlsVerification: editAppSkipUpstreamTlsVerification,
                temporaryIpApprovalRecipients: editTemporaryIpApprovalRecipients,
                temporaryIpApprovalAllowedCountryCodes: editTemporaryIpApprovalAllowedCountryCodes,
                temporaryIpApprovalUseNotFoundResponse: editTemporaryIpApprovalUseNotFoundResponse,
                temporaryIpApprovalIdleTimeoutMinutes: editTemporaryIpApprovalIdleTimeoutMinutes,
                temporaryIpApprovalMaxLifetimeMinutes: editTemporaryIpApprovalMaxLifetimeMinutes,
                temporaryIpApprovalAllowSharedIp: editTemporaryIpApprovalAllowSharedIp,
                lanTrustEnabled: editLanTrustEnabled,
                lanTrustCidrs: editLanTrustCidrs,
                lanTrustDnsSuffixes: editLanTrustDnsSuffixes,
                lanTrustRequireForwardConfirm: editLanTrustRequireForwardConfirm,
                lanTrustMaxLatencyMilliseconds: editLanTrustMaxLatencyMilliseconds,
                skipAuthenticationForKnownIps: editSkipAuthenticationForKnownIps);
            routeActionMessage = result.Summary;
            routeActionIsError = !result.Success;
            routeActionSteps = result.Steps;
            routeActionWarnings = result.Warnings;

            if (result.Success)
            {
                status = await StatusService.GetStatusAsync();
                editingRoute = null;
            }
        }
        catch (Exception exception)
        {
            routeActionMessage = $"Could not save the app: {exception.Message}";
            routeActionIsError = true;
        }
        finally
        {
            isSavingRouteEdit = false;
            EndRouteAction();
        }
    }

    private static string BuildAccessLabel(PublishedApplicationDefinition route) =>
        string.IsNullOrWhiteSpace(route.AccessPolicy)
            ? "MFA/Passkey"
            : route.AccessPolicy;

    private static LmsStatusTone GetAccessTone(PublishedApplicationDefinition route) =>
        IsBlockedAccessPolicy(route.AccessPolicy)
            ? LmsStatusTone.Critical
            : IsPassThroughAccessPolicy(route.AccessPolicy)
            ? LmsStatusTone.Warning
            : IsTemporaryIpApprovalAccessPolicy(route.AccessPolicy)
            ? LmsStatusTone.Ready
            : LmsStatusTone.Ready;

    private const string PassThroughWarningText =
        "Internet traffic for this hostname is passed straight to the destination service. LMS MFA and passkeys are not required on this route, so use pass-through only when the destination is public by design or has the authentication and authorization you require.";

    private const string TemporaryIpApprovalWarningText =
        "The first request is denied and an approval email is sent. Approval only allows this app from the exact source IP for the requesting client by default, then expires on the configured idle cut-off or maximum lifetime. Optionally allow every client on that IP for trusted home/LAN networks. Repeated emails for the same app/client are throttled.";

    private static bool IsBlockedAccessPolicy(string? accessPolicy) =>
        EdgeGatewayAccessPolicies.IsBlocked(accessPolicy);

    private static bool IsPassThroughAccessPolicy(string? accessPolicy)
        => EdgeGatewayAccessPolicies.IsPassThrough(accessPolicy);

    private static bool IsTemporaryIpApprovalAccessPolicy(string? accessPolicy)
        => EdgeGatewayAccessPolicies.IsTemporaryIpApproval(accessPolicy);

    private static bool IsMfaOrTemporaryIpAccessPolicy(string? accessPolicy) =>
        !IsPassThroughAccessPolicy(accessPolicy) &&
        !IsBlockedAccessPolicy(accessPolicy);

    private static string BuildTemporaryIpApprovalSummary(PublishedApplicationDefinition route)
    {
        var recipients = string.IsNullOrWhiteSpace(route.TemporaryIpApprovalRecipients)
            ? "Recipients: route allowed users or enabled LMS users."
            : $"Recipients: {route.TemporaryIpApprovalRecipients}.";
        var countries = string.IsNullOrWhiteSpace(route.TemporaryIpApprovalAllowedCountryCodes)
            ? "Countries: any."
            : $"Countries: {route.TemporaryIpApprovalAllowedCountryCodes}.";
        var response = route.TemporaryIpApprovalUseNotFoundResponse
            ? "Denied response: 404."
            : "Denied response: access check page.";
        var sharedIp = route.TemporaryIpApprovalAllowSharedIp
            ? "Scope: all clients on this IP."
            : "Scope: requesting client only.";
        var idleCutOff = route.TemporaryIpApprovalIdleTimeoutMinutes is null
            ? "Idle cut-off: default."
            : $"Idle cut-off: {route.TemporaryIpApprovalIdleTimeoutMinutes} min.";
        var maxLifetime = route.TemporaryIpApprovalMaxLifetimeMinutes is null
            ? "Maximum expiry: default."
            : $"Maximum expiry: {route.TemporaryIpApprovalMaxLifetimeMinutes} min.";
        return $"{recipients} {countries} {response} {sharedIp} {idleCutOff} {maxLifetime}";
    }

    private static string BuildExternalRouteUrl(PublishedApplicationDefinition route)
    {
        var path = NormalizeRoutePathPrefix(route.TargetPathPrefix);
        var baseUrl = route.PublicHostname.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
                      route.PublicHostname.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            ? route.PublicHostname
            : $"https://{route.PublicHostname}";

        if (!string.IsNullOrWhiteSpace(path))
        {
            return $"{baseUrl.TrimEnd('/')}{path}";
        }

        return baseUrl;
    }

    private static string BuildRelayHost(string domainName) =>
        domainName.Equals("Local routes", StringComparison.OrdinalIgnoreCase)
            ? "local relay"
            : $"{RelayNamespace}.{domainName}";

    private string BuildRouteDomainSummary(string domainName)
    {
        if (domainName.Equals("Local routes", StringComparison.OrdinalIgnoreCase))
        {
            return "Local-only route record.";
        }

        var relay = GetConfiguredRelay(domainName);
        return relay is not null
            ? IsTunnelHealthy(relay.TunnelStatus)
                ? $"Relay ready via {BuildRelayHost(domainName)}."
                : $"Relay configured via {BuildRelayHost(domainName)}; tunnel status is {NormalizeTunnelStatus(relay.TunnelStatus)}."
            : "Setup Relay before adding apps on this domain.";
    }

    private bool IsRelayConfigured(string domainName) =>
        GetConfiguredRelay(domainName) is not null;

    private EdgeGatewayRelayZone? GetConfiguredRelay(string domainName) =>
        status?.Configuration.RelayZones.FirstOrDefault(relay =>
            relay.DomainName.Equals(domainName, StringComparison.OrdinalIgnoreCase) &&
            !string.IsNullOrWhiteSpace(relay.TunnelId) &&
            !string.IsNullOrWhiteSpace(relay.DnsTarget) &&
            !string.IsNullOrWhiteSpace(relay.WildcardHostname));

    private static bool IsTunnelHealthy(string status) =>
        string.Equals(
            NormalizeTunnelStatus(status),
            "healthy",
            StringComparison.OrdinalIgnoreCase);

    private static string NormalizeTunnelStatus(string status) =>
        string.IsNullOrWhiteSpace(status) ? "unknown" : status.Trim().ToLowerInvariant();

    private static string GetDomainName(PublishedApplicationDefinition route)
    {
        var host = route.PublicHostname;
        if (Uri.TryCreate(route.PublicHostname, UriKind.Absolute, out var uri))
        {
            host = uri.Host;
        }
        else
        {
            host = host.Split('/', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? host;
        }

        host = host.Trim().TrimEnd('.');
        if (string.IsNullOrWhiteSpace(host))
        {
            return "Local routes";
        }

        var parts = host.Split('.', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[^2]}.{parts[^1]}"
            : host;
    }

    private static string GetHostLabel(PublishedApplicationDefinition route)
    {
        var host = NormalizeRouteHostname(route.PublicHostname);
        var domainName = GetDomainName(route);
        return host.EndsWith($".{domainName}", StringComparison.OrdinalIgnoreCase)
            ? host[..^($".{domainName}".Length)].Trim('.')
            : host;
    }

    private static string NormalizeRouteHostname(string value)
    {
        if (Uri.TryCreate(value, UriKind.Absolute, out var uri))
        {
            return uri.Host.Trim().TrimEnd('.').ToLowerInvariant();
        }

        return (value ?? string.Empty)
            .Split('/', StringSplitOptions.RemoveEmptyEntries)
            .FirstOrDefault()?
            .Trim()
            .TrimEnd('.')
            .ToLowerInvariant() ?? string.Empty;
    }

    private static string NormalizeRoutePathPrefix(string? value)
    {
        var normalized = (value ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(normalized) || normalized == "/")
        {
            return string.Empty;
        }

        return normalized.StartsWith("/", StringComparison.Ordinal)
            ? normalized.TrimEnd('/')
            : $"/{normalized.TrimEnd('/')}";
    }

    private static bool IsHttpsUrl(string value) =>
        Uri.TryCreate(value, UriKind.Absolute, out var uri) &&
        uri.Scheme.Equals(Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase);

    private static bool IsHomeAssistantRoute(PublishedApplicationDefinition route) =>
        route.Name.Contains("home assistant", StringComparison.OrdinalIgnoreCase) ||
        NormalizeRouteHostname(route.PublicHostname).StartsWith("hassio.", StringComparison.OrdinalIgnoreCase) ||
        NormalizeRouteHostname(route.PublicHostname).StartsWith("homeassistant.", StringComparison.OrdinalIgnoreCase) ||
        NormalizeRouteHostname(route.PublicHostname).StartsWith("home-assistant.", StringComparison.OrdinalIgnoreCase) ||
        (Uri.TryCreate(route.UpstreamUrl, UriKind.Absolute, out var uri) && uri.Port == 8123);

    private bool EditRouteLooksHomeAssistant() =>
        editingRoute is not null &&
        (editAppName.Contains("home assistant", StringComparison.OrdinalIgnoreCase) ||
         NormalizeRouteHostname(editingRoute.PublicHostname).StartsWith("hassio.", StringComparison.OrdinalIgnoreCase) ||
         NormalizeRouteHostname(editingRoute.PublicHostname).StartsWith("homeassistant.", StringComparison.OrdinalIgnoreCase) ||
         NormalizeRouteHostname(editingRoute.PublicHostname).StartsWith("home-assistant.", StringComparison.OrdinalIgnoreCase) ||
         editAppTargetPort == 8123);

    private bool EditHomeAssistantTargetLooksExternal() =>
        EditRouteLooksHomeAssistant() &&
        editAppTargetPort != 8123 &&
        !IsLocalOrPrivateTargetHost(editAppTargetHost);

    private string BuildHomeAssistantTargetRepairTitle() =>
        EditHomeAssistantTargetLooksExternal()
            ? "Home Assistant is targeting another public HTTPS host."
            : "Home Assistant internal target";

    private string BuildHomeAssistantTargetRepairDetail() =>
        EditHomeAssistantTargetLooksExternal()
            ? "Use an internal target to avoid OAuth/proxy loops."
            : "Use HTTP for default HA installs, or HTTPS when this HA instance has SSL enabled on 8123.";

    private static bool ShouldUsePublicHostHeaderInEditor(PublishedApplicationDefinition route)
    {
        if (IsHomeAssistantRoute(route) &&
            Uri.TryCreate(route.UpstreamUrl, UriKind.Absolute, out var upstream) &&
            upstream.Port != 8123 &&
            !IsLocalOrPrivateTargetHost(upstream.Host))
        {
            return false;
        }

        return route.UsePublicHostHeader ?? IsHomeAssistantRoute(route);
    }

    private static bool IsLocalOrPrivateTargetHost(string host)
    {
        var normalized = (host ?? string.Empty).Trim().Trim('[', ']').TrimEnd('.').ToLowerInvariant();
        if (normalized is "homeassistant" or "localhost" or "127.0.0.1" or "::1")
        {
            return true;
        }

        if (normalized.EndsWith(".local", StringComparison.OrdinalIgnoreCase) ||
            normalized.EndsWith(".localdomain", StringComparison.OrdinalIgnoreCase) ||
            normalized.EndsWith(".lan", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (!IPAddress.TryParse(normalized, out var address))
        {
            return false;
        }

        if (IPAddress.IsLoopback(address))
        {
            return true;
        }

        if (address.AddressFamily != System.Net.Sockets.AddressFamily.InterNetwork)
        {
            return false;
        }

        var bytes = address.GetAddressBytes();
        return bytes[0] == 10 ||
               bytes[0] == 192 && bytes[1] == 168 ||
               bytes[0] == 172 && bytes[1] is >= 16 and <= 31;
    }

    private string BuildEditRoutePreview()
    {
        var scheme = string.IsNullOrWhiteSpace(editAppTargetScheme)
            ? "http"
            : editAppTargetScheme.Trim().ToLowerInvariant();
        var host = string.IsNullOrWhiteSpace(editAppTargetHost)
            ? "homeassistant"
            : editAppTargetHost.Trim();
        var port = Math.Clamp(editAppTargetPort, 1, 65535);
        var path = NormalizeRoutePathPrefix(editAppTargetPathPrefix);
        var hostname = editingRoute?.PublicHostname ?? "app.example.com";
        var externalUrl = string.IsNullOrWhiteSpace(path)
            ? hostname
            : $"{hostname}{path}";
        return $"{externalUrl} -> {scheme}://{host}:{port}";
    }

    private sealed record RouteDomainGroup(string DomainName, IReadOnlyList<PublishedApplicationDefinition> Routes)
    {
        public int EnabledCount => Routes.Count(route => route.IsEnabled);
    }
}
