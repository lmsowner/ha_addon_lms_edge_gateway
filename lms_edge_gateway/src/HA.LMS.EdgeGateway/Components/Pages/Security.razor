    private static string BuildMessagingResultMessage(SecurityMessagingTestResult result)
    {
        var status = result.StatusCode.HasValue ? $" HTTP {result.StatusCode}." : string.Empty;
        var provider = string.IsNullOrWhiteSpace(result.Provider) ? string.Empty : $" Provider: {result.Provider}.";
        var messageId = string.IsNullOrWhiteSpace(result.ProviderMessageId)
            ? string.Empty
            : $" Message id: {result.ProviderMessageId}.";
        return $"{result.Message}{status}{provider}{messageId}";
    }

