    private async Task AddAppAsync()
    {
        if (addAppRelay is null)
        {
            return;
        }

        isAddingApp = true;
        relaySetupError = null;
        relaySetupMessage = null;
        relaySetupSteps = [];
        relaySetupWarnings = [];

        try
        {
            var result = await RelayProvisioningService.AddApplicationAsync(
                addAppRelay.DomainName,
                addAppName,
                addAppHostLabel,
                addAppTargetScheme,
                addAppTargetHost,
                addAppTargetPort,
                addAppAccessPolicy,
                targetPathPrefix: addAppTargetPathPrefix,
                isEnabled: addAppEnabled,
                allowKnownIps: addAppAllowKnownIps,
                allowedUsers: addAppAllowedUsers,
                allowedGroups: addAppAllowedGroups,
                allowLanOnly: addAppAllowLanOnly,
                notes: addAppNotes,
                usePublicHostHeader: addAppUsePublicHostHeader,
                stripForwardedFor: addAppStripForwardedFor,
                skipUpstreamTlsVerification: addAppSkipUpstreamTlsVerification);
            relaySetupSteps = result.Steps;
            relaySetupWarnings = result.Warnings;
            if (!result.Success)
            {
                status = await StatusService.GetStatusAsync();
                relaySetupError = result.Summary;
                return;
            }

            status = await StatusService.GetStatusAsync();
            relaySetupMessage = result.Summary;
            addAppRelay = null;
        }
        catch (Exception exception)
        {
            relaySetupError = $"Could not add the app: {exception.Message}";
        }
        finally
        {
            isAddingApp = false;
        }
