    private async Task RepairRelayAsync(string domainName)
    {
        if (isRelayActionBusy)
        {
            return;
        }

        repairingRelayDomainName = domainName;
        relaySetupError = null;
        relaySetupMessage = null;
        relaySetupRequiresDnsReplacement = false;
        relaySetupSteps = [];
        relaySetupWarnings = [];

        try
        {
            var result = await RelayProvisioningService.RepairRelayAsync(domainName);
            relaySetupSteps = result.Steps;
            relaySetupWarnings = result.Warnings;
            status = await StatusService.GetStatusAsync();

            if (!result.Success)
            {
                relaySetupError = result.Summary;
                return;
            }

            relaySetupMessage = result.Summary;
        }
        catch (Exception exception)
        {
            relaySetupError = $"Could not repair the relay: {exception.Message}";
        }
        finally
        {
            repairingRelayDomainName = string.Empty;
        }
    }

    private async Task DeleteRelayAsync(string domainName)
    {
        if (isRelayActionBusy)
        {
            return;
        }

        deletingRelayDomainName = domainName;
        relaySetupError = null;
        relaySetupMessage = null;
        relaySetupRequiresDnsReplacement = false;
        relaySetupSteps = [];
        relaySetupWarnings = [];

        try
        {
            var result = await RelayProvisioningService.RemoveRelayAsync(domainName);
            relaySetupSteps = result.Steps;
