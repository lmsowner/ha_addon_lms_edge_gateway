@page "/cloudflare"
@rendermode InteractiveServer
@inject IEdgeGatewayStatusService StatusService
@inject ICloudflareApiTokenStore ApiTokenStore
@inject ICloudflareZoneService ZoneService
@inject IEdgeGatewayRelayProvisioningService RelayProvisioningService
@inject NavigationManager Navigation

<PageTitle>Setup | Linux Made Sane - Edge Gateway</PageTitle>

<div class="page-shell edge-gateway-page">
    <section class="edge-card edge-setup-section edge-cloudflare-token-card">
        <div class="table-header">
            <div>
                <p class="eyebrow">Cloudflare token</p>
                <h2>Connect Cloudflare to Edge Gateway</h2>
                <p class="meta-text">Validate a scoped token here before setup. You'll need a Cloudflare account, a domain managed by Cloudflare DNS, and permission for Edge Gateway to create tunnels, Access apps, and DNS records.</p>
            </div>
            <div class="edge-token-header-actions">
                <LmsStatusPill Text="@(tokenState?.HasToken == true ? "Token saved" : "Token needed")" Tone="@(tokenState?.HasToken == true ? LmsStatusTone.Ready : LmsStatusTone.Warning)" />
                <LmsButton Label="Setup Guide" Icon="info" OnClick="OpenTokenGuide" />
            </div>
        </div>

        @if (tokenState?.HasToken == true)
        {
            <div class="edge-token-ready">
                <div>
                    <strong>Cloudflare is connected.</strong>
                    <span>Use the domain section below to set up this LMS host's relay namespace and prepare Caddy/cloudflared automatically.</span>
                </div>
            </div>

            <div class="edge-token-reset-panel">
                <div>
                    <strong>Reset Cloudflare settings</strong>
                    <span>Clears the saved Cloudflare token and setup state for this add-on.</span>
                </div>
                <form class="edge-token-reset-form" method="post" action="api/setup/reset-cloudflare-token">
                    <button class="lms-button lms-button-danger" type="submit">
                        <span class="lms-button-icon" aria-hidden="true">
                            <svg class="ui-glyph-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 7h16" />
                                <path d="M9.5 3.5h5l1 2.5h4" />
                                <path d="M7 7.5 8 19a2 2 0 0 0 2 1.8h4a2 2 0 0 0 2-1.8l1-11.5" />
                                <path d="M10 11v5" />
                                <path d="M14 11v5" />
                            </svg>
                        </span>
                        <span>Reset settings</span>
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="edge-cloudflare-intro">
                <strong>What Edge Gateway manages</strong>
                <span>Setup Relay prepares the Cloudflare Tunnel, wildcard DNS and local Caddy/cloudflared routes for this Home Assistant add-on host.</span>
            </div>

            <form class="edge-token-grid" method="post" action="api/setup/cloudflare-api-token">
                <label class="ui-field">
                    <span class="ui-field-label">Paste Cloudflare token</span>
                    <input name="cloudflare_api_token" type="password" autocomplete="off" placeholder="Paste Cloudflare token" required />
                </label>
                <button class="lms-button lms-button-primary" type="submit">
                    <span class="lms-button-icon" aria-hidden="true">
                        <svg class="ui-glyph-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 4.5h11l3 3V19a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 5 19Z" />
                            <path d="M8 4.5v5h7v-5" />
                            <path d="M8.5 15.5h7" />
                        </svg>
                    </span>
                    <span>Validate and Save token</span>
                </button>
            </form>
        }
    </section>

    <section class="edge-card edge-setup-section edge-local-relays-card">
        <div class="table-header">
            <div>
                <p class="eyebrow">Configured zones</p>
                <h2>Configured relay zones</h2>
                <p class="meta-text">Shows every relay wildcard LMS can see for this add-on host. Domains without Cloudflare tunnel and DNS details still need Setup Relay.</p>
            </div>
                <LmsStatusPill Text="@BuildConfiguredRelayCountLabel()" Tone="@(ConfiguredRelayZones.Any(IsRelayReady) ? LmsStatusTone.Ready : LmsStatusTone.Neutral)" />
        </div>

        @if (zonesResult is null)
        {
            <div class="edge-loading-card" aria-busy="true">
                <span class="edge-loading-progress">
                    <span class="edge-loading-progress-fill"></span>
                </span>
                <p class="meta-text">Loading saved relay zones.</p>
            </div>
        }
        else if (ConfiguredRelayZones.Count == 0)
        {
            <p class="meta-text">No relay wildcard is currently configured for these Cloudflare zones.</p>
        }
        else
        {
            <div class="edge-local-relay-list">
                @foreach (var relay in ConfiguredRelayZones)
                {
                    var relayRoutes = GetRoutesForDomain(relay.DomainName);
                    <div class="edge-local-relay-row">
                        <div class="edge-local-relay-main">
                            <strong>@relay.DomainName</strong>
                            <span><code>@relay.RelayHostname</code></span>
                            <LmsStatusPill Text="@BuildRelayProvisioningLabel(relay)" Tone="@GetRelayProvisioningTone(relay)" />
                            <LmsButton Label="Add"
                                       Icon="plus"
                                       Primary="true"
                                       Disabled="@(!HasRelayProvisioningData(relay) || isRelayActionBusy)"
                                       OnClick="@(() => OpenAddAppModal(relay))" />
                        </div>
                        <div class="edge-local-relay-meta">
                            <span>Local relay</span>
                            @if (HasRelayProvisioningData(relay))
                            {
                                <span><code>@relay.WildcardHostname</code> -> <code>@relay.DnsTarget</code></span>
                                <span>@BuildRelayHealthDetail(relay)</span>
                            }
                            else
                            {
                                <span>Cloudflare is not provisioned yet. Run Setup Relay for this domain.</span>
                            }
                            <span>@relayRoutes.Count app@(relayRoutes.Count == 1 ? string.Empty : "s")</span>
                            @if (relayRoutes.Count > 0)
                            {
                                <div class="edge-local-relay-routes">
                                    @foreach (var route in relayRoutes.Take(3))
                                    {
                                        <span><strong>@route.Name</strong> <code>@BuildExternalRouteUrl(route)</code></span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span>No published app routes on this zone yet.</span>
                            }
                        </div>
                        <div class="edge-local-relay-actions">
                            @if (HasRelayProvisioningData(relay) && !IsRelayReady(relay))
                            {
                                <LmsButton Label="@(IsRepairingRelay(relay.DomainName) ? "Repairing..." : "Repair")"
                                           Icon="refresh"
                                           Primary="true"
                                           Disabled="@isRelayActionBusy"
                                           OnClick="@(() => RepairRelayAsync(relay.DomainName))" />
                            }
                            <LmsButton Label="@(IsDeletingRelay(relay.DomainName) ? "Deleting..." : "Delete")"
                                       Icon="delete"
                                       Danger="true"
                                       Disabled="@isRelayActionBusy"
                                       OnClick="@(() => DeleteRelayAsync(relay.DomainName))" />
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <details class="edge-setup-section edge-relay-settings locked">
        <summary class="edge-relay-settings-summary">
            <div>
                <span class="eyebrow">Relay namespace</span>
                <strong>@RelayNamespace</strong>
                <span class="meta-text">Example: <code>*.@BuildRelayHostname("example.com")</code></span>
            </div>
            <span class="edge-relay-summary-actions">
                <LmsStatusPill Text="Locked" Tone="LmsStatusTone.Ready" />
                <span class="edge-relay-toggle-text edge-relay-toggle-expand">Expand</span>
                <span class="edge-relay-toggle-text edge-relay-toggle-collapse">Collapse</span>
            </span>
        </summary>

        <div class="edge-relay-settings-body">
            <p class="callout warning edge-relay-warning">
                The relay namespace must be unique across your LMS landscape. Do not change it after apps are published unless you intentionally want to break those external app URLs and then republish the affected relay/routes.
            </p>
            <div class="edge-relay-settings-form-line">
                <label class="ui-field">
                    <span class="ui-field-label">Relay namespace</span>
                    <input value="@RelayNamespace" readonly />
                    <span class="ui-field-helper">Locked until namespace editing is wired for the add-on host.</span>
                </label>
                <div class="edge-readonly-field">
                    <span class="ui-field-label">Example</span>
                    <strong>*.@BuildRelayHostname("example.com")</strong>
                    <span>Cloudflare wildcard DNS and tunnel ingress use this namespace.</span>
                </div>
            </div>
        </div>
    </details>

    <section class="edge-card edge-setup-section edge-new-app-card">
        <div class="table-header">
            <div>
                <p class="eyebrow">Setup Relay</p>
                <h2>Setup Relay</h2>
                <p class="meta-text">Cloudflare domains loaded from the saved Edge Gateway token.</p>
            </div>
        </div>

        @if (zonesResult is null)
        {
            <div class="edge-loading-card" aria-busy="true">
                <span class="edge-loading-progress">
                    <span class="edge-loading-progress-fill"></span>
                </span>
                <p class="meta-text">Loading Cloudflare domains from the saved Edge Gateway token.</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(zonesResult.Error))
        {
            <p class="meta-text">Cloudflare domains are not available until the saved token can list zones.</p>
        }
        else if (CloudflareZones.Count == 0)
        {
            <p class="meta-text">No Cloudflare zones are available from the saved token.</p>
        }
        else if (RelaySetupCloudflareDomains.Count == 0)
        {
            <p class="meta-text">Every available Cloudflare zone already has this LMS relay namespace configured. Use Configured zones above to add services or delete a relay before setting it up again.</p>
        }
        else
        {
            <div class="edge-domain-picker-grid">
                <label class="ui-field">
                    <span class="ui-field-label">Cloudflare domain</span>
                    <select @bind="SelectedRelayDomainName">
                        <option value="">Select a Cloudflare domain</option>
                        @foreach (var domain in RelaySetupCloudflareDomains)
                        {
                            <option value="@domain.Name">@domain.Name (*.@BuildRelayHostname(domain.Name))</option>
                        }
                    </select>
                    <span class="ui-field-helper">Only domains that still need this LMS relay namespace are listed.</span>
                </label>
                <div class="edge-domain-actions">
                    <LmsButton Label="@(isSettingUpRelay ? "Setting up..." : "Setup Relay")"
                               Icon="publish"
                               Primary="true"
                               Disabled="@isRelayActionBusy"
                               OnClick="SetupRelayAsync" />
                </div>
            </div>

            @if (SelectedRelayDomain is not null)
            {
                <p class="edge-domain-relay-preview">
                    Setup Relay will create <code>@BuildRelayHostname(SelectedRelayDomain.Name)</code> with wildcard <code>*.@BuildRelayHostname(SelectedRelayDomain.Name)</code>.
                </p>
            }
            else
            {
                <p class="edge-domain-relay-preview">
                    Select a Cloudflare domain to preview the relay hostname and wildcard.
                </p>
            }
        }

        @if (!string.IsNullOrWhiteSpace(relaySetupMessage))
        {
            <p class="callout ready">@relaySetupMessage</p>
        }

        @if (!string.IsNullOrWhiteSpace(relaySetupError))
        {
            <p class="callout warning">@relaySetupError</p>
        }

        @if (relaySetupRequiresDnsReplacement)
        {
            <div class="callout warning edge-provision-confirm">
                <span>Replacing the existing wildcard DNS record will point <code>*.@BuildRelayHostname(SelectedRelayDomainName)</code> at this Edge Gateway tunnel.</span>
                <LmsButton Label="Replace wildcard DNS"
                           Icon="publish"
                           Danger="true"
                           Disabled="@isRelayActionBusy"
                           OnClick="ReplaceRelayDnsAsync" />
            </div>
        }

        @if (relaySetupSteps.Count > 0)
        {
            <div class="edge-provision-log">
                <strong>Setup steps</strong>
                <ul class="plain-list">
                    @foreach (var step in relaySetupSteps)
                    {
                        <li>@step</li>
                    }
                </ul>
            </div>
        }

        @if (relaySetupWarnings.Count > 0)
        {
            <div class="edge-provision-log warning">
                <strong>Warnings</strong>
                <ul class="plain-list">
                    @foreach (var warning in relaySetupWarnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        }
    </section>

    @if (isTokenGuideOpen)
    {
        <div class="edge-modal-backdrop" role="presentation">
            <section class="edge-modal-panel edge-token-guide-modal"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="cloudflare-token-guide-title"
                     @onclick:stopPropagation="true">
                <header class="edge-modal-header">
                    <div>
                        <p class="eyebrow">Setup Guide</p>
                        <h2 id="cloudflare-token-guide-title">Get a Cloudflare API token</h2>
                        <p class="meta-text">Create a scoped custom token in Cloudflare with the account and zone permissions shown below. Edge Gateway uses it to manage tunnels, Access apps, and DNS for the Cloudflare domain you choose.</p>
                    </div>
                    <button class="edge-modal-close" type="button" aria-label="Close setup guide" @onclick="CloseTokenGuide">x</button>
                </header>

                <div class="edge-modal-body">
                    <div class="permission-panel">
                        <img class="permission-screenshot"
                             src="images/cloudflare-api-token-permissions.png"
                             alt="Cloudflare token permissions: Account Cloudflare Tunnel Edit, Account Access Apps and Policies Edit, Zone DNS Edit." />
                    </div>

                    <div class="edge-token-guide-grid">
                        <section>
                            <h3>Create the token</h3>
                            <ol class="numbered-list">
                                <li>Open <strong>My Profile</strong>, then <strong>API Tokens</strong>.</li>
                                <li>Create a custom token.</li>
                                <li>Add the three permission rows shown in the screenshot.</li>
                                <li>Scope the token to the Cloudflare account and zone this Edge Gateway should manage.</li>
                                <li>Copy the generated token and paste it into the Cloudflare token field.</li>
                            </ol>
                        </section>

                        <section>
                            <h3>Required permission rows</h3>
                            <ul class="plain-list">
                                <li><code>Account</code> / <code>Cloudflare Tunnel</code> / <code>Edit</code></li>
                                <li><code>Account</code> / <code>Access: Apps and Policies</code> / <code>Edit</code></li>
                                <li><code>Zone</code> / <code>DNS</code> / <code>Edit</code></li>
                            </ul>
                        </section>
                    </div>
                </div>

                <footer class="edge-modal-footer">
                    <a class="lms-button lms-button-primary" href="https://dash.cloudflare.com/profile/api-tokens" target="_blank" rel="noreferrer">Open Cloudflare API Tokens</a>
                    <button class="lms-button" type="button" @onclick="CloseTokenGuide">Close</button>
                </footer>
            </section>
        </div>
    }

    @if (addAppRelay is not null)
    {
        <RouteAddModal Relay="addAppRelay"
                       OnClose="CloseAddAppModal"
                       OnSaved="HandleAddAppSavedAsync" />
    }
</div>

@code {
    private EdgeGatewayRuntimeStatus? status;
    private CloudflareApiTokenState? tokenState;
    private CloudflareZoneListResult? zonesResult;
    private bool isTokenGuideOpen;
    private bool isSettingUpRelay;
    private bool isRefreshingRelayHealth;
    private EdgeGatewayRelayZone? addAppRelay;
    private string deletingRelayDomainName = string.Empty;
    private string repairingRelayDomainName = string.Empty;
    private string selectedRelayDomainName = string.Empty;
    private string? relaySetupMessage;
    private string? relaySetupError;
    private bool relaySetupRequiresDnsReplacement;
    private IReadOnlyList<string> relaySetupSteps = [];
    private IReadOnlyList<string> relaySetupWarnings = [];
    private const string RelayNamespace = "ha-app-relay";
    private bool isRelayActionBusy => isSettingUpRelay ||
        isRefreshingRelayHealth ||
        !string.IsNullOrWhiteSpace(deletingRelayDomainName) ||
        !string.IsNullOrWhiteSpace(repairingRelayDomainName);

    private IReadOnlyList<CloudflareZoneSummary> CloudflareZones => zonesResult?.Zones ?? [];

    private IReadOnlyList<EdgeGatewayRelayZone> ConfiguredRelayZones =>
        status?.Configuration.RelayZones
            .OrderBy(relay => relay.DomainName, StringComparer.OrdinalIgnoreCase)
            .ToArray() ?? [];

    private IReadOnlyList<CloudflareZoneSummary> RelaySetupCloudflareDomains =>
        CloudflareZones
            .Where(domain => !ConfiguredRelayZones.Any(configured =>
                configured.DomainName.Equals(domain.Name, StringComparison.OrdinalIgnoreCase) &&
                HasRelayProvisioningData(configured)))
            .OrderBy(domain => domain.Name, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private string SelectedRelayDomainName
    {
        get => selectedRelayDomainName;
        set
        {
            selectedRelayDomainName = value;
            relaySetupMessage = null;
            relaySetupError = null;
            relaySetupRequiresDnsReplacement = false;
            relaySetupSteps = [];
            relaySetupWarnings = [];
        }
    }

    private CloudflareZoneSummary? SelectedRelayDomain =>
        RelaySetupCloudflareDomains.FirstOrDefault(domain =>
            domain.Name.Equals(SelectedRelayDomainName, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        tokenState = await ApiTokenStore.GetStateAsync();
        status = await StatusService.GetStatusAsync();
        zonesResult = await ZoneService.ListZonesAsync();
        await RefreshConfiguredRelayHealthAsync();
        ClearSelectedRelayDomain();
        OpenAddAppModalFromQuery();
    }

    private void OpenTokenGuide()
    {
        isTokenGuideOpen = true;
    }

    private void CloseTokenGuide()
    {
        isTokenGuideOpen = false;
    }

    private async Task RefreshConfiguredRelayHealthAsync()
    {
        if (tokenState?.HasToken != true || status is null)
        {
            return;
        }

        var relays = status.Configuration.RelayZones
            .Where(HasRelayProvisioningData)
            .ToArray();
        if (relays.Length == 0)
        {
            return;
        }

        isRefreshingRelayHealth = true;
        try
        {
            foreach (var relay in relays)
            {
                await RelayProvisioningService.ValidateRelayAsync(relay.DomainName);
            }

            status = await StatusService.GetStatusAsync();
        }
        finally
        {
            isRefreshingRelayHealth = false;
        }
    }

    private string BuildConfiguredRelayCountLabel() =>
        ConfiguredRelayZones.Count(HasRelayProvisioningData) == 0
            ? "None"
            : ConfiguredRelayZones.Count(HasRelayProvisioningData) == 1 ? "1 zone" : $"{ConfiguredRelayZones.Count(HasRelayProvisioningData)} zones";

    private static bool HasRelayProvisioningData(EdgeGatewayRelayZone relay) =>
        !string.IsNullOrWhiteSpace(relay.TunnelId) &&
        !string.IsNullOrWhiteSpace(relay.DnsTarget) &&
        !string.IsNullOrWhiteSpace(relay.WildcardHostname);

    private static bool IsRelayReady(EdgeGatewayRelayZone relay) =>
        HasRelayProvisioningData(relay) &&
        NormalizeTunnelStatus(relay.TunnelStatus).Equals("healthy", StringComparison.OrdinalIgnoreCase);

    private static string BuildRelayProvisioningLabel(EdgeGatewayRelayZone relay) =>
        IsRelayReady(relay)
            ? "Tunnel healthy"
            : HasRelayProvisioningData(relay)
                ? $"Tunnel {NormalizeTunnelStatus(relay.TunnelStatus)}"
                : "Not provisioned";

    private static LmsStatusTone GetRelayProvisioningTone(EdgeGatewayRelayZone relay) =>
        IsRelayReady(relay)
            ? LmsStatusTone.Ready
            : HasRelayProvisioningData(relay)
                ? LmsStatusTone.Critical
                : LmsStatusTone.Warning;

    private static string BuildRelayHealthDetail(EdgeGatewayRelayZone relay)
    {
        var status = NormalizeTunnelStatus(relay.TunnelStatus);
        if (status.Equals("healthy", StringComparison.OrdinalIgnoreCase))
        {
            return relay.LastValidatedAtUtc is null
                ? "Cloudflare reports this tunnel as healthy."
                : $"Cloudflare reports this tunnel as healthy. Checked {relay.LastValidatedAtUtc.Value.ToLocalTime():g}.";
        }

        var detail = string.IsNullOrWhiteSpace(relay.LastValidationError)
            ? $"Cloudflare reports this tunnel as {status}. Caddy routes can still be saved; external access waits for the connector."
            : relay.LastValidationError;
        return relay.LastValidatedAtUtc is null
            ? detail
            : $"{detail} Checked {relay.LastValidatedAtUtc.Value.ToLocalTime():g}.";
    }

    private static string NormalizeTunnelStatus(string status) =>
        string.IsNullOrWhiteSpace(status)
            ? "unknown"
            : status.Trim().ToLowerInvariant();

    private async Task SetupRelayAsync()
    {
        await ProvisionRelayAsync(replaceExistingDnsRecord: false);
    }

    private async Task ReplaceRelayDnsAsync()
    {
        await ProvisionRelayAsync(replaceExistingDnsRecord: true);
    }

    private async Task RepairRelayAsync(string domainName)
    {
        if (isRelayActionBusy)
        {
            return;
        }

        repairingRelayDomainName = domainName;
        relaySetupError = null;
        relaySetupMessage = null;
        relaySetupRequiresDnsReplacement = false;
        relaySetupSteps = [];
        relaySetupWarnings = [];

        try
        {
            var result = await RelayProvisioningService.RepairRelayAsync(domainName);
            relaySetupSteps = result.Steps;
            relaySetupWarnings = result.Warnings;
            status = await StatusService.GetStatusAsync();

            if (!result.Success)
            {
                relaySetupError = result.Summary;
                return;
            }

            relaySetupMessage = result.Summary;
        }
        catch (Exception exception)
        {
            relaySetupError = $"Could not repair the relay: {exception.Message}";
        }
        finally
        {
            repairingRelayDomainName = string.Empty;
        }
    }

    private async Task DeleteRelayAsync(string domainName)
    {
        if (isRelayActionBusy)
        {
            return;
        }

        deletingRelayDomainName = domainName;
        relaySetupError = null;
        relaySetupMessage = null;
        relaySetupRequiresDnsReplacement = false;
        relaySetupSteps = [];
        relaySetupWarnings = [];

        try
        {
            var result = await RelayProvisioningService.RemoveRelayAsync(domainName);
            relaySetupSteps = result.Steps;
            relaySetupWarnings = result.Warnings;

            if (!result.Success)
            {
                relaySetupError = result.Summary;
                return;
            }

            status = await StatusService.GetStatusAsync();
            zonesResult = await ZoneService.ListZonesAsync();
            relaySetupMessage = result.Summary;
        }
        catch (Exception exception)
        {
            relaySetupError = $"Could not delete the relay: {exception.Message}";
        }
        finally
        {
            deletingRelayDomainName = string.Empty;
        }
    }

    private void OpenAddAppModal(EdgeGatewayRelayZone relay)
    {
        addAppRelay = relay;
        relaySetupError = null;
        relaySetupMessage = null;
        relaySetupSteps = [];
        relaySetupWarnings = [];
    }

    private void OpenAddAppModalFromQuery()
    {
        var domainName = GetQueryValue("addDomain");
        if (string.IsNullOrWhiteSpace(domainName))
        {
            return;
        }

        var relay = ConfiguredRelayZones.FirstOrDefault(item =>
            item.DomainName.Equals(domainName, StringComparison.OrdinalIgnoreCase));
        if (relay is null)
        {
            relaySetupError = $"No configured relay was found for {domainName}.";
            return;
        }

        OpenAddAppModal(relay);
    }

    private string? GetQueryValue(string name)
    {
        var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query.TrimStart('?');
        if (string.IsNullOrWhiteSpace(query))
        {
            return null;
        }

        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            var key = Uri.UnescapeDataString(parts[0].Replace("+", " "));
            if (!key.Equals(name, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            return parts.Length == 1
                ? string.Empty
                : Uri.UnescapeDataString(parts[1].Replace("+", " "));
        }

        return null;
    }

    private void CloseAddAppModal()
    {
        addAppRelay = null;
    }

    private async Task HandleAddAppSavedAsync(string summary)
    {
        relaySetupError = null;
        relaySetupMessage = summary;
        relaySetupSteps = [];
        relaySetupWarnings = [];
        status = await StatusService.GetStatusAsync();
    }

    private async Task ProvisionRelayAsync(bool replaceExistingDnsRecord)
    {
        var domain = SelectedRelayDomain;
        if (domain is null)
        {
            relaySetupError = "Select a Cloudflare domain before setting up the relay.";
            return;
        }

        isSettingUpRelay = true;
        relaySetupError = null;
        relaySetupMessage = null;
        relaySetupRequiresDnsReplacement = false;
        relaySetupSteps = [];
        relaySetupWarnings = [];

        try
        {
            var result = await RelayProvisioningService.ProvisionRelayAsync(domain.Name, replaceExistingDnsRecord);
            relaySetupSteps = result.Steps;
            relaySetupWarnings = result.Warnings;

            if (result.RequiresDnsReplacement)
            {
                relaySetupRequiresDnsReplacement = true;
                relaySetupError = result.Summary;
                return;
            }

            if (!result.Success)
            {
                status = await StatusService.GetStatusAsync();
                zonesResult = await ZoneService.ListZonesAsync();
                relaySetupError = result.Summary;
                return;
            }

            status = await StatusService.GetStatusAsync();
            relaySetupMessage = result.Summary;
            ClearSelectedRelayDomain();
        }
        catch (Exception exception)
        {
            relaySetupError = $"Could not provision the relay: {exception.Message}";
        }
        finally
        {
            isSettingUpRelay = false;
        }
    }

    private bool IsDeletingRelay(string domainName) =>
        deletingRelayDomainName.Equals(domainName, StringComparison.OrdinalIgnoreCase);

    private bool IsRepairingRelay(string domainName) =>
        repairingRelayDomainName.Equals(domainName, StringComparison.OrdinalIgnoreCase);

    private static string NormalizeRoutePathPrefix(string? value)
    {
        var normalized = (value ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(normalized) || normalized == "/")
        {
            return string.Empty;
        }

        return normalized.StartsWith("/", StringComparison.Ordinal)
            ? normalized.TrimEnd('/')
            : $"/{normalized.TrimEnd('/')}";
    }

    private void ClearSelectedRelayDomain()
    {
        selectedRelayDomainName = string.Empty;
    }

    private IReadOnlyList<PublishedApplicationDefinition> GetRoutesForDomain(string domainName) =>
        status?.Configuration.Applications
            .Where(route => GetDomainName(route).Equals(domainName, StringComparison.OrdinalIgnoreCase))
            .ToArray() ?? [];

    private static string BuildRelayHostname(string domainName) => $"{RelayNamespace}.{domainName}";

    private static string BuildExternalRouteUrl(PublishedApplicationDefinition route)
    {
        var path = NormalizeRoutePathPrefix(route.TargetPathPrefix);
        var baseUrl = route.PublicHostname.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
                      route.PublicHostname.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            ? route.PublicHostname
            : $"https://{route.PublicHostname}";

        if (!string.IsNullOrWhiteSpace(path))
        {
            return $"{baseUrl.TrimEnd('/')}{path}";
        }

        return baseUrl;
    }

    private static string GetDomainName(PublishedApplicationDefinition route)
    {
        var host = route.PublicHostname;
        if (Uri.TryCreate(route.PublicHostname, UriKind.Absolute, out var uri))
        {
            host = uri.Host;
        }
        else
        {
            host = host.Split('/', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? host;
        }

        host = host.Trim().TrimEnd('.');
        var parts = host.Split('.', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[^2]}.{parts[^1]}"
            : host;
    }

}
