@page "/cloudflare"
@rendermode InteractiveServer
@inject IEdgeGatewayStatusService StatusService
@inject ICloudflareZoneService ZoneService

<PageTitle>Cloudflare Setup</PageTitle>

<div class="page-stack">
    <section class="page-header">
        <div>
            <p class="lms-eyebrow">Cloudflare</p>
            <h1>Domains</h1>
            <p>Choose the Cloudflare zone LMS Edge Gateway should use for tunnels, Access applications, and DNS records.</p>
        </div>
        <div class="page-actions">
            <LmsStatusPill Text="Connected" Tone="LmsStatusTone.Ready" />
        </div>
    </section>

    <LmsPanel Kicker="Zones" Title="Cloudflare domains">
        <HeaderContent>
            <LmsButton Label="Refresh" Href="/cloudflare" />
        </HeaderContent>
        <ChildContent>
            @if (zonesResult is null)
            {
                <p class="muted">Loading domains from Cloudflare.</p>
            }
            else if (!string.IsNullOrWhiteSpace(zonesResult.Error))
            {
                <div class="empty-state">
                    <strong>Could not load Cloudflare domains.</strong>
                    <p>@zonesResult.Error</p>
                    <p>If this is a permissions error, add <strong>Zone / Zone / Read</strong> to the API token so Cloudflare allows zone listing.</p>
                </div>
            }
            else if (zonesResult.Zones.Count == 0)
            {
                <div class="empty-state">
                    <strong>No Cloudflare domains found.</strong>
                    <p>Add a domain to Cloudflare or widen the token's zone scope.</p>
                </div>
            }
            else
            {
                <div class="zone-list">
                    @foreach (var zone in zonesResult.Zones)
                    {
                        <article class="zone-card">
                            <div>
                                <h2>@zone.Name</h2>
                                <p>@(string.IsNullOrWhiteSpace(zone.AccountName) ? "Cloudflare account" : zone.AccountName)</p>
                            </div>
                            <div class="zone-meta">
                                <LmsStatusPill Text="@FormatStatus(zone.Status)" Tone="@GetZoneTone(zone.Status)" />
                                <span>@FormatType(zone.Type)</span>
                            </div>
                            <div class="zone-nameservers">
                                @if (zone.NameServers.Count > 0)
                                {
                                    @foreach (var nameServer in zone.NameServers)
                                    {
                                        <code>@nameServer</code>
                                    }
                                }
                                else
                                {
                                    <span class="muted">No nameservers returned.</span>
                                }
                            </div>
                            <div class="zone-actions">
                                <LmsButton Label="Use domain" Href="/applications" Primary="true" />
                            </div>
                        </article>
                    }
                </div>
            }
        </ChildContent>
    </LmsPanel>

    <LmsPanel Kicker="Runtime" Title="Tunnel status">
        @if (cloudflared is null)
        {
            <p class="muted">Checking cloudflared status.</p>
        }
        else
        {
            <div class="status-line">
                <LmsStatusPill Text="@cloudflared.State.ToString()" Tone="@GetTone(cloudflared.State)" />
                <span>@cloudflared.Summary</span>
            </div>
            <p>@cloudflared.Detail</p>
        }
    </LmsPanel>
</div>

@code {
    private EdgeGatewayComponentStatus? cloudflared;
    private CloudflareZoneListResult? zonesResult;

    protected override async Task OnInitializedAsync()
    {
        var status = await StatusService.GetStatusAsync();
        cloudflared = status.Components.SingleOrDefault(item => item.Id == "cloudflared");
        zonesResult = await ZoneService.ListZonesAsync();
    }

    private static LmsStatusTone GetTone(EdgeGatewayComponentState state) => state switch
    {
        EdgeGatewayComponentState.Ready => LmsStatusTone.Ready,
        EdgeGatewayComponentState.Warning or EdgeGatewayComponentState.Starting => LmsStatusTone.Warning,
        EdgeGatewayComponentState.Error => LmsStatusTone.Critical,
        _ => LmsStatusTone.Neutral
    };

    private static LmsStatusTone GetZoneTone(string status) =>
        status.Equals("active", StringComparison.OrdinalIgnoreCase)
            ? LmsStatusTone.Ready
            : LmsStatusTone.Warning;

    private static string FormatStatus(string status) =>
        string.IsNullOrWhiteSpace(status) ? "Unknown" : status;

    private static string FormatType(string type) =>
        string.IsNullOrWhiteSpace(type) ? "Zone" : type;
}
