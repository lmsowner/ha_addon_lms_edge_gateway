        setupApplicationName = string.IsNullOrWhiteSpace(setupApplicationName) ? "Home Assistant" : setupApplicationName;
        setupApplicationUsername = string.IsNullOrWhiteSpace(setupApplicationUsername) ? "homeassistant" : setupApplicationUsername;
        setupAllowTrustedLan = true;
