    private bool IsVisibleMailLogLine(string line)
    {
        if (mailLogFilter == "test")
        {
            return !string.IsNullOrWhiteSpace(testResult?.QueueId) &&
                   line.Contains(testResult.QueueId, StringComparison.OrdinalIgnoreCase);
        }

        if (mailLogFilter == "problems")
        {
            return line.Contains("deferred", StringComparison.OrdinalIgnoreCase) ||
                   line.Contains("timeout", StringComparison.OrdinalIgnoreCase) ||
                   line.Contains("bounced", StringComparison.OrdinalIgnoreCase) ||
                   line.Contains("reject", StringComparison.OrdinalIgnoreCase) ||
                   line.Contains(":25", StringComparison.Ordinal) ||
                   line.Contains("connect to", StringComparison.OrdinalIgnoreCase);
        }

        return true;
    }

