                                        <strong>@check.Label</strong>
                                        <span>@check.Value</span>
                                    </div>
                                    <LmsStatusPill Text="@PreflightStateLabel(check.State)" Tone="@PreflightTone(check.State)" />
                                </header>
                                <p>@check.Detail</p>
                            </article>
                        }
                    </div>
                    <div class="mail-relay-dns-list">
                        @foreach (var change in domainPreview.DnsChanges)
                        {
                            <div class="mail-relay-dns-row">
                                <div>
                                    <strong>@change.Purpose</strong>
                                    <span>@change.RecordType @change.RecordName</span>
                                </div>
                                <code>@change.ProposedValue</code>
                                <LmsStatusPill Text="@change.Kind.ToString()" Tone="@ChangeKindTone(change.Kind)" />
                            </div>
                        }
                    </div>
                }
            </div>
            <footer class="edge-modal-footer">
                <LmsButton Label="Cancel" Icon="close" OnClick="CloseAddDomainModal" />
                <LmsButton Label="@(isPreviewingDomain ? "Reviewing..." : "Review DNS")"
                           Icon="refresh"
                           Busy="@isPreviewingDomain"
                           Disabled="@(isPreviewingDomain || isSavingDomain)"
                           OnClick="PreviewAddDomainAsync" />
                <LmsButton Label="@(isSavingDomain ? "Adding..." : "Add domain")"
                           Icon="check"
                           Primary="true"
                           Busy="@isSavingDomain"
                           Disabled="@(!CanAddDomain)"
                           OnClick="AddDomainAsync" />
            </footer>
        </section>
    </div>
}

