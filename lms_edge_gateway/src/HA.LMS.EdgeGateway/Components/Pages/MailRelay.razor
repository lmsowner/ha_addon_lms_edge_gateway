                            {
                                <p>MX left unchanged: @string.Join(", ", domainPreview.ExistingEmailConfiguration.MxRecords)</p>
                            }
                        </div>
                    }
                    @if (domainPreview.Errors.Count > 0)
                    {
                        <div class="callout warning">
