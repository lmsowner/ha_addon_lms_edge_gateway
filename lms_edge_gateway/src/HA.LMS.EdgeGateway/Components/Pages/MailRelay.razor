    private static string FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;

    private static IReadOnlyList<string> SplitLines(string? value) =>
        (value ?? string.Empty).Split(['\r', '\n', ',', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static string PreflightStateLabel(MailRelayPreflightCheckState state) => state switch
    {
        MailRelayPreflightCheckState.Pass => "Pass",
        MailRelayPreflightCheckState.Warning => "Warning",
        MailRelayPreflightCheckState.Failed => "Failed",
        MailRelayPreflightCheckState.NotAvailable => "Unavailable",
        _ => "Not run"
    };

    private static LmsStatusTone PreflightTone(MailRelayPreflightCheckState state) => state switch
    {
        MailRelayPreflightCheckState.Pass => LmsStatusTone.Ready,
        MailRelayPreflightCheckState.Warning => LmsStatusTone.Warning,
        MailRelayPreflightCheckState.Failed => LmsStatusTone.Critical,
        _ => LmsStatusTone.Neutral
    };

    private static string DnsStatusLabel(MailRelayDnsStatus status) => status switch
    {
        MailRelayDnsStatus.Pass => "pass",
        MailRelayDnsStatus.Warning => "warning",
        MailRelayDnsStatus.Failed => "failed",
        MailRelayDnsStatus.Pending => "pending",
        _ => "unchecked"
    };

    private static LmsStatusTone DnsTone(MailRelayDnsStatus status) => status switch
    {
        MailRelayDnsStatus.Pass => LmsStatusTone.Ready,
        MailRelayDnsStatus.Warning or MailRelayDnsStatus.Pending => LmsStatusTone.Warning,
        MailRelayDnsStatus.Failed => LmsStatusTone.Critical,
        _ => LmsStatusTone.Neutral
    };

    private static LmsStatusTone ChangeKindTone(MailRelaySetupChangeKind kind) => kind switch
    {
        MailRelaySetupChangeKind.Create => LmsStatusTone.Ready,
        MailRelaySetupChangeKind.Update => LmsStatusTone.Warning,
        MailRelaySetupChangeKind.Blocked => LmsStatusTone.Critical,
        _ => LmsStatusTone.Neutral
    };

    private static LmsStatusTone StepTone(MailRelaySetupStepState state) => state switch
    {
        MailRelaySetupStepState.Complete => LmsStatusTone.Ready,
        MailRelaySetupStepState.Running => LmsStatusTone.Warning,
        MailRelaySetupStepState.Failed => LmsStatusTone.Critical,
        _ => LmsStatusTone.Neutral
    };
