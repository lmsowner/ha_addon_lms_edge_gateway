@code {
    private MailRelayDashboardViewModel? dashboard;
    private MailRelaySetupPreview? setupPreview;
    private MailRelayProvisioningJobSnapshot? setupJob;
    private MailRelayTestResult? testResult;
    private MailRelayLogSnapshot? mailLog;
    private bool mailLogExpanded;
    private bool isLoadingMailLog;
    private bool isClearingQueue;
    private string mailLogFilter = "all";
    private CancellationTokenSource? pollCts;

    private string selectedZoneId = string.Empty;
    private string actionMessage = string.Empty;
    private bool actionIsError;
    private bool isRechecking;
    private bool isStartingSetup;
    private bool isSavingClient;
    private bool isSendingTest;
    private bool isCheckingPublicIp;
    private bool isSavingPublicIp;
    private bool isSavingLegacy;
    private bool isRemoving;

    private bool showSetupModal;
    private bool showClientModal;
    private bool showPublicIpModal;
    private bool showLegacyModal;
    private bool showRemovalModal;
    private bool showAddDomainModal;
    private bool showDomainDetailModal;
    private bool showDeleteDomainModal;
    private bool showDeleteClientModal;

    private string setupRelayHostname = string.Empty;
    private string setupSendingDomain = string.Empty;
    private string setupDkimSelector = "lms";
    private string setupApplicationName = "Home Assistant";
    private string setupApplicationUsername = "homeassistant";
    private bool setupAllowTrustedLan = true;
    private string? generatedPassword;

    private string addDomainZoneId = string.Empty;
    private string addDomainName = string.Empty;
    private string addDomainSelector = "lms";
    private MailRelayDomainPreview? domainPreview;
    private MailRelayDomainDetail? domainDetail;
    private MailRelayDomain? deleteDomain;
    private MailRelayClient? deleteClient;
    private bool deleteDomainRemoveDns = true;
    private bool isPreviewingDomain;
    private bool isSavingDomain;
    private string domainMessage = string.Empty;
    private bool domainMessageIsError;

    private Guid? clientId;
    private string clientName = string.Empty;
    private string clientUsername = string.Empty;
    private string clientPassword = string.Empty;
    private readonly HashSet<Guid> selectedDomainIds = [];
    private string clientMessage = string.Empty;
    private bool clientMessageIsError;

    private string testClientId = string.Empty;
    private string testFromAddress = string.Empty;
    private string testRecipientAddress = string.Empty;

    private bool publicIpMonitorEnabled = true;
    private int publicIpIntervalMinutes = 15;

    private bool legacyEnabled;
    private string legacyAllowedCidrsText = string.Empty;
    private string legacyMessage = string.Empty;
    private bool legacyMessageIsError;

    private bool removeContainer = true;
    private bool removeApplicationCredentials = true;
    private bool removeManagedDnsRecords = true;
    private bool removeDkimKeys = true;
    private bool removeConfirmed;
    private string removalMessage = string.Empty;
    private bool removalMessageIsError;

    private bool HasCloudflareZones => dashboard?.Preflight.AvailableZones.Count > 0;
    private bool IsEnabled => dashboard?.Configuration?.Enabled == true;
    private bool OutboundMxBlocked =>
        dashboard?.Preflight.GetCheck(MailRelayPreflightCheckKeys.OutboundSmtp).State
            is MailRelayPreflightCheckState.Warning or MailRelayPreflightCheckState.Failed;
    private bool IsSetupRunning =>
        isStartingSetup ||
        setupJob is { IsTerminal: false };
    private bool CanStartSetup =>
        !IsSetupRunning &&
        !string.IsNullOrWhiteSpace(setupRelayHostname) &&
        !string.IsNullOrWhiteSpace(setupSendingDomain) &&
        !string.IsNullOrWhiteSpace(setupDkimSelector) &&
        !string.IsNullOrWhiteSpace(setupApplicationName) &&
        !string.IsNullOrWhiteSpace(setupApplicationUsername);
    private bool CanAddDomain =>
        !isPreviewingDomain &&
        !isSavingDomain &&
        domainPreview?.CanApply == true;
    private string TestCalloutClass =>
        testResult?.Status == MailRelayTestStatus.Sent ? "ready" : "warning";
    private string VisibleMailLogText
    {
        get
        {
            if (mailLog is null)
            {
                return string.Empty;
            }

            if (mailLogFilter == "queue")
            {
                return mailLog.Queue.Count > 0 ? string.Join('\n', mailLog.Queue) : "Mail queue is empty.";
            }

            var lines = (mailLog.Lines ?? []).Where(IsVisibleMailLogLine).ToArray();
            if (mailLogFilter is "all" or "test" && mailLog.Queue.Count > 0)
            {
                return string.Join('\n', lines.Concat(["", "--- Postfix queue ---"]).Concat(mailLog.Queue));
            }

            return string.Join('\n', lines);
        }
    }
    private string MailLogStatusLabel =>
        mailLog is null ? "Not loaded"
        : mailLog.Events.Any(item => item.Severity == MailRelayLogSeverity.Error) ? "Errors"
        : mailLog.Events.Any(item => item.Severity == MailRelayLogSeverity.Warning) ? "Deferred"
        : mailLog.Events.Any(item => item.Severity == MailRelayLogSeverity.Sent) ? "Delivered"
        : mailLog.Available ? "Ready"
        : "Empty";
    private LmsStatusTone MailLogStatusTone => MailLogStatusLabel switch
    {
        "Delivered" or "Ready" => LmsStatusTone.Ready,
        "Deferred" => LmsStatusTone.Warning,
        "Errors" => LmsStatusTone.Critical,
        _ => LmsStatusTone.Neutral
    };
    private string RelayHostname =>
        !string.IsNullOrWhiteSpace(dashboard?.Configuration?.RelayHostname)
            ? dashboard!.Configuration!.RelayHostname
            : dashboard?.Preflight.SuggestedRelayHostname ?? string.Empty;
    private string PublicIpLabel =>
        !string.IsNullOrWhiteSpace(dashboard?.Configuration?.PublicIpAddress)
            ? dashboard!.Configuration!.PublicIpAddress
            : dashboard?.Preflight.PublicIpAddress ?? string.Empty;
    private string StatusLabel => dashboard?.Status switch
    {
        MailRelayOperationalStatus.Healthy => "Healthy",
        MailRelayOperationalStatus.Warning => "Warning",
        MailRelayOperationalStatus.Critical => "Critical",
        _ => "Not configured"
    };
    private LmsStatusTone StatusTone => dashboard?.Status switch
    {
        MailRelayOperationalStatus.Healthy => LmsStatusTone.Ready,
        MailRelayOperationalStatus.Warning => LmsStatusTone.Warning,
        MailRelayOperationalStatus.Critical => LmsStatusTone.Critical,
        _ => LmsStatusTone.Neutral
    };
    private string SubmissionModeLabel
    {
        get
        {
            var configuration = dashboard?.Configuration;
            if (configuration?.Enabled != true)
            {
                return "Not configured";
            }

            if (configuration.AllowLegacyPort25 && configuration.AllowTrustedLan)
            {
                return $"Trusted LAN :{configuration.SubmissionPort} + legacy :25";
            }

            if (configuration.AllowLegacyPort25)
            {
                return "Legacy :25";
            }

            return configuration.AllowTrustedLan
                ? $"Trusted LAN :{configuration.SubmissionPort}"
                : $":{configuration.SubmissionPort} local only";
        }
    }
    private string PublicIpMonitorLabel => dashboard?.Configuration?.PublicIpMonitorStatus switch
    {
        MailRelayPublicIpMonitorStatus.Healthy => "Healthy",
        MailRelayPublicIpMonitorStatus.Updated => "Updated",
        MailRelayPublicIpMonitorStatus.Warning => "Warning",
        MailRelayPublicIpMonitorStatus.Error => "Error",
        MailRelayPublicIpMonitorStatus.Disabled => "Disabled",
        _ => "Waiting"
    };
    private LmsStatusTone PublicIpMonitorTone => dashboard?.Configuration?.PublicIpMonitorStatus switch
    {
        MailRelayPublicIpMonitorStatus.Healthy or MailRelayPublicIpMonitorStatus.Updated => LmsStatusTone.Ready,
        MailRelayPublicIpMonitorStatus.Warning => LmsStatusTone.Warning,
        MailRelayPublicIpMonitorStatus.Error => LmsStatusTone.Critical,
        _ => LmsStatusTone.Neutral
    };
    private string PublicIpMonitorDetail
    {
        get
        {
            var configuration = dashboard?.Configuration;
            if (configuration is null)
            {
                return string.Empty;
            }

            var lastCheck = configuration.LastPublicIpCheckUtc.HasValue
                ? configuration.LastPublicIpCheckUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                : "never";
            return $"{configuration.PublicIpMonitorDetail} Last check {lastCheck}. Interval {configuration.PublicIpCheckIntervalMinutes} minutes.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
        var latest = await MailRelayService.GetLatestSetupJobAsync();
        if (latest is null || latest.IsTerminal)
        {
            return;
        }

        ApplySetupRequest(latest.Request);
        setupJob = latest;
        showSetupModal = true;
        BeginPolling(latest.Id);
    }

    public void Dispose()
    {
        pollCts?.Cancel();
        pollCts?.Dispose();
        pollCts = null;
    }

    private async Task LoadDashboardAsync()
    {
        dashboard = await MailRelayService.GetDashboardAsync();
        selectedZoneId = FirstNonEmpty(dashboard.Preflight.CloudflareZoneId, selectedZoneId, dashboard.Preflight.AvailableZones.FirstOrDefault()?.ZoneId);
        if (string.IsNullOrWhiteSpace(testClientId) && dashboard.Clients.Count == 1)
        {
            testClientId = dashboard.Clients[0].Id.ToString();
            OnTestClientChanged();
        }

        if (dashboard.Configuration?.Enabled == true && mailLogExpanded && mailLog is null)
        {
            await RefreshMailLogAsync();
        }
    }

    private async Task RecheckPreflightAsync()
    {
        isRechecking = true;
        actionMessage = string.Empty;
        try
        {
            var preflight = await MailRelayService.RecheckPreflightAsync(string.IsNullOrWhiteSpace(selectedZoneId) ? null : selectedZoneId);
            if (dashboard is not null)
            {
                dashboard = dashboard with { Preflight = preflight };
            }
            else
            {
                await LoadDashboardAsync();
            }

            selectedZoneId = FirstNonEmpty(preflight.CloudflareZoneId, selectedZoneId, preflight.AvailableZones.FirstOrDefault()?.ZoneId);
            actionMessage = preflight.CanConfigure
                ? "Preflight passed. This host can run Mail Relay."
                : "Preflight finished. Resolve the failed checks before setup.";
            actionIsError = !preflight.CanConfigure;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
