    private async Task StartSetupAsync()
    {
        if (!CanStartSetup)
        {
            return;
        }

        isStartingSetup = true;
        generatedPassword = null;
        actionMessage = string.Empty;
        try
        {
            setupPreview = await MailRelayService.PreviewSetupAsync(BuildSetupRequest());
            if (dashboard is not null)
            {
                dashboard = dashboard with { Preflight = setupPreview.Preflight };
            }

            if (!setupPreview.CanInstall)
            {
                SetAction(setupPreview.Errors.FirstOrDefault() ?? "Mail Relay is not ready to install yet.", true);
                return;
            }

            setupJob = await MailRelayService.StartSetupAsync(BuildSetupRequest());
            BeginPolling(setupJob.Id);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            SetAction($"Could not start Mail Relay setup: {exception.Message}", true);
        }
        finally
        {
            isStartingSetup = false;
        }
    }

    private void BeginPolling(Guid jobId)
    {
        pollCts?.Cancel();
        pollCts?.Dispose();
        pollCts = new CancellationTokenSource();
        _ = PollSetupJobAsync(jobId, pollCts.Token);
    }

    private async Task PollSetupJobAsync(Guid jobId, CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(1), cancellationToken);
                var snapshot = await MailRelayService.GetSetupJobAsync(jobId, cancellationToken);
                setupJob = snapshot;
                await InvokeAsync(StateHasChanged);
                if (snapshot?.IsTerminal != true)
                {
                    continue;
                }

                if (snapshot.Status == MailRelayProvisioningJobStatus.Succeeded)
                {
                    generatedPassword = snapshot.Result?.GeneratedPassword;
                    SetAction(snapshot.Result?.Summary ?? snapshot.Summary, false);
                }
                else
                {
                    SetAction(snapshot.Summary, true);
                }

                await LoadDashboardAsync();
                await InvokeAsync(StateHasChanged);
                break;
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            SetAction($"Setup progress could not be read: {exception.Message}", true);
            await InvokeAsync(StateHasChanged);
        }
    }

