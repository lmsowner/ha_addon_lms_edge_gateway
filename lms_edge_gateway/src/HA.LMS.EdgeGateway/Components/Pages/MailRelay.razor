@page "/mail-relay"
@rendermode InteractiveServer
@implements IDisposable
@inject IMailRelayService MailRelayService
@inject IJSRuntime JS

<PageTitle>Mail Relay | LMS Edge Gateway</PageTitle>

<div class="page-shell edge-gateway-page mail-relay-page">
    <section class="surface-card edge-card">
        <div class="table-header">
            <div>
                <p class="eyebrow">Mail Relay</p>
                <h2>Outbound SMTP for Home Assistant</h2>
                <p class="meta-text">
                    LMS Mail Relay is outbound-only SMTP for applications on this host. It matches full LMS: apps submit on private 587, then Postfix looks up the recipient MX on TCP/25 and upgrades with STARTTLS.
                    This is not inbound MX and it is not the Security → Messaging client.
                </p>
            </div>
            @if (!IsEnabled)
            {
                <LmsButton Label="@(isRechecking ? "Checking..." : "Run preflight")"
                           Icon="refresh"
                           Busy="@isRechecking"
                           Disabled="@isRechecking"
                           OnClick="RecheckPreflightAsync" />
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(actionMessage))
        {
            <p class="callout @(actionIsError ? "warning" : "ready")">@actionMessage</p>
        }

        @if (dashboard is null)
        {
            <section class="surface-card edge-loading-card" aria-busy="true">
                <span class="edge-loading-progress">
                    <span class="edge-loading-progress-fill"></span>
                </span>
                <p class="meta-text">Loading Mail Relay.</p>
            </section>
        }
        else if (!HasCloudflareZones)
        {
            <p class="callout warning">
                Finish the Setup tab first so Edge Gateway has a Cloudflare zone. Mail Relay can only manage DNS for a zone that token can already see.
            </p>
            <div class="toolbar-row">
                <LmsButton Label="Open Setup" Icon="info" Primary="true" Href="/cloudflare" />
            </div>
        }
        else
        {
            <section class="surface-subcard mail-relay-overview">
                <div class="mail-relay-stat">
                    <span class="ui-field-label">Status</span>
                    <LmsStatusPill Text="@StatusLabel" Tone="@StatusTone" />
                    <span class="ui-field-helper">@dashboard.StatusSummary</span>
                </div>
                <div class="mail-relay-stat">
                    <span class="ui-field-label">Relay hostname</span>
                    <strong>@(string.IsNullOrWhiteSpace(RelayHostname) ? "Not set" : RelayHostname)</strong>
                    <span class="ui-field-helper">Submission stays on this host. Public 587 is never enabled.</span>
                </div>
                <div class="mail-relay-stat">
                    <span class="ui-field-label">Submission</span>
                    <strong>@SubmissionModeLabel</strong>
                    <span class="ui-field-helper">Trusted LAN uses the Home Assistant host_network path.</span>
                </div>
                <div class="mail-relay-stat">
                    <span class="ui-field-label">Public IP</span>
                    <strong>@(string.IsNullOrWhiteSpace(PublicIpLabel) ? "Unknown" : PublicIpLabel)</strong>
                    <span class="ui-field-helper">Home IPs change, so LMS watches this by default.</span>
                </div>
            </section>

            @if (!IsEnabled)
            {
                <label class="ui-field mail-relay-zone-field">
                    <span class="ui-field-label">
                        Cloudflare zone
                        <LmsFieldInfo Title="Cloudflare zone"
                                      Body="Used only for first-time setup and when adding a sending domain. It is not the relay hostname." />
                    </span>
                    <select value="@selectedZoneId" @onchange="OnZoneChangedAsync" disabled="@isRechecking">
                        @foreach (var zone in dashboard.Preflight.AvailableZones)
                        {
                            <option value="@zone.ZoneId">@zone.ZoneName</option>
                        }
                    </select>
                </label>

                <section class="surface-subcard">
                    <div class="table-header">
                        <div>
                            <p class="eyebrow">Preflight</p>
                            <h3>Host and Cloudflare checks</h3>
                        </div>
                        <LmsStatusPill Text="@(dashboard.Preflight.CanConfigure ? "Ready" : "Needs attention")"
                                       Tone="@(dashboard.Preflight.CanConfigure ? LmsStatusTone.Ready : LmsStatusTone.Warning)" />
                    </div>
                    <div class="mail-relay-check-list">
                        @foreach (var check in dashboard.Preflight.Checks)
                        {
                            <article class="mail-relay-check">
                                <header>
                                    <div>
                                        <strong>@check.Label</strong>
                                        <span>@check.Value</span>
                                    </div>
                                    <LmsStatusPill Text="@PreflightStateLabel(check.State)" Tone="@PreflightTone(check.State)" />
                                </header>
                                <p>@check.Detail</p>
                            </article>
                        }
                    </div>
                </section>
                <div class="toolbar-row">
                    <LmsButton Label="Set up Mail Relay"
                               Icon="plus"
                               Primary="true"
                               Disabled="@IsSetupRunning"
                               OnClick="OpenSetupModal" />
                </div>
            }
        }
    </section>

    @if (IsEnabled && dashboard is not null)
    {
        <div class="mail-relay-panel-grid">
            <section class="surface-card edge-card">
                <div class="table-header">
                    <div>
                        <p class="eyebrow">Sending domains</p>
                        <h2>SPF, DKIM and DMARC</h2>
                        <p class="meta-text">Microsoft 365 and other mailbox MX stay. LMS only merges its SPF ip4 and DKIM selector.</p>
                    </div>
                    <LmsButton Label="Add domain" Icon="plus" Primary="true" OnClick="OpenAddDomainModal" />
                </div>
                @if (dashboard.Domains.Count == 0)
                {
                    <p class="meta-text">No sending domains are configured yet.</p>
                }
                else
                {
                    <div class="mail-relay-row-list">
                        @foreach (var domain in dashboard.Domains)
                        {
                            <div class="mail-relay-row mail-relay-config-row">
                                <div>
                                    <strong>@domain.DomainName</strong>
                                    <span>@ZoneNameFor(domain) · <code>@domain.CurrentDkimSelector</code>@(domain.Enabled ? string.Empty : " · pending")</span>
                                    <div class="mail-relay-pill-row">
                                        <LmsStatusPill Text="@($"SPF {DnsStatusLabel(domain.SpfStatus)}")" Tone="@DnsTone(domain.SpfStatus)" />
                                        <LmsStatusPill Text="@($"DKIM {DnsStatusLabel(domain.DkimStatus)}")" Tone="@DnsTone(domain.DkimStatus)" />
                                        <LmsStatusPill Text="@($"DMARC {DnsStatusLabel(domain.DmarcStatus)}")" Tone="@DnsTone(domain.DmarcStatus)" />
                                    </div>
                                </div>
                                <div class="mail-relay-row-actions">
                                    <LmsButton Label="Edit" Icon="edit" OnClick="@(() => OpenDomainDetailAsync(domain))" />
                                    <LmsButton Label="Delete" Icon="delete" Danger="true" OnClick="@(() => OpenDeleteDomainModal(domain))" />
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="surface-card edge-card">
                <div class="table-header">
                    <div>
                        <p class="eyebrow">SMTP users</p>
                        <h2>Application credentials</h2>
                        <p class="meta-text">Each user may send only from the domains you allow. Usernames cannot be renamed.</p>
                    </div>
                    <LmsButton Label="Add SMTP user" Icon="plus" Primary="true" OnClick="@(() => OpenClientModal(null))" />
                </div>
                @if (dashboard.Clients.Count == 0)
                {
                    <p class="meta-text">No SMTP users yet. Add one for Home Assistant or another local application.</p>
                }
                else
                {
                    <div class="mail-relay-row-list">
                        @foreach (var client in dashboard.Clients)
                        {
                            <div class="mail-relay-row mail-relay-config-row">
                                <div>
                                    <strong>@client.Name</strong>
                                    <span><code>@client.Username</code> · @string.Join(", ", client.AllowedSenderDomains)</span>
                                </div>
                                <div class="mail-relay-row-actions">
                                    <LmsButton Label="Edit" Icon="edit" OnClick="@(() => OpenClientModal(client))" />
                                    <LmsButton Label="Delete" Icon="delete" Danger="true" OnClick="@(() => OpenDeleteClientModal(client))" />
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="surface-card edge-card">
                <div class="table-header">
                    <div>
                        <p class="eyebrow">Test email</p>
                        <h2>Send through Mail Relay</h2>
                        <p class="meta-text">Uses a local SMTP user, then the same MX path as full LMS. Not the Security → Messaging client.</p>
                    </div>
                </div>
                @if (OutboundMxBlocked)
                {
                    <p class="callout warning">
                        This network cannot open destination MX on TCP/25. Outlook MX does not accept mail on 587.
                    </p>
                }
                <div class="edge-form-grid mail-relay-form-grid">
                    <label class="ui-field">
                        <span class="ui-field-label">SMTP user</span>
                        <select @bind="testClientId" @bind:after="OnTestClientChanged">
                            <option value="">Select a user</option>
                            @foreach (var client in dashboard.Clients)
                            {
                                <option value="@client.Id">@client.Name (@client.Username)</option>
                            }
                        </select>
                    </label>
                    <label class="ui-field">
                        <span class="ui-field-label">From</span>
                        <input type="email" @bind="testFromAddress" placeholder="homeassistant@example.com" />
                    </label>
                    <label class="ui-field">
                        <span class="ui-field-label">Recipient</span>
                        <input type="email" @bind="testRecipientAddress" placeholder="you@example.com" />
                    </label>
                </div>
                <div class="toolbar-row">
                    <LmsButton Label="@(isSendingTest ? "Sending..." : "Send test")"
                               Icon="test"
                               Primary="true"
                               Busy="@isSendingTest"
                               Disabled="@isSendingTest"
                               OnClick="SendTestAsync" />
                </div>
                @if (testResult is not null)
                {
                    <div class="mail-relay-test-result">
                        <p class="callout @(TestCalloutClass)">@testResult.Summary</p>
                        <div class="mail-relay-test-meta">
                            <span>Status: @testResult.Status</span>
                            @if (!string.IsNullOrWhiteSpace(testResult.QueueId))
                            {
                                <span>Queue ID: <code>@testResult.QueueId</code></span>
                            }
                            @if (!string.IsNullOrWhiteSpace(testResult.DestinationServer))
                            {
                                <span>Destination: <code>@testResult.DestinationServer</code></span>
                            }
                            @if (!string.IsNullOrWhiteSpace(testResult.SmtpResponse))
                            {
                                <span>SMTP: @testResult.SmtpResponse</span>
                            }
                        </div>
                    </div>
                }
            </section>

            <section class="surface-card edge-card">
                <div class="table-header">
                    <div>
                        <p class="eyebrow">Public IP protection</p>
                        <h2>Keep LMS DNS aligned</h2>
                        <p class="meta-text">Checks the home address every 15 minutes by default. Only LMS-owned A and SPF ip4: records are rewritten. MX is never touched.</p>
                    </div>
                    <LmsStatusPill Text="@PublicIpMonitorLabel" Tone="@PublicIpMonitorTone" />
                </div>
                <p class="meta-text">@PublicIpMonitorDetail</p>
                <div class="toolbar-row">
                    <LmsButton Label="@(isCheckingPublicIp ? "Checking..." : "Check now")"
                               Icon="refresh"
                               Busy="@isCheckingPublicIp"
                               Disabled="@isCheckingPublicIp"
                               OnClick="CheckPublicIpNowAsync" />
                    <LmsButton Label="Configure" Icon="edit" OnClick="OpenPublicIpModal" />
                </div>
            </section>

            <section class="surface-card edge-card mail-relay-log-panel">
                <button type="button"
                        class="mail-relay-log-toggle"
                        aria-expanded="@mailLogExpanded"
                        @onclick="ToggleMailLogAsync">
                    <div>
                        <p class="eyebrow">Postfix</p>
                        <h2>Send log</h2>
                        <p class="meta-text">@(mailLogExpanded ? (mailLog?.Summary ?? "Raw mail.log and queue.") : "Hidden until you need it. Open after a test to see Postfix output.")</p>
                    </div>
                    <div class="mail-relay-log-toggle-meta">
                        <LmsStatusPill Text="@MailLogStatusLabel" Tone="@MailLogStatusTone" />
                        <span>@(mailLogExpanded ? "Hide" : "Show")</span>
                    </div>
                </button>
                @if (mailLogExpanded)
                {
                    <div class="toolbar-row">
                        <div class="mail-relay-log-filters" role="tablist" aria-label="Send log filter">
                            <button type="button" class="mail-relay-log-filter @(mailLogFilter == "all" ? "active" : string.Empty)" @onclick='() => mailLogFilter = "all"'>All</button>
                            <button type="button" class="mail-relay-log-filter @(mailLogFilter == "test" ? "active" : string.Empty)" disabled="@string.IsNullOrWhiteSpace(testResult?.QueueId)" @onclick='() => mailLogFilter = "test"'>This test</button>
                            <button type="button" class="mail-relay-log-filter @(mailLogFilter == "problems" ? "active" : string.Empty)" @onclick='() => mailLogFilter = "problems"'>Problems</button>
                            <button type="button" class="mail-relay-log-filter @(mailLogFilter == "queue" ? "active" : string.Empty)" @onclick='() => mailLogFilter = "queue"'>Queue</button>
                        </div>
                        <LmsButton Label="@(isLoadingMailLog ? "Reading..." : "Refresh")"
                                   Icon="refresh"
                                   Busy="@isLoadingMailLog"
                                   Disabled="@isLoadingMailLog"
                                   OnClick="RefreshMailLogAsync" />
                        <LmsButton Label="Copy"
                                   Icon="copy"
                                   Disabled="@string.IsNullOrWhiteSpace(VisibleMailLogText)"
                                   OnClick="CopyMailLogAsync" />
                        <LmsButton Label="@(isClearingQueue ? "Clearing..." : "Clear queue")"
                                   Icon="delete"
                                   Danger="true"
                                   Busy="@isClearingQueue"
                                   Disabled="@isClearingQueue"
                                   OnClick="ClearMailQueueAsync" />
                    </div>
                    <pre class="mail-relay-log">@(string.IsNullOrWhiteSpace(VisibleMailLogText) ? "No Postfix lines for this filter yet. Send a test or refresh." : VisibleMailLogText)</pre>
                }
            </section>

            <section class="surface-card edge-card">
                <div class="table-header">
                    <div>
                        <p class="eyebrow">Legacy devices</p>
                        <h2>Port 25 listener</h2>
                        <p class="meta-text">Unauthenticated LAN :25 on all adapters. Only the send-from allowlist may submit.</p>
                    </div>
                    <LmsStatusPill Text="@(dashboard.Configuration!.AllowLegacyPort25 ? "Enabled" : "Off")"
                                   Tone="@(dashboard.Configuration.AllowLegacyPort25 ? LmsStatusTone.Warning : LmsStatusTone.Neutral)" />
                </div>
                @if (dashboard.Configuration.AllowLegacyPort25 && dashboard.Configuration.EffectiveLegacyAllowedNetworks.Count > 0)
                {
                    <p class="meta-text">Allowed sources: @string.Join(", ", dashboard.Configuration.EffectiveLegacyAllowedNetworks)</p>
                }
                <div class="toolbar-row">
                    <LmsButton Label="Configure" Icon="edit" OnClick="OpenLegacyModal" />
                </div>
            </section>

            <section class="surface-card edge-card">
                <div class="table-header">
                    <div>
                        <p class="eyebrow">Maintenance</p>
                        <h2>Remove Mail Relay</h2>
                        <p class="meta-text">Tear down the relay. MX records stay because LMS never owns them.</p>
                    </div>
                </div>
                <LmsButton Label="Remove Mail Relay" Icon="delete" Danger="true" OnClick="OpenRemovalModal" />
            </section>
        </div>
    }
</div>

@if (showSetupModal)
{
    <div class="edge-modal-backdrop" role="presentation">
        <section class="edge-modal-panel mail-relay-modal" role="dialog" aria-modal="true" aria-labelledby="mail-relay-setup-title">
            <header class="edge-modal-header">
                <div>
                    <p class="eyebrow">Set up Mail Relay</p>
                    <h2 id="mail-relay-setup-title">Create the outbound SMTP relay</h2>
                    <p class="meta-text">Start setup when the fields look right. LMS reviews DNS, then installs the relay and shows progress here.</p>
                </div>
                <button class="edge-modal-close" type="button" aria-label="Close setup" @onclick="CloseSetupModal">x</button>
            </header>
            <div class="edge-modal-body">
                <div class="edge-form-grid mail-relay-form-grid">
                    <label class="ui-field">
                        <span class="ui-field-label">
                            Cloudflare zone
                            <LmsFieldInfo Title="Cloudflare zone" Body="DNS for the first sending domain and the smtp hostname is written here. Other domains can use a different zone later." />
                        </span>
                        <select @bind="selectedZoneId" @bind:after="ClearSetupPreview" disabled="@IsSetupRunning">
                            @foreach (var zone in dashboard?.Preflight.AvailableZones ?? [])
                            {
                                <option value="@zone.ZoneId">@zone.ZoneName</option>
                            }
                        </select>
                    </label>
                    <label class="ui-field">
                        <span class="ui-field-label">
                            Relay hostname
                            <LmsFieldInfo Title="Relay hostname" Body="Defaults to smtp on the selected zone. This is the SMTP host applications use. It is not proxied through Cloudflare." />
                        </span>
                        <input @bind="setupRelayHostname" @bind:after="ClearSetupPreview" disabled="@IsSetupRunning" placeholder="smtp.example.com" />
                    </label>
                    <label class="ui-field">
                        <span class="ui-field-label">Sending domain</span>
                        <input @bind="setupSendingDomain" @bind:after="ClearSetupPreview" disabled="@IsSetupRunning" placeholder="example.com" />
                    </label>
                    <label class="ui-field">
                        <span class="ui-field-label">DKIM selector</span>
                        <input @bind="setupDkimSelector" @bind:after="ClearSetupPreview" disabled="@IsSetupRunning" placeholder="lms" />
                    </label>
                    <label class="ui-field">
                        <span class="ui-field-label">Application name</span>
                        <input @bind="setupApplicationName" @bind:after="ClearSetupPreview" disabled="@IsSetupRunning" placeholder="Home Assistant" />
                    </label>
                    <label class="ui-field">
                        <span class="ui-field-label">SMTP username</span>
                        <input @bind="setupApplicationUsername" @bind:after="ClearSetupPreview" disabled="@IsSetupRunning" placeholder="homeassistant" />
                    </label>
                    <label class="mail-relay-check-field">
                        <input type="checkbox" @bind="setupAllowTrustedLan" @bind:after="ClearSetupPreview" disabled="@IsSetupRunning" />
                        <span>
                            Allow trusted LAN
                            <LmsFieldInfo Title="Trusted LAN" Body="This is the Home Assistant path. Mail Relay listens on the add-on host_network. There is no Tailscale option here." />
                        </span>
                    </label>
                </div>

                @if (setupPreview is not null)
                {
                    @if (setupPreview.ExistingEmailConfiguration.HasExistingMail)
                    {
                        <div class="callout ready">
                            <strong>@setupPreview.ExistingEmailConfiguration.ProviderLabel stays in place</strong>
                            <p>@setupPreview.ExistingEmailConfiguration.CoexistenceSummary</p>
                            @if (setupPreview.ExistingEmailConfiguration.MxRecords.Count > 0)
                            {
                                <p>MX left unchanged: @string.Join(", ", setupPreview.ExistingEmailConfiguration.MxRecords)</p>
                            }
                        </div>
                    }
                    @if (setupPreview.Errors.Count > 0)
                    {
                        <div class="callout warning">
                            @foreach (var error in setupPreview.Errors)
                            {
                                <p>@error</p>
                            }
                        </div>
                    }
                    @if (setupPreview.Warnings.Count > 0)
                    {
                        <div class="callout warning">
                            @foreach (var warning in setupPreview.Warnings)
                            {
                                <p>@warning</p>
                            }
                        </div>
                    }
                    <div class="mail-relay-dns-list">
                        @foreach (var change in setupPreview.DnsChanges)
                        {
                            <div class="mail-relay-dns-row">
                                <div>
                                    <strong>@change.Purpose</strong>
                                    <span>@change.RecordType @change.RecordName</span>
                                </div>
                                <code>@change.ProposedValue</code>
                                <LmsStatusPill Text="@change.Kind.ToString()" Tone="@ChangeKindTone(change.Kind)" />
                            </div>
                        }
                    </div>
                }

                @if (setupJob is not null)
                {
                    <div class="mail-relay-step-list">
                        @foreach (var step in setupJob.Steps)
                        {
                            <div class="mail-relay-step">
                                <LmsStatusPill Text="@step.State.ToString()" Tone="@StepTone(step.State)" />
                                <div>
                                    <strong>@step.Label</strong>
                                    @if (!string.IsNullOrWhiteSpace(step.Detail))
                                    {
                                        <span>@step.Detail</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <p class="meta-text">@setupJob.Summary</p>
                }

                @if (!string.IsNullOrWhiteSpace(generatedPassword))
                {
                    <div class="callout ready mail-relay-secret">
                        <div>
                            <strong>Generated SMTP password</strong>
                            <p>Copy this now. LMS will not show it again.</p>
                            <code>@generatedPassword</code>
                        </div>
                        <LmsButton Label="Copy password" Icon="copy" OnClick="CopyGeneratedPasswordAsync" />
                    </div>
                }
            </div>
            <footer class="edge-modal-footer">
                <LmsButton Label="Close" Icon="close" OnClick="CloseSetupModal" />
                @if (setupJob?.Status != MailRelayProvisioningJobStatus.Succeeded)
                {
                    <LmsButton Label="@(IsSetupRunning ? "Setting up..." : "Start setup")"
                               Icon="check"
                               Primary="true"
                               Busy="@IsSetupRunning"
                               Disabled="@(!CanStartSetup)"
                               OnClick="StartSetupAsync" />
                }
            </footer>
        </section>
    </div>
}

@if (showClientModal)
{
    <div class="edge-modal-backdrop" role="presentation">
        <section class="edge-modal-panel mail-relay-modal" role="dialog" aria-modal="true" aria-labelledby="mail-relay-client-title">
            <header class="edge-modal-header">
                <div>
                    <p class="eyebrow">SMTP user</p>
                    <h2 id="mail-relay-client-title">@(clientId.HasValue ? "Edit SMTP user" : "Add SMTP user")</h2>
                    <p class="meta-text">Leave the password blank when editing to keep the current secret.</p>
                </div>
                <button class="edge-modal-close" type="button" aria-label="Close SMTP user" @onclick="CloseClientModal">x</button>
            </header>
            <div class="edge-modal-body">
                @if (!string.IsNullOrWhiteSpace(clientMessage))
                {
                    <p class="callout @(clientMessageIsError ? "warning" : "ready")">@clientMessage</p>
                }
                <div class="edge-form-grid mail-relay-form-grid">
                    <label class="ui-field">
                        <span class="ui-field-label">Name</span>
                        <input @bind="clientName" placeholder="Home Assistant" />
                    </label>
                    <label class="ui-field">
                        <span class="ui-field-label">Username</span>
                        <input @bind="clientUsername" placeholder="homeassistant" disabled="@clientId.HasValue" />
                    </label>
                    <label class="ui-field">
                        <span class="ui-field-label">Password</span>
                        <div class="mail-relay-password-row">
                            <input type="text" @bind="clientPassword" autocomplete="new-password" placeholder="@(clientId.HasValue ? "Leave blank to keep current" : "Generate a password")" />
                            <LmsButton Label="Generate" Icon="refresh" OnClick="GenerateClientPassword" />
                            <LmsButton Label="Copy" Icon="copy" Disabled="@string.IsNullOrWhiteSpace(clientPassword)" OnClick="CopyClientPasswordAsync" />
                        </div>
                    </label>
                </div>
                <div class="mail-relay-domain-picks">
                    <span class="ui-field-label">Allowed sending domains</span>
                    @if (dashboard is null || dashboard.Domains.Count == 0)
                    {
                        <p class="meta-text">No sending domains are available.</p>
                    }
                    else
                    {
                        @foreach (var domain in dashboard.Domains)
                        {
                            <label class="mail-relay-check-field">
                                <input type="checkbox"
                                       checked="@selectedDomainIds.Contains(domain.Id)"
                                       @onchange="@((ChangeEventArgs args) => ToggleDomain(domain.Id, args))" />
                                <span>@domain.DomainName</span>
                            </label>
                        }
                    }
                </div>
            </div>
            <footer class="edge-modal-footer">
                <LmsButton Label="Cancel" Icon="close" OnClick="CloseClientModal" />
                @if (clientId.HasValue)
                {
                    <LmsButton Label="Delete user" Icon="delete" Danger="true" Disabled="@isSavingClient" OnClick="@(() => OpenDeleteClientModal(dashboard?.Clients.FirstOrDefault(item => item.Id == clientId)))" />
                }
                <LmsButton Label="@(isSavingClient ? "Saving..." : "Save user")"
                           Icon="save"
                           Primary="true"
                           Busy="@isSavingClient"
                           Disabled="@isSavingClient"
                           OnClick="SaveClientAsync" />
            </footer>
        </section>
    </div>
}

@if (showAddDomainModal)
{
    <div class="edge-modal-backdrop" role="presentation">
        <section class="edge-modal-panel mail-relay-modal" role="dialog" aria-modal="true" aria-labelledby="mail-relay-add-domain-title">
            <header class="edge-modal-header">
                <div>
                    <p class="eyebrow">Sending domain</p>
