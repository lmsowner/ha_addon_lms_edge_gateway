#!/usr/bin/with-contenv bashio

set -euo pipefail

CONFIG_ROOT="${LMS_MAIL_RELAY_CONFIG:-/data/lms-edge-gateway/mail-relay/config}"
LMS_CONFIG_LINK=/lms-config

if [[ ! -f "${CONFIG_ROOT}/main.cf" ]]; then
  bashio::log.info "Mail Relay configuration is not present yet."
  exit 0
fi

mkdir -p /etc/postfix/sasl /etc/sasl2 /run/opendkim/keys /var/lib/lms /var/spool/postfix/etc /var/log
ln -sfn "${CONFIG_ROOT}" "${LMS_CONFIG_LINK}"

cp "${CONFIG_ROOT}/main.cf" /etc/postfix/main.cf
if [[ -f "${CONFIG_ROOT}/smtpd.conf" ]]; then
  cp "${CONFIG_ROOT}/smtpd.conf" /etc/postfix/sasl/smtpd.conf
  cp "${CONFIG_ROOT}/smtpd.conf" /etc/sasl2/smtpd.conf
fi
[[ -f "${CONFIG_ROOT}/sender_login_maps" ]] && cp "${CONFIG_ROOT}/sender_login_maps" /etc/postfix/sender_login_maps
[[ -f "${CONFIG_ROOT}/legacy_clients.cidr" ]] && cp "${CONFIG_ROOT}/legacy_clients.cidr" /etc/postfix/legacy_clients.cidr
[[ -f "${CONFIG_ROOT}/legacy_senders.pcre" ]] && cp "${CONFIG_ROOT}/legacy_senders.pcre" /etc/postfix/legacy_senders.pcre
[[ -f "${CONFIG_ROOT}/header_checks.pcre" ]] && cp "${CONFIG_ROOT}/header_checks.pcre" /etc/postfix/header_checks.pcre
[[ -f "${CONFIG_ROOT}/opendkim.conf" ]] && cp "${CONFIG_ROOT}/opendkim.conf" /etc/opendkim.conf

if [[ -d "${CONFIG_ROOT}/dkim" ]]; then
  mkdir -p /run/opendkim/keys
  cp -R "${CONFIG_ROOT}/dkim/." /run/opendkim/keys/
fi
if [[ -d "${CONFIG_ROOT}/opendkim" ]]; then
  [[ -f "${CONFIG_ROOT}/opendkim/KeyTable" ]] && cp "${CONFIG_ROOT}/opendkim/KeyTable" /run/opendkim/KeyTable
  [[ -f "${CONFIG_ROOT}/opendkim/SigningTable" ]] && cp "${CONFIG_ROOT}/opendkim/SigningTable" /run/opendkim/SigningTable
  [[ -f "${CONFIG_ROOT}/opendkim/TrustedHosts" ]] && cp "${CONFIG_ROOT}/opendkim/TrustedHosts" /run/opendkim/TrustedHosts
fi

chmod 0644 /etc/postfix/sender_login_maps /etc/postfix/legacy_clients.cidr /etc/postfix/legacy_senders.pcre /etc/postfix/header_checks.pcre 2>/dev/null || true
if id -u opendkim >/dev/null 2>&1; then
  chown -R opendkim:opendkim /run/opendkim
fi
chmod -R go-rwx /run/opendkim/keys 2>/dev/null || true

if [[ -f /var/lib/lms/sasldb2 ]]; then
  if getent group cyrus >/dev/null 2>&1; then
    chown root:cyrus /var/lib/lms/sasldb2 || true
  elif getent group sasl >/dev/null 2>&1; then
    chown root:sasl /var/lib/lms/sasldb2 || true
  fi
  chmod 0640 /var/lib/lms/sasldb2 || true
fi

if id -u postfix >/dev/null 2>&1; then
  if getent group cyrus >/dev/null 2>&1; then
    addgroup postfix cyrus >/dev/null 2>&1 || true
  elif getent group sasl >/dev/null 2>&1; then
    addgroup postfix sasl >/dev/null 2>&1 || true
  fi
fi

for resolver_file in resolv.conf hosts host.conf nsswitch.conf services protocols; do
  if [[ -e "/etc/${resolver_file}" ]]; then
    cp -L "/etc/${resolver_file}" "/var/spool/postfix/etc/${resolver_file}"
    chmod 0644 "/var/spool/postfix/etc/${resolver_file}"
  fi
done

if [[ ! -f /etc/postfix/aliases ]]; then
  printf 'root: root\n' > /etc/postfix/aliases
fi
newaliases >/dev/null 2>&1 || true

if [[ ! -f /etc/postfix/master.cf ]]; then
  if [[ -f /etc/postfix/master.cf.proto ]]; then
    cp /etc/postfix/master.cf.proto /etc/postfix/master.cf
  else
    touch /etc/postfix/master.cf
  fi
fi

if [[ -f "${CONFIG_ROOT}/master-lms.cf" ]]; then
  if grep -q "Managed by Linux Made Sane" /etc/postfix/master.cf; then
    sed -i '/# Managed by Linux Made Sane/,$d' /etc/postfix/master.cf
  fi
  sed -i '/^smtp[[:space:]]\+inet[[:space:]]/s/^/#/' /etc/postfix/master.cf || true
  sed -i '/^submission[[:space:]]\+inet[[:space:]]/s/^/#/' /etc/postfix/master.cf || true
  cat "${CONFIG_ROOT}/master-lms.cf" >> /etc/postfix/master.cf
fi

MAIL_LOG="${CONFIG_ROOT%/config}/mail.log"
mkdir -p /var/log "$(dirname "${MAIL_LOG}")"
touch "${MAIL_LOG}" /var/log/messages
ln -sfn "${MAIL_LOG}" /var/log/mail.log
if id -u postfix >/dev/null 2>&1; then
  chown postfix:postfix "${MAIL_LOG}" 2>/dev/null || true
fi
chmod 0644 "${MAIL_LOG}" || true

ensure_main_cf_param() {
  local file="$1"
  local key="$2"
  local value="$3"
  [[ -f "${file}" ]] || return 0
  if grep -q "^${key}[[:space:]]*=" "${file}"; then
    sed -i "s|^${key}[[:space:]]*=.*|${key} = ${value}|" "${file}"
  else
    printf '\n%s = %s\n' "${key}" "${value}" >> "${file}"
  fi
}

ensure_main_cf_param "${CONFIG_ROOT}/main.cf" maillog_file_prefixes "/var, /dev/stdout, /data"
ensure_main_cf_param /etc/postfix/main.cf maillog_file_prefixes "/var, /dev/stdout, /data"
ensure_main_cf_param "${CONFIG_ROOT}/main.cf" maillog_file "${MAIL_LOG}"
ensure_main_cf_param /etc/postfix/main.cf maillog_file "${MAIL_LOG}"
ensure_main_cf_param "${CONFIG_ROOT}/main.cf" smtp_connect_timeout "15"
ensure_main_cf_param /etc/postfix/main.cf smtp_connect_timeout "15"
ensure_main_cf_param "${CONFIG_ROOT}/main.cf" smtp_helo_timeout "15"
ensure_main_cf_param /etc/postfix/main.cf smtp_helo_timeout "15"

# Keep the outbound SMTP client out of the Postfix chroot so MX lookups work in the add-on.
if grep -qE '^[#]*smtp[[:space:]]+unix[[:space:]]' /etc/postfix/master.cf; then
  sed -i -E 's/^[#]*smtp[[:space:]]+unix[[:space:]].*/smtp      unix  -       -       n       -       -       smtp/' /etc/postfix/master.cf
else
  printf 'smtp      unix  -       -       n       -       -       smtp\n' >> /etc/postfix/master.cf
fi

if command -v rsyslogd >/dev/null 2>&1 && ! pgrep -x rsyslogd >/dev/null 2>&1; then
  if [[ ! -f /etc/rsyslog.conf ]] || ! grep -q 'mail.log' /etc/rsyslog.conf; then
    printf 'mail.*                         -/var/log/mail.log\n' >> /etc/rsyslog.conf
  fi
  rsyslogd || true
fi

if command -v opendkim >/dev/null 2>&1 && [[ -f /etc/opendkim.conf ]]; then
  if [[ ! -f /run/opendkim/opendkim.pid ]] || ! kill -0 "$(cat /run/opendkim/opendkim.pid 2>/dev/null)" 2>/dev/null; then
    opendkim -x /etc/opendkim.conf || opendkim || true
  else
    kill -HUP "$(cat /run/opendkim/opendkim.pid)" >/dev/null 2>&1 || true
  fi
fi

postfix check
if postfix status >/dev/null 2>&1; then
  postfix reload
else
  postfix start
fi

bashio::log.info "Mail Relay configuration applied."
