#!/usr/bin/with-contenv bashio

set -euo pipefail

mkdir -p /data/lms-edge-gateway /data/caddy /data/cloudflared /data/logs

if [[ ! -f /data/caddy/Caddyfile ]]; then
  cat > /data/caddy/Caddyfile <<'CADDY'
{
    servers {
        protocols h1
    }
}

:8080 {
    respond /health "ok" 200
}
CADDY
fi

caddy fmt --overwrite /data/caddy/Caddyfile >/dev/null 2>&1 || true

bashio::log.info "LMS Edge Gateway add-on data prepared."
