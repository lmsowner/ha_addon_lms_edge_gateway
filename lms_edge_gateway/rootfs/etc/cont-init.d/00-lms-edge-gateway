#!/usr/bin/with-contenv bashio

set -euo pipefail

mkdir -p /data/lms-edge-gateway /data/lms-edge-gateway/mail-relay /data/caddy /data/cloudflared /data/logs /var/lib/lms /run/opendkim

if [[ ! -f /data/caddy/Caddyfile ]]; then
  cat > /data/caddy/Caddyfile <<'CADDY'
{
    servers {
        protocols h1
    }
}

http://:18080 {
    bind 127.0.0.1
    respond /health "ok" 200
}
CADDY
fi

sed -i \
  -e 's#^:18080 {$#http://:18080 {#' \
  -e 's#^127\.0\.0\.1:18080 {$#http://:18080 {#' \
  -e 's#^http://127\.0\.0\.1:18080 {$#http://:18080 {#' \
  /data/caddy/Caddyfile

if ! grep -q '^[[:space:]]*bind 127\.0\.0\.1$' /data/caddy/Caddyfile; then
  sed -i '/^http:\/\/:18080 {$/a\    bind 127.0.0.1' /data/caddy/Caddyfile
fi

caddy fmt --overwrite /data/caddy/Caddyfile >/dev/null 2>&1 || true

bashio::log.info "Linux Made Sane - Edge Gateway add-on data prepared."
